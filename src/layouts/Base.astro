---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

const OG_DEFAULT = '/assets/og-default.jpg';

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  /** Alt text for the share image, for crawlers that surface it. */
  ogImageAlt?: string;
  footerTitle?: string;
  footerIntro?: string;
  footerLinks?: { label: string; href: string }[];
  /** Which colour scheme this page opens in for a first-time visitor. */
  theme?: 'dark' | 'light';
  /** false when the page has no dark hero photo behind the header. */
  navOverDark?: boolean;
  /** Keep this page out of search results and out of the canonical set. */
  noindex?: boolean;
}

const {
  title,
  description,
  ogTitle = title,
  ogDescription = description,
  ogImage = OG_DEFAULT,
  ogImageAlt = `${site.name} — dancers, models, SPACTs and stand-ins for film and television`,
  footerTitle,
  footerIntro,
  footerLinks,
  theme = 'dark',
  navOverDark = true,
  noindex = false,
} = Astro.props;

const base = Astro.site ?? Astro.url;
/* build.format:'file' makes Astro.url.pathname '/models.html'; the public URL
   (and the sitemap) is '/models', so normalise before building canonicals. */
const cleanPath = Astro.url.pathname.replace(/index\.html$/, '').replace(/\.html$/, '');
const pageUrl = new URL(cleanPath, base).toString().replace(/\/$/, '/');
/* SVG share images are ignored by most crawlers — fall back to the JPEG. */
const shareImage = ogImage.endsWith('.svg') ? OG_DEFAULT : ogImage;
const ogImageUrl = new URL(shareImage, base).toString();
---

<!doctype html>
<html lang="en" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={theme === "light" ? "#f4f2ee" : "#161618"} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={pageUrl} />}
    <link rel="icon" href="/assets/take3-logo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600&family=Anton&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      /* theme before first paint — avoids a flash of the wrong theme */
      (function () {
        try {
          var t = localStorage.getItem('t3-theme');
          if (t === 'dark' || t === 'light') document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="page">
      <Header overDark={navOverDark} />
      <main id="main">
        <slot />
      </main>
      <Footer title={footerTitle} intro={footerIntro} links={footerLinks} />
    </div>
    <script src="../scripts/site.js"></script>
    <slot name="scripts" />
  </body>
</html>
