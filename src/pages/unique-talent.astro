---
/* /unique-talent — a standalone page, on purpose. See the note at the top of
 * stunt-performers.astro: the specialist division pages deliberately do not
 * share a template, so each can be developed by a different person without
 * their changes landing on the others. Scoped with a `uni` prefix.
 *
 * Design direction for this one: a celebration, not a catalogue. This page
 * is about people, so the frame is representation first, the roster is set
 * as a quiet read rather than a list of features, the work they have done is
 * shown through the productions rather than through pictures of bodies, and
 * accessibility is given a plain, structured band with no imagery at all.
 * The one place the page is deliberately blunt is the brief list, so that
 * someone searching for an amputee double or a wheelchair user finds us. */
import Base from '../layouts/Base.astro';
import { posters } from '../lib/posters';
import copy from '../content/pages/unique-talent.json';

const posterBySlug = new Map(posters.map((p) => [p.slug, p]));

type Production = { title: string; poster?: string };
const artworkFor = (p: Production) => (p.poster ? posterBySlug.get(p.poster) : undefined);

/* The row runs the credits three times so it can loop endlessly in both
   directions; only the middle copy is ever in view for long. */
const actionCards = [...copy.inAction.items, ...copy.inAction.items, ...copy.inAction.items];
const actionCount = copy.inAction.items.length;
---

<Base
  title={copy.meta.title}
  description={copy.meta.description}
  ogTitle={copy.meta.ogTitle}
  ogDescription={copy.meta.ogDescription}
  ogImage={copy.meta.ogImage}
  ogImageAlt={copy.meta.ogImageAlt}
  footerTitle={copy.meta.footerTitle}
>
  <!-- hero: copy left, portrait right -->
  <section class="pageHero uniHero" aria-labelledby="uniTitle">
    <div class="pageHeroInner uniHeroInner">
      <div class="uniHeroCopy">
        <p class="kicker" data-hero-line>{copy.hero.eyebrow}</p>
        <h1 class="pageHeroTitle uniHeroTitle" id="uniTitle" data-hero-line>{copy.hero.heading}</h1>
        <p class="pageHeroLede" data-hero-line>{copy.hero.lede}</p>
        <ul class="uniTagRow" data-hero-line>
          {copy.hero.tags.map((tag) => <li>{tag}</li>)}
        </ul>
      </div>
      <figure class="uniHeroFig">
        <span class="figPlate" data-hero-figure><img class="uniHeroPhoto" src={copy.hero.figure.image} alt={copy.hero.figure.alt} width="1200" height="1800" fetchpriority="high" decoding="async" /></span>
        <figcaption class="uniCap" data-hero-line>
          <span>{copy.hero.figure.figNumber}</span><span>{copy.hero.figure.figNote}</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- representation: the frame for everything that follows -->
  <section class="band uniRepBand" aria-labelledby="uniRep">
    <div class="bandInner uniRepInner" data-reveal-group="0.12">
      <div class="uniRepCopy">
        <p class="kicker" data-reveal-item>{copy.representation.kicker}</p>
        <h2 class="sectionTitle uniRepTitle" id="uniRep" data-reveal-item>{copy.representation.heading}</h2>
        <div class="bandBody uniRepBody">
          {copy.representation.paragraphs.map((para) => <p data-reveal-item>{para}</p>)}
        </div>
      </div>
      <figure class="uniRepFig">
        <span class="figPlate" data-reveal-figure><img class="uniRepPhoto" src={copy.representation.figure.image} alt={copy.representation.figure.alt} width="1200" height="1800" loading="lazy" decoding="async" /></span>
        <figcaption class="uniCap" data-reveal-item>
          <span>{copy.representation.figure.figNumber}</span><span>{copy.representation.figure.figNote}</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- the roster: one statement, then four short entries set as a grid
       rather than another ruled list, so it reads as a celebration and not
       as the index that follows it -->
  <section class="band uniRosterBand" aria-labelledby="uniRoster">
    <div class="bandInner">
      <p class="kicker" data-reveal>{copy.roster.kicker}</p>
      <h2 class="displayTitle uniRosterTitle" id="uniRoster" data-reveal>{copy.roster.heading}</h2>
      <ul class="uniRoster" data-reveal-group>
        {
          copy.roster.items.map((item) => (
            <li class="uniRosterItem" data-reveal-item>
              <p class="uniRosterNum">{item.number}</p>
              <h3 class="uniRosterName">{item.title}</h3>
              <p class="uniRosterBody">{item.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- in action: one draggable row of cards, looping, three productions
       each. The page padding belongs to the scroller so the header stays on
       the column (see DESIGN.md, horizontal scrollers). -->
  <section class="band uniActionBand" aria-labelledby="uniAction">
    <div class="bandInner">
      <div class="sectionHead uniHead" data-reveal-head>
        <h2 class="sectionTitle" id="uniAction">{copy.inAction.heading}</h2>
        <p class="kicker">{copy.inAction.kicker}</p>
      </div>
    </div>
    <ul class="uniActionScroll" id="uniActionScroll" aria-label={copy.inAction.heading} data-reveal-group="0.06">
      {
        actionCards.map((item, i) => (
          <li class="uniActionCard" aria-hidden={i >= actionCount ? 'true' : undefined} data-reveal-item>
            <ul class="uniActionPosters" aria-label={`Productions: ${item.term.toLowerCase()}`}>
              {(item.productions as Production[]).map((prod) => {
                const art = artworkFor(prod);
                return (
                  <li class="uniPoster">
                    {art ? (
                      <img class="uniPosterImg" src={art.src} alt="" loading="lazy" decoding="async" draggable="false" />
                    ) : (
                      <span class="slot uniPosterSlot" aria-hidden="true">
                        <span class="slotLabel">Poster</span>
                      </span>
                    )}
                    <span class="uniPosterName">{prod.title}</span>
                  </li>
                );
              })}
            </ul>
            <h3 class="uniActionTerm">{item.term}</h3>
            <p class="uniActionBody">{item.body}</p>
          </li>
        ))
      }
    </ul>
    <div class="bandInner"><p class="uniActionHint" data-reveal>{copy.inAction.hint}</p></div>
  </section>

  <!-- accessibility: serious, structured, no imagery -->
  <section class="band bandDark uniDark" aria-labelledby="uniAccess">
    <div class="bandInner uniAccessInner" data-reveal-group="0.1">
      <div>
        <p class="kicker" data-reveal-item>{copy.accessibility.kicker}</p>
        <h2 class="uniAccessTitle" id="uniAccess" data-reveal-item>{copy.accessibility.heading}</h2>
        <div class="bandBody uniAccessBody">
          {copy.accessibility.paragraphs.map((para) => <p data-reveal-item>{para}</p>)}
        </div>
      </div>
      <div class="uniSupport">
        <h3 class="uniSupportTitle" data-reveal-item>{copy.accessibility.support.heading}</h3>
        <p class="uniSupportBody" data-reveal-item>{copy.accessibility.support.body}</p>
        <p class="uniSupportLead" data-reveal-item>{copy.accessibility.support.lead}</p>
        <ol class="uniSupportList">
          {copy.accessibility.support.points.map((point) => <li data-reveal-item>{point}</li>)}
        </ol>
      </div>
    </div>
  </section>

  <style is:global>
    .uniHero, .uniDark { --accent:#d4704f; --muted:#96928c; }
    .uniDark { --sub:#c7c3bd; --ink:#f4f2ee; --hair:#3a3a3e; }

    .uniHead { padding-bottom:18px; }
    .uniCap { display:flex; justify-content:space-between; gap:20px; margin-top:12px; font-size:11px; letter-spacing:2.5px; text-transform:uppercase; color:var(--muted); }

    /* hero: copy beside a tall portrait, as on the circus page */
    .uniHero { padding-top:200px; padding-bottom:86px; }
    .uniHeroInner { display:grid; grid-template-columns:minmax(0, 1fr) minmax(0, 460px); gap:64px; align-items:center; }
    .uniHeroTitle { max-width:12ch; }
    .uniHeroFig { margin:0; min-width:0; }
    .uniHeroPhoto { display:block; width:100%; height:auto; }
    .uniTagRow { list-style:none; margin:30px 0 0; padding:0; display:flex; flex-wrap:wrap; gap:10px 26px; }
    .uniTagRow li { font-size:11px; letter-spacing:2.5px; text-transform:uppercase; color:var(--muted); }

    /* representation */
    .uniRepInner { display:grid; grid-template-columns:minmax(0, 1fr) minmax(0, 1.4fr); gap:72px; align-items:start; }
    .uniRepFig { order:-1; }
    .uniRepTitle { margin-top:14px; max-width:16ch; }
    .uniRepBody { margin-top:26px; max-width:62ch; }
    .uniRepFig { margin:0; min-width:0; }
    .uniRepPhoto { display:block; width:100%; height:auto; background:var(--tileBg); }

    /* roster: a statement and a grid, no hairlines */
    .uniRosterBand { padding-top:0; }
    .uniRosterTitle { max-width:22ch; }
    .uniRoster { list-style:none; margin:56px 0 0; padding:0; display:grid; grid-template-columns:repeat(4, minmax(0, 1fr)); gap:40px 48px; }
    .uniRosterItem { margin:0; }
    .uniRosterNum { margin:0; font-size:clamp(28px, 2.6vw, 42px); font-weight:300; letter-spacing:1px; line-height:1; color:var(--accent); font-variant-numeric:tabular-nums; }
    .uniRosterName { margin:18px 0 0; font-family:'Anton', 'Jost', sans-serif; text-transform:uppercase; font-size:clamp(19px, 1.9vw, 25px); font-weight:400; letter-spacing:0; line-height:1.15; color:var(--ink); }
    .uniRosterBody { margin:12px 0 0; font-size:16px; font-weight:400; line-height:1.7; color:var(--sub); text-wrap:pretty; }

    /* in action: a looping, draggable row of cards */
    .uniActionScroll {
      list-style:none; margin:40px 0 0; padding:0 40px; display:flex; gap:32px; overflow-x:auto; scrollbar-width:none; cursor:grab;
      /* the fade lives in the page padding, so the first card on the column is never dimmed */
      --uniFade: 40px;
      -webkit-mask-image: linear-gradient(to right, transparent 0, #000 var(--uniFade), #000 calc(100% - var(--uniFade)), transparent 100%);
      mask-image: linear-gradient(to right, transparent 0, #000 var(--uniFade), #000 calc(100% - var(--uniFade)), transparent 100%);
    }
    .uniActionScroll:active { cursor:grabbing; }
    .uniActionScroll::-webkit-scrollbar { display:none; }
    .uniActionCard { flex:0 0 clamp(300px, 30vw, 420px); margin:0; }
    .uniActionPosters { list-style:none; margin:0; padding:0; display:grid; grid-template-columns:repeat(3, minmax(0, 1fr)); gap:12px; }
    .uniPoster { display:flex; flex-direction:column; }
    .uniPosterImg, .uniPosterSlot { display:block; width:100%; aspect-ratio:2/3; object-fit:cover; background:var(--tileBg); filter:saturate(0.92) contrast(1.05) brightness(0.96); user-select:none; -webkit-user-drag:none; }
    .uniPosterSlot { display:flex; filter:none; }
    .uniPosterName { margin-top:8px; min-height:2.8em; font-size:10px; letter-spacing:1.5px; text-transform:uppercase; line-height:1.4; color:var(--muted); }
    .uniActionTerm { margin:22px 0 0; font-family:'Anton', 'Jost', sans-serif; text-transform:uppercase; font-size:clamp(19px, 1.9vw, 25px); font-weight:400; letter-spacing:0; color:var(--ink); }
    .uniActionBody { margin:10px 0 0; font-size:15px; line-height:1.65; color:var(--sub); text-wrap:pretty; }
    .uniActionHint { margin:28px 0 0; font-size:11px; letter-spacing:2.5px; text-transform:uppercase; color:var(--muted); }

    /* accessibility: two plain columns, nothing decorative */
    .uniAccessInner { display:grid; grid-template-columns:1fr 1fr; gap:72px; align-items:start; }
    .uniAccessTitle { font-family:'Anton', 'Jost', sans-serif; text-transform:uppercase; font-size:clamp(30px, 4vw, 56px); font-weight:400; letter-spacing:0; line-height:1.06; margin-top:16px; max-width:14ch; }
    .uniAccessBody { margin-top:26px; max-width:56ch; }
    .uniSupport { border-top:1px solid var(--hair); padding-top:26px; }
    .uniSupportTitle { margin:0; font-family:'Anton', 'Jost', sans-serif; text-transform:uppercase; font-size:clamp(22px, 2.2vw, 30px); font-weight:400; letter-spacing:0; line-height:1.15; color:var(--ink); max-width:18ch; }
    .uniSupportBody { margin:18px 0 0; font-size:17px; line-height:1.7; color:var(--sub); max-width:46ch; text-wrap:pretty; }
    .uniSupportLead { margin:32px 0 0; font-size:11px; letter-spacing:2.5px; text-transform:uppercase; color:var(--accent); }
    .uniSupportList { list-style:none; margin:10px 0 0; padding:0; counter-reset:uniSupport; }
    .uniSupportList li { counter-increment:uniSupport; display:grid; grid-template-columns:36px 1fr; gap:0 12px; align-items:baseline; border-top:1px solid var(--hair); padding:16px 0; font-size:16px; line-height:1.6; color:var(--ink); }
    .uniSupportList li::before { content:counter(uniSupport, decimal-leading-zero); font-size:11px; letter-spacing:2px; color:var(--muted); }
    .uniSupportList li:last-child { border-bottom:1px solid var(--hair); }

    @media (max-width:1024px) {
      .uniHeroInner, .uniRepInner, .uniAccessInner { grid-template-columns:1fr; gap:44px; }
      .uniHeroFig { width:100%; max-width:460px; }
      .uniRepFig { order:0; }
      .uniRepFig { max-width:460px; }
      .uniActionScroll { padding:0 32px; --uniFade:32px; }
      .uniRoster { grid-template-columns:repeat(2, minmax(0, 1fr)); gap:36px 36px; }
    }

    @media (max-width:640px) {
      .uniHero { padding-top:170px; padding-bottom:60px; }
      .uniHeroFig, .uniRepFig { max-width:none; }
      .uniActionScroll { padding:0 20px; gap:24px; --uniFade:20px; }
      .uniActionCard { flex-basis:min(300px, 82vw); }
      .uniRoster { grid-template-columns:1fr; gap:32px; }
    }
  </style>
  <script slot="scripts" is:inline>
    (function () {
      'use strict';
      var el = document.getElementById('uniActionScroll');
      if (!el) return;
      /* three identical copies of the credits: the view is kept on the middle
         one, and crossing into a neighbour slides it back by one whole copy,
         so the row reads as an endless loop in either direction. */
      var cards = Array.prototype.slice.call(el.querySelectorAll('.uniActionCard'));
      var perSet = Math.round(cards.length / 3);
      var cycle = 0, loopable = false;
      function measure() {
        cycle = cards.length > perSet ? cards[perSet].offsetLeft - cards[0].offsetLeft : 0;
        loopable = cycle > 0 && el.scrollWidth - el.clientWidth >= cycle * 2;
      }
      function normalise() {
        if (!loopable) return;
        while (el.scrollLeft >= cycle * 2) el.scrollLeft -= cycle;
        while (el.scrollLeft < cycle) el.scrollLeft += cycle;
      }
      function reset() { measure(); if (loopable) el.scrollLeft = cycle; }
      reset();
      window.addEventListener('load', reset);
      var rz = null;
      window.addEventListener('resize', function () { window.clearTimeout(rz); rz = window.setTimeout(reset, 150); });
      el.addEventListener('scroll', normalise, { passive: true });

      var dragging = false, moved = false, lastX = 0;
      el.addEventListener('pointerdown', function (e) {
        if (e.pointerType === 'touch') return; /* native swipe scrolls the row */
        dragging = true; moved = false; lastX = e.clientX;
      });
      window.addEventListener('pointermove', function (e) {
        if (!dragging) return;
        var dx = e.clientX - lastX;
        if (!moved && Math.abs(dx) <= 6) return;
        moved = true; lastX = e.clientX;
        el.scrollLeft -= dx;
        normalise();
      }, { passive: true });
      window.addEventListener('pointerup', function () { dragging = false; });
      window.addEventListener('pointercancel', function () { dragging = false; });
      el.addEventListener('click', function (e) {
        if (moved) { e.stopPropagation(); e.preventDefault(); moved = false; }
      }, true);
    })();
  </script>
  <script>
    import { armReveal } from '../lib/reveal';
    /* the shared pass (see reveal.ts): cover lines rise and the portrait is
       unveiled on load; everything below arrives as it is scrolled to */
    armReveal();
  </script>
</Base>
