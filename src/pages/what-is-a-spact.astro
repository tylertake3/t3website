---
import Base from '../layouts/Base.astro';
import copy from '../content/pages/what-is-a-spact.json';

/* structured data must carry absolute URLs — Google ignores relative ones.
   Astro.site is the configured production origin; Astro.url is the dev fallback. */
const abs = (path: string) => new URL(path, Astro.site ?? Astro.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: copy.meta.articleHeadline,
  description: copy.meta.description,
  image: abs(copy.hero.image),
  articleSection: copy.meta.articleSection,
  inLanguage: 'en-GB',
  author: { '@type': 'Organization', name: 'Take 3 Agency' },
  publisher: {
    '@type': 'Organization',
    name: 'Take 3 Agency',
    /* Google's Article guidelines require a raster publisher logo, not an SVG */
    logo: { '@type': 'ImageObject', url: abs('/assets/og-default.jpg') },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': abs('/what-is-a-spact') },
};
---

<Base
  navOverDark={false}
  title={copy.meta.title}
  description={copy.meta.description}
  ogTitle={copy.meta.ogTitle}
  ogDescription={copy.meta.ogDescription}
  ogImage={copy.hero.image}
  footerTitle={copy.meta.footerTitle}
  footerIntro={copy.meta.footerIntro}
  footerLinks={copy.meta.footerLinks}
>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd, null, 2)} />

  <article>

  <!-- title -->
  <div class="wrap pad titleWrap" style="padding-top:186px; padding-bottom:72px; min-height:var(--coverH); display:flex; flex-direction:column; justify-content:flex-end;">
    <div class="titleSplit">
      <div style="flex:1 1 420px; min-width:280px;">
        <p class="eyebrow" style="letter-spacing:4px; font-size:13px;">{copy.hero.eyebrow}</p>
        {/* the line break comes from the \n in the copy + white-space:pre-line (the
            .heroTitle pattern in global.css), so textContent keeps the words apart —
            a <br /> alone renders "What isa SPACT?" to scrapers and share previews */}
        <h1 class="h1Display" style="font-family:'Anton','Jost',sans-serif; text-transform:uppercase; font-size:clamp(52px,7vw,120px); font-weight:400; letter-spacing:0; line-height:1.02; margin:20px 0 0; white-space:pre-line;">{copy.hero.heading}</h1>
        <p class="standfirst" style="font-size:clamp(18px,1.4vw,21px); font-weight:400; line-height:1.65; color:var(--sub); margin:36px 0 0; max-width:520px;">{copy.hero.standfirst}</p>
      </div>
      <!-- casting overlay -->
      <figure style="flex:1 1 460px; min-width:0; max-width:640px; margin:0;">
        <div style="position:relative; aspect-ratio:3/2; overflow:hidden; background:var(--tileBg);">
          <img src={copy.hero.image} alt={copy.hero.imageAlt} style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; display:block;" />
          <div class="tann" style="left:13.5%; top:13%; width:8%; height:17%; animation-delay:0.6s;">
            <div class="tannBox"></div>
            <div class="tannTick" style="bottom:100%;"></div>
            <div class="tannLabel" style="bottom:calc(100% + 9px);"><span style="color:var(--accent);">●</span>&nbsp; {copy.hero.annotations[0].label}</div>
          </div>
          <div class="tann" style="left:25.5%; top:18%; width:6.5%; height:12%; animation-delay:4.8s;">
            <div class="tannBox"></div>
            <div class="tannTick" style="top:100%;"></div>
            <div class="tannLabel" style="top:calc(100% + 9px); transform:translateX(calc(-50% - 20px));"><span style="color:var(--accent);">●</span>&nbsp; {copy.hero.annotations[1].label}</div>
          </div>
          <div class="tann" style="left:34.5%; top:21%; width:9%; height:15%; animation-delay:2s;">
            <div class="tannBox"></div>
            <div class="tannTick" style="bottom:100%;"></div>
            <div class="tannLabel" style="bottom:calc(100% + 9px);"><span style="color:var(--accent);">●</span>&nbsp; {copy.hero.annotations[2].label}</div>
          </div>
          <div class="tann" style="left:50.5%; top:18.5%; width:6.5%; height:12%; animation-delay:6.2s;">
            <div class="tannBox"></div>
            <div class="tannTick" style="top:100%;"></div>
            <div class="tannLabel" style="top:calc(100% + 9px);"><span style="color:var(--accent);">●</span>&nbsp; {copy.hero.annotations[3].label}</div>
          </div>
          <div class="tann" style="left:62%; top:12.5%; width:9%; height:17%; animation-delay:3.4s;">
            <div class="tannBox"></div>
            <div class="tannTick" style="bottom:100%;"></div>
            <div class="tannLabel" style="bottom:calc(100% + 9px);"><span style="color:var(--accent);">●</span>&nbsp; {copy.hero.annotations[4].label}</div>
          </div>
          <div class="tann" style="left:78.5%; top:20%; width:7.5%; height:13%; animation-delay:7.6s;">
            <div class="tannBox"></div>
            <div class="tannTick" style="bottom:100%;"></div>
            <div class="tannLabel" style="bottom:calc(100% + 9px);"><span style="color:var(--accent);">●</span>&nbsp; {copy.hero.annotations[5].label}</div>
          </div>
        </div>
        <figcaption style="display:flex; justify-content:space-between; align-items:baseline; gap:16px; margin-top:12px; flex-wrap:wrap;">
          <span style="font-size:10px; letter-spacing:3px; color:var(--muted);">{copy.hero.captionLeft}</span>
          <span style="font-size:10px; letter-spacing:3px; color:var(--accent);">{copy.hero.captionRight}</span>
        </figcaption>
      </figure>
    </div>
  </div>

  <!-- 01 origin -->
  <section class="rule" aria-labelledby="ch01">
    <div class="wrap pad split secPad" style="padding-top:80px; padding-bottom:80px;">
      <div>
        <p class="eyebrow" id="ch01">{copy.origin.eyebrow}</p>
        <h2 class="dispM">{copy.origin.heading}</h2>
      </div>
      <div class="body17">
        <p style="margin:0;">{copy.origin.paragraph1.before}<strong>{copy.origin.paragraph1.bold}</strong>{copy.origin.paragraph1.after}</p>
        <p style="margin:18px 0 0;">{copy.origin.paragraph2}</p>
      </div>
    </div>
  </section>

  <!-- pointer to the interactive comparison, which lives on /spacts -->
  <section class="rule" aria-labelledby="seeFrame">
    <div class="wrap pad split secPad" style="padding-top:60px; padding-bottom:60px;">
      <div>
        <p class="eyebrow" id="seeFrame">{copy.seeFrame.eyebrow}</p>
        <h2 class="dispM">{copy.seeFrame.heading}</h2>
      </div>
      <div class="body17">
        <p style="margin:0;">{copy.seeFrame.body}</p>
        <a class="frameLink" href={copy.seeFrame.linkHref}>{copy.seeFrame.linkLabel}</a>
      </div>
    </div>
  </section>

  <!-- 02 what they do -->
  <section class="rule" aria-labelledby="ch02">
    <div class="wrap pad split secPad" style="padding-top:80px; padding-bottom:80px;">
      <div>
        <p class="eyebrow" id="ch02">{copy.work.eyebrow}</p>
        <h2 class="dispM">{copy.work.heading}</h2>
      </div>
      <div>
        <div class="body17">
          <p style="margin:0;">{copy.work.intro}</p>
        </div>
        <div style="margin-top:28px;">
          {copy.work.rows.map((row) => (
            <div class="workRow"><div class="workKey">{row.term}</div><div class="workVal">{row.description}</div></div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 03 in practice -->
  <section class="rule" aria-labelledby="ch03">
    <div class="wrap pad secPad" style="padding-top:80px; padding-bottom:80px;">
      <p class="eyebrow" id="ch03">{copy.practice.eyebrow}</p>
      <h2 class="dispM">{copy.practice.heading}</h2>
      <div class="body17" style="margin-top:16px; max-width:720px;">
        <p style="margin:0;">{copy.practice.intro}</p>
      </div>

      <div class="caseGrid">
        {copy.practice.cases.map((item) => (
          <div class="caseCard">
            <p class="caseKicker">{item.kicker}</p>
            <p class="caseTitle">{item.title}</p>
            <p class="caseBody">{item.body}</p>
          </div>
        ))}
      </div>

      <div class="creditStrip">
        <p class="caseKicker" style="margin:0;">{copy.practice.creditsLabel}</p>
        <ul class="creditList">
          {copy.practice.credits.map((title) => (<li>{title}</li>))}
        </ul>
        <p class="creditNote">{copy.practice.creditsNote}</p>
        <a class="creditLink" href={copy.practice.linkHref}>{copy.practice.linkLabel}</a>
      </div>
    </div>
  </section>

  <!-- 04 booking -->
  <section class="rule" aria-labelledby="ch04">
    <div class="wrap pad split secPad" style="padding-top:80px; padding-bottom:88px;">
      <div>
        <p class="eyebrow" id="ch04">{copy.booking.eyebrow}</p>
        <h2 class="dispM">{copy.booking.heading}</h2>
      </div>
      <div class="body17">
        {copy.booking.paragraphs.map((para, i) => (
          <p style={i === 0 ? 'margin:0;' : 'margin:18px 0 0;'}>{para}</p>
        ))}
      </div>
    </div>
  </section>

  </article>

  <style is:global>
*,*::before,*::after { box-sizing:border-box; }
img { max-width:100%; }
p { text-wrap:pretty; }

@keyframes annIn { 0% { opacity:0; transform:translateY(5px); } 4% { opacity:1; transform:translateY(0); } 88% { opacity:1; } 96%, 100% { opacity:0; } }

/* ---------- layout helpers ---------- */
.wrap { max-width:1280px; margin:0 auto; }
.pad { padding-left:60px; padding-right:60px; }
.split { display:grid; grid-template-columns:1fr 1.6fr; gap:72px; align-items:start; }
.titleSplit { display:flex; justify-content:space-between; align-items:flex-start; gap:56px; flex-wrap:wrap; }
.rule { border-top:1px solid var(--hair); }

/* The .tannLabel callout chips over the hero still are hard-coded dark in
   BOTH themes (rgba(22,22,24,0.92)). The light-theme --accent (#5d1f16
   oxblood) is picked for a cream page and measures ~1.4:1 there —
   unreadable. So the chip re-scopes the token to its dark-theme value, which
   clears 4.5:1 on that surface. Everything inside still references
   var(--accent); this is the same "pin the value to the surface, not the
   theme" rule global.css applies to the always-dark reviews band. */
.tannLabel { --accent:#d4704f; --muted:#96928c; }

.eyebrow { font-size:12px; letter-spacing:3px; color:var(--accent); font-weight:400; margin:0; }
.dispM { font-family:'Anton','Jost',sans-serif; text-transform:uppercase; font-size:clamp(24px,2.4vw,36px); font-weight:400; letter-spacing:0; line-height:1.2; margin:14px 0 0; }
.body17 { font-size:17px; font-weight:400; line-height:1.8; color:var(--sub); }
.body17 strong { font-weight:500; color:var(--ink); }

/* ---------- title storyboard annotations (static cycle) ---------- */
.tann { position:absolute; opacity:0; animation:annIn 14s linear infinite; }
.tannBox { position:absolute; inset:0; border:1px solid rgba(244,242,238,0.85); box-shadow:0 0 0 1px rgba(20,20,22,0.35); }
.tannTick { position:absolute; left:50%; width:1px; height:9px; background:rgba(244,242,238,0.85); }
.tannLabel { position:absolute; left:50%; transform:translateX(-50%); background:rgba(22,22,24,0.92); border:1px solid #3a3a3e; padding:4px 9px; font-size:9px; letter-spacing:2.5px; color:#f4f2ee; white-space:nowrap; }

/* ---------- in practice ---------- */
.caseGrid { display:grid; grid-template-columns:repeat(2,1fr); gap:40px 56px; margin-top:44px; }
.caseCard { border-top:1px solid var(--hair); padding-top:20px; }
.caseKicker { font-size:10px; letter-spacing:3px; color:var(--accent); margin:0; }
.caseTitle { font-size:15px; letter-spacing:0.2px; font-weight:500; color:var(--ink); margin:12px 0 0; }
.caseBody { font-size:15px; font-weight:400; line-height:1.7; color:var(--sub); margin:10px 0 0; }
.creditStrip { border-top:1px solid var(--hair); margin-top:52px; padding-top:22px; }
.creditList { list-style:none; display:flex; flex-wrap:wrap; gap:14px 32px; margin:16px 0 0; padding:0; }
.creditList li { font-family:'Anton','Jost',sans-serif; text-transform:uppercase; font-size:clamp(18px,1.8vw,26px); font-weight:400; line-height:1.1; color:var(--ink); }
.creditNote { font-size:13px; font-weight:400; line-height:1.7; color:var(--muted); margin:18px 0 0; max-width:620px; }
.creditLink { display:inline-block; margin-top:16px; font-size:11px; letter-spacing:2.5px; color:var(--accent); text-decoration:none; border-bottom:1px solid currentColor; padding-bottom:3px; }
.creditLink:hover { color:var(--ink); }

/* ---------- pointer to the frame on /spacts ---------- */
.frameLink { display:inline-block; margin-top:22px; font-size:11px; letter-spacing:2.5px; color:var(--accent); text-decoration:none; border-bottom:1px solid currentColor; padding-bottom:3px; }
.frameLink:hover { color:var(--ink); }

/* ---------- work table ---------- */
.workRow { border-top:1px solid var(--hair); padding:18px 0; display:grid; grid-template-columns:220px 1fr; gap:24px; }
.workRow:last-child { border-bottom:1px solid var(--hair); }
.workKey { font-size:13px; letter-spacing:2px; color:var(--ink); }
.workVal { font-size:15px; font-weight:400; color:var(--sub); line-height:1.7; }

/* ---------- responsive: desktop rendering untouched above 1024px ---------- */
@media (max-width:1024px) {
  .pad { padding-left:32px; padding-right:32px; }
  .titleSplit { flex-direction:column; gap:48px; }
  .titleSplit > * { max-width:none !important; width:100%; }
  .split { grid-template-columns:1fr; gap:36px; }
}
@media (max-width:640px) {
  .pad { padding-left:20px; padding-right:20px; }
  /* clears the fixed site header on small screens */
  .titleWrap { padding-top:150px !important; padding-bottom:52px !important; }
  .secPad { padding-top:56px !important; padding-bottom:56px !important; }
  .h1Display { font-size:clamp(38px,12vw,72px) !important; }
  .dispM { font-size:clamp(22px,6.6vw,32px) !important; }
  .standfirst { font-size:clamp(16px,4.4vw,19px) !important; }
  .caseGrid { grid-template-columns:1fr !important; gap:28px; margin-top:32px; }
  .workRow { grid-template-columns:1fr; gap:8px; }
  .tannLabel { font-size:7px; letter-spacing:1px; padding:2px 5px; }
  .tannTick { height:6px; }
}
@media (max-height:640px) and (orientation:landscape) {
  /* clears the fixed site header on small screens */
  .titleWrap { padding-top:150px !important; padding-bottom:52px !important; }
}

@media (prefers-reduced-motion: reduce) {
  .tann { animation:none; opacity:1; }
  * { scroll-behavior:auto !important; transition-duration:0.01ms !important; }
}
  </style>

</Base>
