---
import Base from '../layouts/Base.astro';
---

<Base
  navOverDark={false}
  title="What is a SPACT? — Take 3 Agency"
  description="A SPACT is a Special Action supporting artist: a background performer booked for a real, proven skill — fighting, riding, dancing, driving, drilling like a soldier — and engaged to perform that skill safely and repeatably on camera."
  ogTitle="What is a SPACT? — Take 3 Agency"
  ogDescription="A SPACT is a Special Action supporting artist: a background performer booked for a real, proven skill — fighting, riding, dancing, driving, drilling like a soldier — and engaged to perform that skill safely and repeatably on camera."
  ogImage="/uploads/Codex%20Image%2021%20Aug%202026,%2021_36_12.png"
  footerTitle="Need special action?"
  footerIntro="Meet the SPACTs we represent, or tell us what the production needs and we'll build the book."
  footerLinks={[{"label": "OUR SPACTS →", "href": "/spacts"}]}
>
  <script slot="head" type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "What is a SPACT?",
  "description": "A SPACT is a Special Action supporting artist: a background performer booked for a real, proven skill — fighting, riding, dancing, driving, drilling like a soldier — and engaged to perform that skill safely and repeatably on camera.",
  "image": "/uploads/Codex%20Image%2021%20Aug%202026,%2021_36_12.png",
  "articleSection": "The Explainer",
  "inLanguage": "en-GB",
  "author": { "@type": "Organization", "name": "Take 3 Agency" },
  "publisher": {
    "@type": "Organization",
    "name": "Take 3 Agency",
    "logo": { "@type": "ImageObject", "url": "/assets/take3-logo.svg" }
  },
  "mainEntityOfPage": { "@type": "WebPage", "@id": "/what-is-a-spact" }
}
  </script>

  <article>

  <!-- title -->
  <div class="wrap pad titleWrap" style="padding-top:186px; padding-bottom:72px;">
    <div class="titleSplit">
      <div style="flex:1 1 420px; min-width:280px;">
        <p class="eyebrow" style="letter-spacing:4px; font-size:13px;">TAKE 3 AGENCY · THE EXPLAINER</p>
        <h1 class="h1Display" style="font-family:'Anton','Jost',sans-serif; text-transform:uppercase; font-size:clamp(52px,7vw,120px); font-weight:400; letter-spacing:2px; line-height:1.02; margin:20px 0 0;">What is<br />a SPACT?</h1>
        <p class="standfirst" style="font-size:clamp(18px,1.4vw,21px); font-weight:300; line-height:1.65; color:var(--sub); margin:36px 0 0; max-width:520px;">A SPACT is a Special Action supporting artist: a background performer booked for a real, proven skill — fighting, riding, dancing, driving, drilling like a soldier — and engaged to perform that skill safely and repeatably on camera.</p>
      </div>
      <!-- casting overlay -->
      <figure style="flex:1 1 460px; min-width:0; max-width:640px; margin:0;">
        <div style="position:relative; aspect-ratio:3/2; overflow:hidden; background:var(--tileBg);">
          <img src="/uploads/Codex%20Image%2021%20Aug%202026,%2021_36_12.png" alt="Storyboard frame of a crowd scene with six SPACTs marked out by callout boxes" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; display:block;" />
          <div class="tann" style="left:13.5%; top:13%; width:8%; height:17%; animation-delay:0.6s;">
            <div class="tannBox"></div>
            <div class="tannTick" style="bottom:100%;"></div>
            <div class="tannLabel" style="bottom:calc(100% + 9px);"><span style="color:#c65b40;">●</span>&nbsp; SPACT 01</div>
          </div>
          <div class="tann" style="left:25.5%; top:18%; width:6.5%; height:12%; animation-delay:4.8s;">
            <div class="tannBox"></div>
            <div class="tannTick" style="top:100%;"></div>
            <div class="tannLabel" style="top:calc(100% + 9px); transform:translateX(calc(-50% - 20px));"><span style="color:#c65b40;">●</span>&nbsp; SPACT 04</div>
          </div>
          <div class="tann" style="left:34.5%; top:21%; width:9%; height:15%; animation-delay:2s;">
            <div class="tannBox"></div>
            <div class="tannTick" style="bottom:100%;"></div>
            <div class="tannLabel" style="bottom:calc(100% + 9px);"><span style="color:#c65b40;">●</span>&nbsp; SPACT 02</div>
          </div>
          <div class="tann" style="left:50.5%; top:18.5%; width:6.5%; height:12%; animation-delay:6.2s;">
            <div class="tannBox"></div>
            <div class="tannTick" style="top:100%;"></div>
            <div class="tannLabel" style="top:calc(100% + 9px);"><span style="color:#c65b40;">●</span>&nbsp; SPACT 05</div>
          </div>
          <div class="tann" style="left:62%; top:12.5%; width:9%; height:17%; animation-delay:3.4s;">
            <div class="tannBox"></div>
            <div class="tannTick" style="bottom:100%;"></div>
            <div class="tannLabel" style="bottom:calc(100% + 9px);"><span style="color:#c65b40;">●</span>&nbsp; SPACT 03</div>
          </div>
          <div class="tann" style="left:78.5%; top:20%; width:7.5%; height:13%; animation-delay:7.6s;">
            <div class="tannBox"></div>
            <div class="tannTick" style="bottom:100%;"></div>
            <div class="tannLabel" style="bottom:calc(100% + 9px);"><span style="color:#c65b40;">●</span>&nbsp; SPACT 06</div>
          </div>
        </div>
        <figcaption style="display:flex; justify-content:space-between; align-items:baseline; gap:16px; margin-top:12px; flex-wrap:wrap;">
          <span style="font-size:10px; letter-spacing:3px; color:#96928c;">SC. 47 — ONE SCENE, SIX SPACTS</span>
          <span style="font-size:10px; letter-spacing:3px; color:var(--accent);">ALL REAL SKILLS</span>
        </figcaption>
      </figure>
    </div>
  </div>

  <!-- 01 origin -->
  <section class="rule" aria-labelledby="ch01">
    <div class="wrap pad split secPad" style="padding-top:80px; padding-bottom:80px;">
      <div>
        <p class="eyebrow" id="ch01">01 · THE TERM</p>
        <h2 class="dispM">Where the word comes from</h2>
      </div>
      <div class="body17">
        <p style="margin:0;">SPACT is short for <strong>Special Action</strong>. On UK productions, supporting artists are engaged on crowd agreements, and when a role calls for genuine physical ability the booking is designated special action — a SPACT for short. The term lives in call sheets, crowd budgets and AD department shorthand rather than in any glossary, which is why so few people outside a set have heard it.</p>
        <p style="margin:18px 0 0;">In practice, you'll hear it used as a noun for the performer themselves: "we need six SPACTs for the fight in the market", "the riders are SPACTs, not doubles". It signals to everyone on set — ADs, stunt coordinators, HODs — that the person can genuinely do the thing the scene requires, and has been booked, briefed and paid accordingly.</p>
      </div>
    </div>
  </section>

  <!-- 02 distinctions -->
  <section class="onDark" aria-labelledby="ch02">
    <div class="wrap pad secPad" style="padding-top:80px; padding-bottom:88px;">
      <p class="eyebrow" id="ch02" style="color:#c65b40;">02 · THE DISTINCTIONS</p>
      <h2 class="dispM">SPACT, Stunt Performer, Supporting Artist</h2>
      <p style="font-size:16px; font-weight:300; line-height:1.75; color:#c7c3bd; margin:18px 0 0; max-width:760px;">The three roles sit on one spectrum of screen action, and the honest answer is that the lines are drawn by risk, pay and responsibility — not by talent.</p>
      <p style="font-size:11px; letter-spacing:2.5px; color:#96928c; margin:26px 0 0;">SELECT A ROLE TO ISOLATE IT IN THE FRAME BELOW</p>

      <div class="roleGrid">
        <button type="button" class="roleCard roleCard--edge" id="cardSa" data-role="sa" aria-pressed="false">
          <span class="roleTitle">SUPPORTING ARTIST</span>
          <span class="roleBody" style="display:block;">Populates the world of the scene. No special skill is required and none is asked for on camera. Booked through crowd casting on a standard background agreement.</span>
          <span class="roleFlag" style="display:block;">● IN FRAME — CLICK TO CLEAR</span>
        </button>
        <button type="button" class="roleCard roleCard--spact" id="cardSpact" data-role="spact" aria-pressed="true">
          <span class="roleTitle">SPACT</span>
          <span class="roleBody" style="display:block;">A supporting artist with a verified special skill, booked because of it. Performs real action — fights, dance, riding, drill — within limits agreed with the AD and stunt departments. Paid a special action rate above standard background.</span>
          <span class="roleFlag" style="display:block;">● IN FRAME — CLICK TO CLEAR</span>
        </button>
        <button type="button" class="roleCard roleCard--edge" id="cardStunt" data-role="stunt" aria-pressed="false">
          <span class="roleTitle">STUNT PERFORMER</span>
          <span class="roleBody" style="display:block;">A registered professional engaged for hazardous action — falls, burns, wire work, crashes — under a stunt coordinator's supervision. Where the risk is real, the job is a stunt, and it is never a SPACT booking.</span>
          <span class="roleFlag" style="display:block;">● IN FRAME — CLICK TO CLEAR</span>
        </button>
      </div>

      <div class="frame" id="sceneFrame" style="margin-top:56px;">
        <img class="frameImg" id="sceneImg" src="/uploads/Codex%20Image%2021%20Aug%202026,%2021_44_18.png" alt="Production frame — stunt performer, SPACT and supporting artists" />
        <div class="frameDim" id="sceneDim" style="opacity:1;"></div>
        <div id="spotLayer">
          <div class="spot" data-role="sa" style="left:2%; top:37.5%; width:42%; height:18.5%; animation-delay:0.6s; opacity:0; animation:none;">
            <div class="spotImg" style="opacity:0;"><img src="/uploads/Codex%20Image%2021%20Aug%202026,%2021_44_18.png" alt="" aria-hidden="true" style="left:7.875458%; top:-144.386694%; width:183.150183%; height:415.800416%;" /></div>
            <div class="spotBox" style="border:1px dashed rgba(244,242,238,0.55);"></div>
            <div class="spotTick" style="bottom:100%; background:rgba(244,242,238,0.55);"></div>
            <div class="spotLabel" style="bottom:calc(100% + 10px); border-color:#3a3a3e;"><span style="color:#96928c;">●</span>&nbsp; SUPPORTING ARTISTS (SA)</div>
          </div>
          <div class="spot" data-role="sa" style="left:66%; top:58%; width:21%; height:15%; animation-delay:1.8s; opacity:0; animation:none;">
            <div class="spotImg" style="opacity:0;"><img src="/uploads/Codex%20Image%2021%20Aug%202026,%2021_44_18.png" alt="" aria-hidden="true" style="left:-230.219780%; top:-285.897436%; width:366.300366%; height:512.820513%;" /></div>
            <div class="spotBox" style="border:1px dashed rgba(244,242,238,0.55);"></div>
            <div class="spotTick" style="top:100%; background:rgba(244,242,238,0.55);"></div>
            <div class="spotLabel" style="top:calc(100% + 10px); border-color:#3a3a3e;"><span style="color:#96928c;">●</span>&nbsp; SA</div>
          </div>
          <div class="spot" data-role="spact" style="left:51.5%; top:60%; width:13.5%; height:36%; animation-delay:3.4s; opacity:1; animation:none; z-index:2;">
            <div class="spotImg" style="opacity:1;"><img src="/uploads/Codex%20Image%2021%20Aug%202026,%2021_44_18.png" alt="" aria-hidden="true" style="left:-281.908832%; top:-116.666667%; width:569.800570%; height:213.675214%;" /></div>
            <div class="spotBox" style="border:1px solid rgba(244,242,238,0.95); box-shadow:0 0 0 1px rgba(20,20,22,0.35);"></div>
            <div class="spotTick" style="bottom:100%; background:rgba(244,242,238,0.95);"></div>
            <div class="spotLabel" style="bottom:calc(100% + 10px); border-color:#3a3a3e;"><span style="color:#f4f2ee;">●</span>&nbsp; SPACT — SCREEN FIGHTER</div>
          </div>
          <div class="spot" data-role="spact" style="left:4%; top:58%; width:24%; height:38%; animation-delay:3.8s; opacity:1; animation:none; z-index:2;">
            <div class="spotImg" style="opacity:1;"><img src="/uploads/Codex%20Image%2021%20Aug%202026,%2021_44_18.png" alt="" aria-hidden="true" style="left:-1.282051%; top:-105.870445%; width:320.512821%; height:202.429150%;" /></div>
            <div class="spotBox" style="border:1px solid rgba(244,242,238,0.95); box-shadow:0 0 0 1px rgba(20,20,22,0.35);"></div>
            <div class="spotTick" style="bottom:100%; background:rgba(244,242,238,0.95);"></div>
            <div class="spotLabel" style="bottom:calc(100% + 10px); border-color:#3a3a3e;"><span style="color:#f4f2ee;">●</span>&nbsp; SPACT — SHIELD LINE</div>
          </div>
          <div class="spot" data-role="stunt" style="left:53.5%; top:8%; width:28%; height:38%; animation-delay:5s; opacity:0; animation:none;">
            <div class="spotImg" style="opacity:0;"><img src="/uploads/Codex%20Image%2021%20Aug%202026,%2021_44_18.png" alt="" aria-hidden="true" style="left:-135.439560%; top:-4.655870%; width:274.725275%; height:202.429150%;" /></div>
            <div class="spotBox" style="border:1px solid #c65b40; box-shadow:0 0 0 1px rgba(20,20,22,0.35);"></div>
            <div class="spotTick" style="bottom:100%; background:#c65b40;"></div>
            <div class="spotLabel" style="bottom:calc(100% + 10px); border-color:#c65b40;"><span style="color:#c65b40;">●</span>&nbsp; STUNT PERFORMER — WIRE GAG</div>
          </div>
        </div>
      </div>

      <div class="frameMeta" style="display:flex; justify-content:space-between; align-items:baseline; gap:24px; margin-top:14px; flex-wrap:wrap;">
        <p id="sceneTitle" style="font-size:10px; letter-spacing:3px; color:#96928c; margin:0;">SC. 12 — THE SIEGE · ONE FRAME, THREE ROLES</p>
        <div class="legend">
          <button type="button" class="legBtn" id="legStunt" data-role="stunt" aria-pressed="false"><span style="color:#c65b40;">—</span> STUNT</button>
          <button type="button" class="legBtn" id="legSpact" data-role="spact" aria-pressed="true"><span style="color:#f4f2ee;">—</span> SPACT</button>
          <button type="button" class="legBtn" id="legSa" data-role="sa" aria-pressed="false">╌ SA</button>
          <button type="button" class="nextBtn" id="nextScene">NEXT SCENE →</button>
        </div>
      </div>

      <p style="font-size:14px; font-weight:300; color:#96928c; line-height:1.7; margin:44px 0 0; max-width:760px;">The line between SPACT and stunt work is a judgement call on risk, and it belongs to the stunt coordinator. A good agency flags the borderline cases before they reach set — it's a conversation we have with productions weekly.</p>
    </div>
  </section>

  <!-- 03 what they do -->
  <section class="rule" aria-labelledby="ch03">
    <div class="wrap pad split secPad" style="padding-top:80px; padding-bottom:80px;">
      <div>
        <p class="eyebrow" id="ch03">03 · THE WORK</p>
        <h2 class="dispM">What SPACTs are booked to do</h2>
      </div>
      <div>
        <div class="body17">
          <p style="margin:0;">Anywhere a scene needs genuine ability in the background rather than a mime of it. Typical bookings we supply:</p>
        </div>
        <div style="margin-top:28px;">
          <div class="workRow"><div class="workKey">SCREEN FIGHTING</div><div class="workVal">Background brawls, battle lines, gunmen in shootouts — choreographed contact that reads as real.</div></div>
          <div class="workRow"><div class="workKey">MOVEMENT</div><div class="workVal">Ballroom, Latin, club and period social dance filling a floor with people who can actually dance it.</div></div>
          <div class="workRow"><div class="workKey">MILITARY &amp; POLICE</div><div class="workVal">Ex-forces performers who move, drill and handle weapons the way the real thing does.</div></div>
          <div class="workRow"><div class="workKey">RIDING &amp; DRIVING</div><div class="workVal">Horse riders, cyclists and precision drivers working around principal action.</div></div>
          <div class="workRow"><div class="workKey">SPECIALIST BODIES</div><div class="workVal">Gymnasts, acrobats, circus and creature performers — anywhere physical control is the skill.</div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 booking -->
  <section class="rule" aria-labelledby="ch04">
    <div class="wrap pad split secPad" style="padding-top:80px; padding-bottom:88px;">
      <div>
        <p class="eyebrow" id="ch04">04 · THE BOOKING</p>
        <h2 class="dispM">How SPACTs are booked, and what to expect</h2>
      </div>
      <div class="body17">
        <p style="margin:0;">SPACTs are booked through the crowd department, usually via an agency that specialises in them. The production sends a brief — the skill, the level, the look, the dates — and the agency returns a book of artists it can vouch for. Assessed skill levels matter more than showreels here: on the day, the performer either can or cannot do what the scene needs.</p>
        <p style="margin:18px 0 0;">A production should expect a SPACT to arrive set-ready: briefed on the action, able to repeat it take after take, comfortable taking direction from ADs and coordinators, and clear about their own limits. Rates sit above standard background rates, agreed per the crowd agreement in place, with the special action noted on the chit.</p>
        <p style="margin:18px 0 0;">Every SPACT on our books has been assessed and interviewed by the Take 3 team before joining. When we send someone to set, they are exactly who we say they are.</p>
      </div>
    </div>
  </section>

  </article>

  <style is:global>
*,*::before,*::after { box-sizing:border-box; }
img { max-width:100%; }
p { text-wrap:pretty; }

@keyframes annIn { 0% { opacity:0; transform:translateY(5px); } 4% { opacity:1; transform:translateY(0); } 88% { opacity:1; } 96%, 100% { opacity:0; } }

/* focus visibility on every interactive element */
.onDark a:focus-visible, .onDark button:focus-visible { outline:2px solid #f4f2ee; outline-offset:3px; }

/* ---------- layout helpers ---------- */
.wrap { max-width:1280px; margin:0 auto; }
.pad { padding-left:60px; padding-right:60px; }
.split { display:grid; grid-template-columns:1fr 1.6fr; gap:72px; align-items:start; }
.titleSplit { display:flex; justify-content:space-between; align-items:flex-start; gap:56px; flex-wrap:wrap; }
.rule { border-top:1px solid var(--hair); }
.onDark { border-top:1px solid #3a3a3e; background:#1a1a1c; color:#f4f2ee; }

.eyebrow { font-size:12px; letter-spacing:3px; color:var(--accent); font-weight:400; margin:0; }
.dispM { font-family:'Anton','Jost',sans-serif; text-transform:uppercase; font-size:clamp(24px,2.4vw,36px); font-weight:400; letter-spacing:1px; line-height:1.2; margin:14px 0 0; }
.body17 { font-size:17px; font-weight:300; line-height:1.8; color:var(--sub); }
.body17 strong { font-weight:500; color:var(--ink); }

/* ---------- title storyboard annotations (static cycle) ---------- */
.tann { position:absolute; opacity:0; animation:annIn 14s linear infinite; }
.tannBox { position:absolute; inset:0; border:1px solid rgba(244,242,238,0.85); box-shadow:0 0 0 1px rgba(20,20,22,0.35); }
.tannTick { position:absolute; left:50%; width:1px; height:9px; background:rgba(244,242,238,0.85); }
.tannLabel { position:absolute; left:50%; transform:translateX(-50%); background:rgba(22,22,24,0.92); border:1px solid #3a3a3e; padding:4px 9px; font-size:9px; letter-spacing:2.5px; color:#f4f2ee; white-space:nowrap; }

/* ---------- role cards ---------- */
.roleGrid { display:grid; grid-template-columns:repeat(3,1fr); gap:48px; margin-top:36px; }
.roleCard { display:block; width:100%; text-align:left; font-family:inherit; font-size:inherit; color:inherit; background:none; border:0; border-top:1px solid #3a3a3e; padding:24px 0 0; margin:0; cursor:pointer; transition:border-top-color .25s, background .25s; }
.roleCard--edge:hover { border-top-color:#96928c; }
.roleCard--spact:hover { background:rgba(198,91,64,0.04); }
.roleTitle { font-size:15px; letter-spacing:3px; font-weight:500; color:#f4f2ee; transition:color .25s; }
.roleBody { font-size:15px; font-weight:300; line-height:1.75; color:#c7c3bd; margin:14px 0 0; }
.roleFlag { font-size:10px; letter-spacing:2.5px; color:#c65b40; margin-top:14px; opacity:0; transition:opacity .25s; }

/* ---------- annotated scene frame ---------- */
.frame { position:relative; aspect-ratio:3/2; overflow:hidden; background:#242426; }
.frame > img.frameImg { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; display:block; }
.frameDim { position:absolute; inset:0; background:rgba(14,14,16,0.55); transition:opacity .35s; pointer-events:none; }
.spot { position:absolute; opacity:0; animation:annIn 16s linear infinite; transition:opacity .35s; }
.spotImg { position:absolute; left:-15%; top:-15%; width:130%; height:130%; overflow:hidden; opacity:0; transition:opacity .4s; -webkit-mask-image:radial-gradient(ellipse at center, #000 40%, transparent 73%); mask-image:radial-gradient(ellipse at center, #000 40%, transparent 73%); }
.spotImg img { position:absolute; max-width:none; object-fit:cover; display:block; }
.spotBox { position:absolute; inset:0; }
.spotTick { position:absolute; left:50%; width:1px; height:10px; }
.spotLabel { position:absolute; left:50%; transform:translateX(-50%); background:rgba(22,22,24,0.92); border:1px solid #3a3a3e; padding:4px 10px; font-size:10px; letter-spacing:2.5px; color:#f4f2ee; white-space:nowrap; }

/* ---------- legend ---------- */
.legend { display:flex; gap:28px; font-size:10px; letter-spacing:2.5px; color:#96928c; flex-wrap:wrap; align-items:baseline; }
.legBtn { background:none; border:0; padding:0; margin:0; font:inherit; letter-spacing:inherit; color:inherit; cursor:pointer; white-space:nowrap; }
.legBtn:hover { color:#f4f2ee; }
.nextBtn { background:none; font:inherit; letter-spacing:inherit; color:#f4f2ee; border:1px solid #3a3a3e; padding:6px 12px; margin:0; cursor:pointer; white-space:nowrap; transition:border-color .25s, color .25s; }
.nextBtn:hover { border-color:#c65b40; color:#c65b40; }

/* ---------- work table ---------- */
.workRow { border-top:1px solid var(--hair); padding:18px 0; display:grid; grid-template-columns:220px 1fr; gap:24px; }
.workRow:last-child { border-bottom:1px solid var(--hair); }
.workKey { font-size:13px; letter-spacing:2px; color:var(--ink); }
.workVal { font-size:15px; font-weight:300; color:var(--sub); line-height:1.7; }

/* ---------- responsive: desktop rendering untouched above 1024px ---------- */
@media (max-width:1024px) {
  .pad { padding-left:32px; padding-right:32px; }
  .titleSplit { flex-direction:column; gap:48px; }
  .titleSplit > * { max-width:none !important; width:100%; }
  .split { grid-template-columns:1fr; gap:36px; }
  .roleGrid { gap:28px; }
  .spotLabel { font-size:9px; letter-spacing:1.8px; padding:3px 7px; }
}
@media (max-width:640px) {
  .pad { padding-left:20px; padding-right:20px; }
  /* clears the fixed site header on small screens */
  .titleWrap { padding-top:150px !important; padding-bottom:52px !important; }
  .secPad { padding-top:56px !important; padding-bottom:56px !important; }
  .h1Display { font-size:clamp(38px,12vw,72px) !important; }
  .dispM { font-size:clamp(22px,6.6vw,32px) !important; }
  .standfirst { font-size:clamp(16px,4.4vw,19px) !important; }
  .roleGrid { grid-template-columns:1fr !important; gap:28px; margin-top:28px; }
  .workRow { grid-template-columns:1fr; gap:8px; }
  .spotLabel { font-size:7px; letter-spacing:1px; padding:2px 5px; }
  .spotTick { height:6px; }
  .tannLabel { font-size:7px; letter-spacing:1px; padding:2px 5px; }
  .tannTick { height:6px; }
  .legend { gap:16px; }
  .frameMeta { flex-direction:column; align-items:flex-start !important; gap:14px; }
}
@media (max-height:640px) and (orientation:landscape) {
  /* clears the fixed site header on small screens */
  .titleWrap { padding-top:150px !important; padding-bottom:52px !important; }
}

@media (prefers-reduced-motion: reduce) {
  .tann, .spot { animation:none; opacity:1; }
  * { scroll-behavior:auto !important; transition-duration:0.01ms !important; }
}
  </style>

  <script slot="scripts" is:inline>
(function () {
  'use strict';

  /* ================= scene annotation ================= */
  var IMG_SIEGE = '/uploads/Codex%20Image%2021%20Aug%202026,%2021_44_18.png';
  var IMG_LANDING = '/uploads/Codex%20Image%2021%20Aug%202026,%2021_52_54.png';
  var IMG_MELEE = '/uploads/Codex%20Image%2021%20Aug%202026,%2022_12_36.png';

  var SCENES = [
    { img: IMG_SIEGE, title: 'SC. 12 — THE SIEGE · ONE FRAME, THREE ROLES', spots: [
      { role: 'sa', l: 2, t: 37.5, w: 42, h: 18.5, side: 'above', label: 'SUPPORTING ARTISTS (SA)', delay: 0.6 },
      { role: 'sa', l: 66, t: 58, w: 21, h: 15, side: 'below', label: 'SA', delay: 1.8 },
      { role: 'spact', l: 51.5, t: 60, w: 13.5, h: 36, side: 'above', label: 'SPACT — SCREEN FIGHTER', delay: 3.4 },
      { role: 'spact', l: 4, t: 58, w: 24, h: 38, side: 'above', label: 'SPACT — SHIELD LINE', delay: 3.8 },
      { role: 'stunt', l: 53.5, t: 8, w: 28, h: 38, side: 'above', label: 'STUNT PERFORMER — WIRE GAG', delay: 5 }
    ] },
    { img: IMG_LANDING, title: 'SC. 34 — THE LANDING · ONE FRAME, THREE ROLES', spots: [
      { role: 'sa', l: 38, t: 44, w: 34, h: 15, side: 'above', label: 'SUPPORTING ARTISTS (SA)', delay: 0.6 },
      { role: 'sa', l: 79, t: 42, w: 18, h: 20, side: 'below', label: 'SA', delay: 1.8 },
      { role: 'spact', l: 52, t: 53, w: 15, h: 27, side: 'above', label: 'SPACT — WEAPONS HANDLING', delay: 3.4 },
      { role: 'spact', l: 64, t: 72, w: 26, h: 26, side: 'above', label: 'SPACT', delay: 3.8 },
      { role: 'spact', l: 27, t: 52, w: 13, h: 18, side: 'below', label: 'SPACT', delay: 4.2 },
      { role: 'stunt', l: 28, t: 20, w: 20, h: 28, side: 'below', label: 'STUNT PERFORMER — EXPLOSION LAUNCH', delay: 5 }
    ] },
    { img: IMG_MELEE, title: 'SC. 51 — THE MELEE · ONE FRAME, THREE ROLES', spots: [
      { role: 'sa', l: 2, t: 6, w: 26, h: 24, side: 'below', label: 'SUPPORTING ARTISTS (SA) — SPECTATORS', delay: 0.6 },
      { role: 'sa', l: 62, t: 22, w: 26, h: 14, side: 'below', label: 'SA — SPECTATORS', delay: 1.8 },
      { role: 'spact', l: 38, t: 34, w: 24, h: 20, side: 'below', label: 'SPACT — MELEE LINE', delay: 3.4 },
      { role: 'spact', l: 1, t: 36, w: 12, h: 26, side: 'below', label: 'SPACT', delay: 3.7 },
      { role: 'spact', l: 87, t: 30, w: 12, h: 30, side: 'below', label: 'SPACT', delay: 4 },
      { role: 'stunt', l: 10, t: 38, w: 24, h: 52, side: 'above', label: 'STUNT PERFORMER — MUD FIGHT', delay: 4.2 },
      { role: 'stunt', l: 62, t: 38, w: 24, h: 46, side: 'above', label: 'STUNT PERFORMER — MUD FIGHT', delay: 5 }
    ] }
  ];

  /* state: { role, scene } — role defaults to 'spact' as authored */
  var role = 'spact';
  var sceneIdx = 0;

  var frameImg = document.getElementById('sceneImg');
  var dim = document.getElementById('sceneDim');
  var layer = document.getElementById('spotLayer');
  var titleEl = document.getElementById('sceneTitle');

  function borderFor(r) {
    return r === 'sa' ? '1px dashed rgba(244,242,238,0.55)'
      : (r === 'stunt' ? '1px solid #c65b40' : '1px solid rgba(244,242,238,0.95)');
  }
  function colFor(r) {
    return r === 'stunt' ? '#c65b40' : (r === 'spact' ? 'rgba(244,242,238,0.95)' : 'rgba(244,242,238,0.55)');
  }
  function dotFor(r) {
    return r === 'stunt' ? '#c65b40' : (r === 'spact' ? '#f4f2ee' : '#96928c');
  }
  function labBorderFor(r) { return r === 'stunt' ? '#c65b40' : '#3a3a3e'; }

  function buildScene(i) {
    var scene = SCENES[i % SCENES.length];
    if (frameImg) frameImg.setAttribute('src', scene.img);
    if (titleEl) titleEl.textContent = scene.title;
    if (!layer) return;
    layer.textContent = '';

    scene.spots.forEach(function (s) {
      var above = s.side !== 'below';
      /* spotlight geometry: expanded box is 1.3x the callout, centred on it */
      var ew = s.w * 1.3, eh = s.h * 1.3;
      var el = s.l - 0.15 * s.w, et = s.t - 0.15 * s.h;

      var spot = document.createElement('div');
      spot.className = 'spot';
      spot.setAttribute('data-role', s.role);
      spot.style.left = s.l + '%';
      spot.style.top = s.t + '%';
      spot.style.width = s.w + '%';
      spot.style.height = s.h + '%';
      spot.style.animationDelay = s.delay + 's';

      var mask = document.createElement('div');
      mask.className = 'spotImg';
      var im = document.createElement('img');
      im.setAttribute('src', scene.img);
      im.setAttribute('alt', '');
      im.setAttribute('aria-hidden', 'true');
      im.style.width = (10000 / ew) + '%';
      im.style.height = (10000 / eh) + '%';
      im.style.left = (-el / ew * 100) + '%';
      im.style.top = (-et / eh * 100) + '%';
      mask.appendChild(im);

      var box = document.createElement('div');
      box.className = 'spotBox';
      box.style.border = borderFor(s.role);
      if (s.role !== 'sa') box.style.boxShadow = '0 0 0 1px rgba(20,20,22,0.35)';

      var tick = document.createElement('div');
      tick.className = 'spotTick';
      tick.style[above ? 'bottom' : 'top'] = '100%';
      tick.style.background = colFor(s.role);

      var lab = document.createElement('div');
      lab.className = 'spotLabel';
      lab.style[above ? 'bottom' : 'top'] = 'calc(100% + 10px)';
      lab.style.borderColor = labBorderFor(s.role);
      var dotEl = document.createElement('span');
      dotEl.style.color = dotFor(s.role);
      dotEl.textContent = '●';
      lab.appendChild(dotEl);
      lab.appendChild(document.createTextNode('  ' + s.label));

      spot.appendChild(mask);
      spot.appendChild(box);
      spot.appendChild(tick);
      spot.appendChild(lab);
      layer.appendChild(spot);
    });

    applyRole();
  }

  var CARDS = [
    { role: 'sa', el: document.getElementById('cardSa') },
    { role: 'spact', el: document.getElementById('cardSpact') },
    { role: 'stunt', el: document.getElementById('cardStunt') }
  ];
  var LEGS = [
    { role: 'stunt', el: document.getElementById('legStunt') },
    { role: 'spact', el: document.getElementById('legSpact') },
    { role: 'sa', el: document.getElementById('legSa') }
  ];

  function applyRole() {
    /* frame dim + per-spot isolation */
    if (dim) dim.style.opacity = (role == null) ? '0' : '1';

    var spots = layer ? layer.querySelectorAll('.spot') : [];
    for (var i = 0; i < spots.length; i++) {
      var sp = spots[i];
      var sel = (role === sp.getAttribute('data-role'));
      var mask = sp.querySelector('.spotImg');
      if (role == null) {
        sp.style.opacity = '';
        sp.style.animation = '';
        sp.style.zIndex = '';
      } else if (sel) {
        sp.style.opacity = '1';
        sp.style.animation = 'none';
        sp.style.zIndex = '2';
      } else {
        sp.style.opacity = '0';
        sp.style.animation = 'none';
        sp.style.zIndex = '';
      }
      if (mask) mask.style.opacity = sel ? '1' : '0';
    }

    /* role cards */
    CARDS.forEach(function (c) {
      if (!c.el) return;
      var sel = role === c.role;
      c.el.style.borderTopColor = sel ? '#c65b40' : '#3a3a3e';
      c.el.setAttribute('aria-pressed', sel ? 'true' : 'false');
      var t = c.el.querySelector('.roleTitle');
      if (t) t.style.color = sel ? '#c65b40' : '#f4f2ee';
      var f = c.el.querySelector('.roleFlag');
      if (f) f.style.opacity = sel ? '1' : '0';
    });

    /* legend swatches */
    LEGS.forEach(function (l) {
      if (!l.el) return;
      l.el.setAttribute('aria-pressed', role === l.role ? 'true' : 'false');
    });
  }

  function pick(r) {
    role = (role === r) ? null : r;
    applyRole();
  }

  CARDS.concat(LEGS).forEach(function (b) {
    if (!b.el) return;
    b.el.addEventListener('click', function () { pick(b.role); });
  });

  var nextBtn = document.getElementById('nextScene');
  if (nextBtn) {
    nextBtn.addEventListener('click', function () {
      sceneIdx = (sceneIdx + 1) % SCENES.length;
      buildScene(sceneIdx);
    });
  }

  /* componentDidMount: preload the second scene image */
  (function () { var pre = new Image(); pre.src = IMG_LANDING; })();

  /* sync the server-rendered initial frame with live state */
  applyRole();
})();
  </script>
