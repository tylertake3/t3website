---
import Base from '../layouts/Base.astro';
import copy from '../content/pages/models.json';
---

<Base
  theme="light"
  navOverDark={false}
  title={copy.meta.title}
  description={copy.meta.description}
  ogTitle={copy.meta.ogTitle}
  ogDescription={copy.meta.ogDescription}
  ogImage="/assets/og-default.jpg"
  ogImageAlt={copy.meta.ogImageAlt}
  footerTitle={copy.meta.footerTitle}
  footerLinks={copy.meta.footerLinks}
>
  <link
    slot="head"
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400;1,500&display=swap"
    rel="stylesheet"
  />

  <!-- editorial hero -->
  <section class="rail hero" aria-labelledby="heroTitle">
    <div class="heroCopy">
      <p class="eyebrow6">{copy.hero.eyebrow}</p>
      <h1 class="display" id="heroTitle">{copy.hero.title}</h1>
      <p class="strapline">{copy.hero.strapline}</p>
      <p class="tagRow">
        {copy.hero.tags.map((tag) => <span>{tag}</span>)}
      </p>
    </div>
    <figure class="heroFig" style="margin:0;">
      <div class="slot heroSlot" style="aspect-ratio:2/3;"><span class="slotLabel">{copy.hero.figure.slotLabel}</span></div>
      <figcaption class="figCap"><span>{copy.hero.figure.figNumber}</span><span>{copy.hero.figure.figNote}</span></figcaption>
    </figure>
  </section>

  <!-- what we supply -->
  <section id="supply" class="band" aria-labelledby="supplyHead">
    <div class="rail bandInner">
      <h2 class="eyebrow3" id="supplyHead">{copy.supply.heading}</h2>
      <div class="list">
        {copy.supply.items.map((item) => (
          <div class="listRow">
            <span class="listNum">{item.number}</span>
            <h3 class="listTitle">{item.title}</h3>
            <p class="listBody" style="margin:0;">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- for brands and commercial -->
  <section id="brands" class="band" aria-labelledby="brandsHead">
    <div class="rail splitInner split--brands">
      <figure class="splitFig" style="margin:0;">
        <div class="slot" style="aspect-ratio:4/5;"><span class="slotLabel">{copy.brands.figure.slotLabel}</span></div>
        <figcaption class="figCap"><span>{copy.brands.figure.figNumber}</span><span>{copy.brands.figure.figNote}</span></figcaption>
      </figure>
      <div class="splitCopy">
        <p class="eyebrow3">{copy.brands.eyebrow}</p>
        <h2 class="h2Anton" id="brandsHead">{copy.brands.heading}</h2>
        <blockquote class="pullQuote">{copy.brands.pullQuote}</blockquote>
        <p class="para">{copy.brands.paragraph}</p>
      </div>
    </div>
  </section>

  <!-- for film and television -->
  <section id="film" class="filmBand" aria-labelledby="filmHead">
    <div class="rail splitInner split--film">
      <div class="splitCopy">
        <p class="eyebrow3">{copy.film.eyebrow}</p>
        <h2 class="h2Anton" id="filmHead">{copy.film.heading}</h2>
        <p class="para">{copy.film.paragraph}</p>
        <div class="defs">
          {copy.film.definitions.map((def) => (
            <div class="defRow"><span class="defKey">{def.term}</span><span>{def.description}</span></div>
          ))}
        </div>
      </div>
      <figure class="splitFig" style="margin:0;">
        <div class="slot slot--dark" style="aspect-ratio:2/3;"><span class="slotLabel">{copy.film.figure.slotLabel}</span></div>
        <figcaption class="figCap"><span>{copy.film.figure.figNumber}</span><span>{copy.film.figure.figNote}</span></figcaption>
      </figure>
    </div>
  </section>

  <!-- why book through take 3 -->
  <section class="band" aria-labelledby="whyHead">
    <div class="rail bandInner">
      <h2 class="eyebrow3" id="whyHead">{copy.why.heading}</h2>
      <div class="cards">
        {copy.why.cards.map((card) => (
          <div class="card">
            <h3 class="cardTitle">{card.title}</h3>
            <p class="cardBody">{card.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <style is:global>
    html, body { margin:0; background:#f4f2ee; font-family:'Jost', sans-serif; -webkit-font-smoothing:antialiased; }
    html[data-theme="dark"], html[data-theme="dark"] body { background:#161618; }
    html { box-sizing:border-box; }
    *, *::before, *::after { box-sizing:inherit; }
    img { max-width:100%; }

    a:hover { color:var(--muted); }

    :focus-visible { outline:2px solid var(--accent); outline-offset:3px; }

    .rail { max-width:1360px; margin:0 auto; }

    /* ---------- hero ---------- */
    /* position/min-height/background/overflow reset the homepage hero rules in global.css */
    /* same cover height as every other page, set by --coverH: the portrait
       fits the cover rather than setting its height */
    .heroSlot { height:calc(var(--coverH) - 200px); width:auto; margin-left:auto; }
    .hero { padding:170px 40px 0; display:grid; grid-template-columns:1.15fr 0.85fr; gap:56px; align-items:end; position:static; min-height:var(--coverH); background:none; overflow:visible; }
    .heroCopy { padding-bottom:56px; position:static; left:auto; bottom:auto; z-index:auto; color:inherit; width:auto; max-width:none; }
    .eyebrow6 { font-size:12px; letter-spacing:6px; color:var(--muted); }
    .display { font-family:'Anton', sans-serif; font-size:clamp(72px, 11vw, 190px); line-height:0.92; letter-spacing:0; margin:24px 0 0; text-transform:uppercase; font-weight:400; }
    .strapline { font-family:'Cormorant Garamond', serif; font-style:italic; font-size:clamp(24px,2.4vw,36px); font-weight:400; line-height:1.3; margin-top:28px; max-width:480px; color:var(--sub); text-wrap:pretty; }
    .tagRow { display:flex; gap:36px; margin-top:44px; border-top:1px solid var(--hair); padding-top:20px; font-size:12px; letter-spacing:2px; color:var(--muted); flex-wrap:wrap; }
    .heroFig { display:grid; grid-template-columns:1fr; gap:0; }
    .figCap { display:flex; justify-content:space-between; font-size:11px; letter-spacing:2px; color:var(--muted); padding-top:10px; gap:16px; }
    .heroFig .figCap { padding-bottom:24px; }

    /* ---------- image slots ---------- */
    .slot { position:relative; background:var(--tileBg); overflow:hidden; display:flex; align-items:center; justify-content:center; }
    .slot .slotLabel { font-size:10px; letter-spacing:3px; text-transform:uppercase; color:var(--muted); text-align:center; padding:0 16px; }
    .slot--dark { background:#101012; }
    /* .slot--dark's #101012 plate is the same in both themes, so its label keeps
       the light-on-dark grey rather than the theme-aware token */
    .slot--dark .slotLabel { color:#96928c; }

    /* ---------- what we supply ---------- */
    .band { border-top:1px solid var(--hair); }
    .bandInner { padding:88px 40px 96px; }
    .eyebrow3 { font-size:11px; letter-spacing:3px; color:var(--accent); }
    .list { display:grid; grid-template-columns:1fr; margin-top:36px; border-bottom:1px solid var(--hair); }
    .listRow { border-top:1px solid var(--hair); padding:30px 0; display:grid; grid-template-columns:60px 1fr 1.1fr; gap:32px; align-items:baseline; }
    .listNum { font-size:12px; letter-spacing:2px; color:var(--muted); }
    .listTitle { text-transform:uppercase; font-size:clamp(19px,2vw,28px); font-weight:300; letter-spacing:3px; margin:0; }
    .listBody { font-size:15px; font-weight:400; line-height:1.7; color:var(--sub); text-wrap:pretty; }

    /* ---------- split sections ---------- */
    .splitInner { padding:96px 40px; display:grid; gap:72px; align-items:start; }
    .split--brands { grid-template-columns:0.9fr 1.1fr; }
    .split--film { grid-template-columns:1.1fr 0.9fr; }
    .splitCopy { padding-top:12px; }
    .h2Anton { font-family:'Anton','Jost',sans-serif; text-transform:uppercase; font-size:clamp(28px,3.2vw,46px); font-weight:400; letter-spacing:0; line-height:1.15; margin:16px 0 0; max-width:520px; }
    .pullQuote { font-family:'Cormorant Garamond', serif; font-style:italic; font-size:clamp(20px,1.8vw,26px); line-height:1.5; color:var(--sub); margin:28px 0 0; max-width:520px; text-wrap:pretty; }
    .para { font-size:16px; font-weight:400; line-height:1.75; color:var(--sub); margin-top:28px; max-width:520px; text-wrap:pretty; }

    .filmBand { border-top:1px solid var(--hair); background:#1a1a1c; color:#f4f2ee; }
    /* .filmBand is a permanently dark #1a1a1c band in both themes, so everything
       inside it keeps a light-on-dark grey instead of var(--muted) */
    .filmBand .eyebrow3 { color:#96928c; }
    .filmBand .figCap { color:#96928c; }
    .filmBand .para { color:#c7c3bd; }
    .filmBand a { color:#f4f2ee; }
    .defs { display:grid; row-gap:0; font-size:15px; font-weight:400; line-height:1.7; color:#c7c3bd; margin-top:36px; max-width:520px; }
    .defRow { border-top:1px solid #35353a; padding:16px 0; display:grid; grid-template-columns:150px 1fr; gap:24px; }
    .defRow:last-child { border-bottom:1px solid #35353a; }
    /* .defs only ever render inside .filmBand — light-on-dark grey again */
    .defKey { font-size:12px; letter-spacing:2px; color:#96928c; padding-top:3px; }

    /* ---------- why ---------- */
    .cards { display:grid; grid-template-columns:repeat(3,1fr); gap:48px; margin-top:40px; }
    .card { border-top:1px solid var(--hair); padding-top:24px; }
    .cardTitle { font-size:19px; letter-spacing:1px; margin:0; font-weight:400; }
    .cardBody { font-size:15px; font-weight:400; line-height:1.7; color:var(--sub); margin-top:10px; text-wrap:pretty; }

    /* ---------- responsive: tablet ---------- */
    @media (max-width:1024px) {
      .hero { grid-template-columns:1fr; gap:40px; padding:150px 32px 0; }
      .heroCopy { padding-bottom:24px; }
      .heroFig { max-width:520px; }
      .splitInner { grid-template-columns:1fr !important; gap:48px; padding:72px 32px; }
      .split--film .splitCopy { order:2; }
      .split--film .splitFig { order:1; max-width:520px; }
      .split--brands .splitFig { max-width:520px; }
      .bandInner { padding:72px 32px 80px; }
      .listRow { grid-template-columns:48px 1fr; gap:12px 24px; }
      .listRow .listBody { grid-column:2; }
      .cards { grid-template-columns:repeat(2,1fr); gap:36px; }
    }

    /* ---------- responsive: phone ---------- */
    @media (max-width:640px) {
      /* clears the fixed site header once the hero stacks */
      .hero { padding:140px 20px 0; gap:32px; }
      .display { font-size:clamp(48px, 17vw, 96px); }
      .strapline { font-size:clamp(20px, 5.4vw, 28px); max-width:none; }
      .tagRow { gap:16px 20px; margin-top:32px; }
      .bandInner { padding:56px 20px 64px; }
      .splitInner { padding:56px 20px; gap:40px; }
      .heroFig, .splitFig { max-width:none; }
      .h2Anton, .pullQuote, .para, .defs { max-width:none; }
      .listRow { grid-template-columns:1fr; gap:10px; padding:24px 0; }
      .listRow .listBody { grid-column:auto; }
      .defRow { grid-template-columns:1fr; gap:6px; }
      .cards { grid-template-columns:1fr; gap:28px; }
    }

    /* ---------- reduced motion ---------- */
    @media (prefers-reduced-motion: reduce) {
      .page { transition:none; }
      * { animation-duration:0.001ms !important; animation-iteration-count:1 !important; transition-duration:0.001ms !important; }
      ::view-transition-old(root), ::view-transition-new(root) { animation:none !important; }
    }
  </style>
</Base>
