---
import Base from '../layouts/Base.astro';
import copy from '../content/pages/laural.json';
import ClapperBoard from '../components/ClapperBoard.astro';
---

<Base
  title={copy.meta.title}
  description={copy.meta.description}
  ogTitle={copy.meta.ogTitle}
  ogDescription={copy.meta.ogDescription}
  footerTitle={copy.meta.footerTitle}
  navOverDark={false}
>
  <!-- The whole page, until launch: a production slate in a lit studio,
       counting down to the moment. It claps when clicked and turns over on its
       button. The platform sections that used to follow are held back with the
       launch; their words are still in laural.json for when they return. -->
  <ClapperBoard
    variant="launch"
    eyebrow={copy.launch.eyebrow}
    heading={copy.launch.heading}
    lede={copy.launch.lede}
    launch={copy.launch}
  />
</Base>
