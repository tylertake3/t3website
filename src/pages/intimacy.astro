---
import Base from '../layouts/Base.astro';
import copy from '../content/pages/intimacy.json';
import { posters, posterLabel } from '../lib/posters';
import { featuredCredit, resolveCredits } from '../lib/productionLogos';
import { contactHref } from '../data/site';

/* The hero title is painted in two passes so the figure can sit BETWEEN the
   letters: everything except the chosen letters goes behind her, and those are
   painted again on top. frontLetterIndices picks them — 3 and 4 are the I and M,
   which sit on the front of her hair and raised arm, while the A stays behind
   the forearm so the arm reads as its crossbar. */
const heroLetters = copy.hero.title.toUpperCase().split('');
const heroFront = new Set(copy.hero.frontLetterIndices ?? []);

/* the productions wall: the titles named in the page content, in that order */
/* the one production shown beside a review — its logo when the artwork has
   been uploaded, otherwise its name in type */
const reviewCredits = copy.reviews.items.map((item) => {
  if ((item.feature ?? '').trim().toLowerCase() === 'none') return null;
  /* a production whose artwork hasn't been supplied yet is still named in type,
     so a review never loses its credit while a logo is being chased */
  return featuredCredit(item.credits, item.feature) ?? resolveCredits(item.credits)[0] ?? null;
});

/* the clip turns over to show this review in full — the same one whose short
   line runs in the quotes section below */
const louReview = copy.reviews.items[0];
const louCredit = reviewCredits[0];
const louParagraphs = (louReview.full ?? '').split('\n\n').filter(Boolean);

const bySlug = new Map(posters.map((p) => [p.slug, p]));
const productionPosters = copy.productions.slugs
  .map((slug) => bySlug.get(slug))
  .filter((p): p is (typeof posters)[number] => Boolean(p));
---

<Base
  theme="light"
  navOverDark={true}
  title={copy.meta.title}
  description={copy.meta.description}
  ogTitle={copy.meta.ogTitle}
  ogDescription={copy.meta.ogDescription}
  ogImage="/assets/og-default.jpg"
  ogImageAlt={copy.meta.ogImageAlt}
  footerTitle={copy.meta.footerTitle}
  footerLinks={copy.meta.footerLinks}
>
  <script slot="head" is:inline>
    /* set before paint: only hide things if we are actually going to move them */
    if (!window.matchMedia || !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.documentElement.classList.add('motion');
    }
  </script>
  <link slot="head" rel="preload" href="/fonts/cormorant-garamond/regular.ttf" as="font" type="font/ttf" crossorigin />
  <link
    slot="head"
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400;1,500&display=swap"
    rel="stylesheet"
  />

  <!-- editorial hero: the title passes behind the figure, her forearm forming the A's crossbar -->
  <section class="hero" aria-labelledby="heroTitle">
    <div class="heroFrame">
      <div class="heroStage">
        <h1 class="heroWord heroWord--back" id="heroTitle">
          {heroLetters.map((letter, i) => <span class={heroFront.has(i) ? 'heroGhost' : undefined}>{letter}</span>)}
        </h1>
        <img class="heroCut" src={copy.hero.figure.cutout} alt={copy.hero.figure.alt} width={copy.hero.figure.width} height={copy.hero.figure.height} fetchpriority="high" decoding="async" />
        <p class="heroWord heroWord--front" aria-hidden="true">
          {heroLetters.map((letter, i) => <span class={heroFront.has(i) ? undefined : 'heroGhost'}>{letter}</span>)}
        </p>
      </div>
    </div>
    <div class="heroOverlay">
      <p class="heroStrap" id="heroStrap" data-lines={JSON.stringify(copy.hero.straplines ?? [copy.hero.strapline])}>
        <span class="strapLine">{(copy.hero.straplines?.[0] ?? copy.hero.strapline).split(' ').map((word, i) => (
          <span class="strapWord">{i === 0 ? word : ' ' + word}</span>
        ))}</span>
      </p>
    </div>
  </section>

  <!-- intro: the same care as any specialist performance -->
  <section id="intro" class="band" aria-labelledby="introHead">
    <div class="rail introInner">
      <p class="eyebrow3" data-rise>{copy.intro.eyebrow}</p>
      <h2 class="introHead" id="introHead" data-head>{copy.intro.heading}</h2>
      <div class="introBody" data-rise>
        <p class="para" style="margin-top:0;">{copy.intro.paragraph1}</p>
        <p class="para" data-rise>{copy.intro.paragraph2}</p>
        <p class="introCtaRow"><a class="btnSolid introCta" href={`${contactHref}?subject=${encodeURIComponent(copy.intro.cta.subject)}`}>{copy.intro.cta.label}</a></p>
      </div>
    </div>
  </section>

  <!-- selected productions -->
  <section id="productions" class="band" aria-labelledby="productionsHead">
    <div class="rail bandInner">
      <p class="eyebrow3" data-rise>{copy.productions.eyebrow}</p>
      <div class="prodHead">
        <h2 class="h2Anton prodTitle" id="productionsHead" data-head>{copy.productions.heading}</h2>
        <p class="prodNote" data-rise>{copy.productions.note}</p>
      </div>
      <ul class="posterGrid posterGrid--six" data-stagger="posters">
        {productionPosters.map((poster) => (
          <li class="posterCell">
            <img class="posterImg" src={poster.src} alt={`${posterLabel(poster)} poster`} width="400" height="600" loading="lazy" decoding="async" />
            <span class="posterName">{posterLabel(poster)}</span>
          </li>
        ))}
      </ul>
      <p class="prodMore" data-rise><a href={copy.productions.moreHref}>{copy.productions.moreLabel} →</a></p>
    </div>
  </section>

  <!-- intimacy-trained performers -->
  <section id="trained" class="band" aria-labelledby="trainedHead">
    <div class="rail splitInner split--trained">
      <div class="splitCopy">
        <p class="eyebrow3" data-rise>{copy.trained.eyebrow}</p>
        <h2 class="h2Anton" id="trainedHead" data-head>{copy.trained.heading}</h2>
        <p class="subhead" data-rise>{copy.trained.subheading}</p>
        <p class="para" data-rise>{copy.trained.paragraph}</p>
        <ul class="points" data-stagger>
          {copy.trained.points.map((point) => <li>{point}</li>)}
        </ul>
        <p class="para workshopNote">{copy.trained.workshopNote}</p>
      </div>
      <figure class="splitFig" style="margin:0;" data-figure>
        <div class="slot flipWrap" id="louFlip" style="aspect-ratio:9/16;">
          <div class="flipInner">
            <div class="face faceFront">
              <video class="slotVideo" data-src={copy.trained.figure.video} poster={copy.trained.figure.poster} width={copy.trained.figure.width} height={copy.trained.figure.height} muted loop playsinline preload="none" aria-label={copy.trained.figure.label}></video>
            </div>
            <div class="face faceBack" id="louPanel" role="group" aria-label={copy.trained.review.panelLabel} aria-hidden="true">
              <button class="flipClose" type="button" id="louClose" aria-label={copy.trained.review.dismissLabel} tabindex="-1">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"></path></svg>
              </button>
              <p class="flipName">{louReview.name}</p>
              <p class="flipRole">{louReview.role}</p>
              {louCredit && louCredit.onDark && (
                <img class="flipLogo" src={louCredit.onDark} alt={louCredit.title} loading="lazy" width={louCredit.logoWidth} height={louCredit.logoHeight} style={louCredit.logoHeight ? `--logo-h:${louCredit.logoHeight};--logo-w:${louCredit.logoWidth}` : undefined} />
              )}
              <blockquote class="flipQuote">
                {louParagraphs.map((para) => <p>{para}</p>)}
              </blockquote>
            </div>
          </div>
        </div>
        <figcaption class="figCap">
          <button class="flipBtn" type="button" id="louFlipBtn" aria-expanded="false" aria-controls="louPanel">{copy.trained.review.openLabel}</button>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- reviews: coordinators and artists -->
  <section id="coordinator-reviews" class="quotes" aria-labelledby="quotesTitle" aria-roledescription="carousel">
    <div class="rail quotesInner">
      <div class="quotesHead">
        <h2 class="quotesTitle" id="quotesTitle" data-head>{copy.reviews.heading}</h2>
        <div class="quotesKicker" data-rise>{copy.reviews.kicker}</div>
      </div>
      <!-- one quote in focus; the others sit clear above and below, spaced by
           their own measured height so a long quote never crowds its neighbour -->
      <div class="qStage" id="qStage" tabindex="0" role="group" aria-label={copy.reviews.stageLabel}>
        <ul class="qList" id="qList">
          {copy.reviews.items.map((item, i) => (
            <li class="qRow">
              <blockquote class="qLine">{'\u201C' + item.quote + '\u201D'}</blockquote>
              <div class="qWho">
                <span class="qName">{item.name}</span>
                <span class="qRole">{item.role}</span>
                {reviewCredits[i] && (
                  <span class={reviewCredits[i].onDark ? 'qCredit qCreditLogo' : 'qCredit'}>
                    {reviewCredits[i].onDark ? (
                      <img
                        src={reviewCredits[i].onDark}
                        alt={reviewCredits[i].title}
                        loading="lazy"
                        width={reviewCredits[i].logoWidth}
                        height={reviewCredits[i].logoHeight}
                        style={reviewCredits[i].logoHeight ? `--logo-h:${reviewCredits[i].logoHeight};--logo-w:${reviewCredits[i].logoWidth}` : undefined}
                      />
                    ) : (
                      reviewCredits[i].title
                    )}
                  </span>
                )}
              </div>
            </li>
          ))}
        </ul>
      </div>
      <p class="qLive" id="qLive" aria-live="polite" aria-atomic="true"></p>
      <div class="qFoot">
        <p class="qHelper">{copy.reviews.helper}</p>
        <div class="qCount" id="qCount">01 / 01</div>
        <div class="revNav">
          <button class="revArrow" type="button" id="revPrev" aria-label={copy.reviews.previousLabel} aria-controls="qList">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 15l8-8 8 8"></path></svg>
          </button>
          <button class="revArrow" type="button" id="revNext" aria-label={copy.reviews.nextLabel} aria-controls="qList">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 9l8 8 8-8"></path></svg>
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- why book through take 3: one roster, one point of contact -->
  <section id="why-take-3" class="band" aria-labelledby="contactHead">
    <div class="rail bandInner">
      <p class="contactEyebrow" data-rise>{copy.contact.eyebrow}</p>
      <div class="contactTop">
        <h2 class="contactHead" id="contactHead" data-head>{copy.contact.heading}</h2>
      </div>
      <div class="contactCols" data-stagger>
        {copy.contact.columns.map((col) => (
          <div class="contactCol">
            <h3 class="contactColTitle"><span class="contactNum">{col.number}</span><span class="contactSlash" aria-hidden="true">/</span>{col.title}</h3>
            <p class="contactColBody">{col.body}</p>
          </div>
        ))}
      </div>
      <p class="contactCtaRow" data-rise>
        <a class="btnSolid" href={`${contactHref}?subject=${encodeURIComponent(copy.contact.cta.subject)}`}>{copy.contact.cta.label}</a>
        <span class="contactCtaNote">{copy.contact.cta.note}</span>
      </p>
    </div>
  </section>

  <!-- take 3 / after dark: the other side of the roster -->
  <section id="after-dark" class="adBand" aria-labelledby="afterDarkHead">
    <div class="rail adInner">
      <div class="adCopy">
        <p class="adEyebrow" data-rise>{copy.afterDark.eyebrow}</p>
        <h2 class="adHead" id="afterDarkHead" data-head>{copy.afterDark.heading}</h2>
        <p class="adBody" data-rise>{copy.afterDark.body}</p>
        <p class="adTags">
          {copy.afterDark.tags.map((tag, i) => (
            <>
              {i > 0 && <span class="adTagSep" aria-hidden="true">/</span>}
              <span>{tag}</span>
            </>
          ))}
        </p>
        <p class="adCtaRow"><a class="adCta" href={copy.afterDark.cta.href}>{copy.afterDark.cta.label} <span aria-hidden="true">→</span></a></p>
      </div>
      <a class="adFig" data-figure href={copy.afterDark.cta.href} aria-label={`${copy.afterDark.cta.label} — ${copy.afterDark.heading}`}>
        <img class="adImg" src={copy.afterDark.figure.src} alt={copy.afterDark.figure.alt} width={copy.afterDark.figure.width} height={copy.afterDark.figure.height} loading="lazy" decoding="async" />
      </a>
    </div>
  </section>

  <style is:global>
    html, body { margin:0; background:#f4f2ee; font-family:'Jost', sans-serif; -webkit-font-smoothing:antialiased; }
    html[data-theme="dark"], html[data-theme="dark"] body { background:#161618; }
    html { box-sizing:border-box; }
    *, *::before, *::after { box-sizing:inherit; }
    img { max-width:100%; }

    a:hover { color:var(--muted); }

    :focus-visible { outline:2px solid var(--accent); outline-offset:3px; }

    .rail { max-width:1360px; margin:0 auto; }

    /* One rhythm for the page: the shared band padding is switched off here and
       each section's own inner padding sets the spacing, so the gaps between
       sections are deliberate rather than two paddings stacked. */
    .page { --sectionPad:96px; }
    #intro, #productions, #trained, #why-take-3, #after-dark, #coordinator-reviews { padding-block:0; }

    /* every control on this page clears the 44px touch target */
    .introCta, .contactCtaRow .btnSolid, .prodMore a, .adCta { min-height:44px; display:inline-flex; align-items:center; }
    .prodMore a, .adCta { padding-block:8px; }

    /* ---------- arrival motion (motion.dev) ----------
       Nothing here changes layout: only opacity, a few pixels of travel, a
       clip and a slight scale, so no text reflows and nothing shifts. */
    html.motion [data-rise], html.motion [data-head], html.motion [data-stagger] > *, html.motion [data-figure] { opacity:0; }
    html.motion [data-head] { clip-path:inset(0 0 108% 0); }
    html.motion [data-figure] > .slot, html.motion [data-figure] > img, html.motion .adImg { clip-path:inset(0 0 100% 0); }
    html.motion .heroWord, html.motion .heroCut, html.motion .heroStrap { opacity:0; }

    /* ---------- hero ---------- */
    /* position/min-height/background/overflow reset the homepage hero rules in global.css */
    /* HERO — fixed composition for the reference's interleaved lettering.
       A studio sweep, the word, then a cut-out of the performer on top, with two
       letters (I, M) painted again in front of her so she sits BETWEEN the letters
       and her forearm reads as the crossbar of the A.
       Every position is a share of the stage WIDTH (cqw / %). The composition
       stops growing at 1440px; its visible height caps at 880px including the
       header clearance. Only the lower portrait is cropped: title and figure
       always share the same origin and scale, including on wider screens. The letters are Cormorant Garamond condensed
       to 66% width (scaleX) to match the mockup's proportions; the A's centre
       and crossbar height were measured from the font's own outlines at this
       size/spacing — change the font-size, letter-spacing, indent or scale and
       .heroCut's left/top must be recomputed. --heroClear keeps the word below
       the fixed header. */
    @font-face {
      font-family:'Intimacy Display';
      src:url('/fonts/cormorant-garamond/regular.ttf') format('truetype');
      font-weight:400;
      font-style:normal;
      font-display:block;
    }
    .hero { --heroClear:clamp(78px, 9vw, 142px); position:relative; padding:0; display:block; min-height:0; background:none; overflow:visible; }
    .heroFrame {
      position:relative; overflow:hidden; padding-top:var(--heroClear);
      background:var(--intimacyHeroBackdrop);
    }
    .heroStage { position:relative; width:100%; max-width:1440px; margin:0 auto; aspect-ratio:2368/1678; max-height:calc(880px - var(--heroClear)); container-type:inline-size; }
    .heroWord {
      position:absolute; left:50%; top:12.35vw; top:12.35cqw; z-index:1; margin:0;
      width:max-content; white-space:nowrap;
      transform:translate(-50%,-50%) scaleX(0.66); transform-origin:50% 50%;
      font-family:'Intimacy Display', 'Cormorant Garamond', serif; font-weight:400; text-transform:uppercase;
      color:var(--heroInk); line-height:1; letter-spacing:0.13em; text-indent:0.13em;
      font-size:24.8vw; font-size:24.8cqw;
    }
    .heroWord--front { z-index:3; pointer-events:none; }
    .heroGhost { color:transparent; }
    .heroCut { position:absolute; z-index:2; display:block; height:auto; max-width:none; width:102.6%; left:0.43%; top:-24.42vw; top:-24.42cqw; }

    /* The strapline shares the capped stage width; on small screens it sits
       below the image so the smaller type remains readable. */
    .heroOverlay { position:absolute; left:50%; transform:translateX(-50%); width:100%; max-width:1440px; top:var(--heroClear); container-type:inline-size; z-index:4; pointer-events:none; }
    .heroOverlay > * { pointer-events:auto; }
    .strapLine { display:inline-block; }
    .strapWord { display:inline-block; white-space:pre; backface-visibility:hidden; will-change:transform,opacity; }
    .heroStrap { position:absolute; left:3.5cqw; top:22.4cqw; margin:0; font-family:'Cormorant Garamond', serif; font-style:italic; font-weight:400; text-transform:uppercase; font-size:1.8cqw; letter-spacing:0.06em; line-height:1; color:var(--heroInk); white-space:nowrap; }
    .introCtaRow { margin-top:28px; }
    .introCta { display:inline-block; max-width:100%; text-transform:uppercase; text-decoration:none; }
    .introCta:hover { color:var(--heroInk); }
    .figCap { display:flex; justify-content:flex-end; font-size:11px; letter-spacing:2px; color:var(--muted); padding-top:6px; }
    /* the clip turns over to show Lou Kempton's review in full */
    .flipWrap { position:relative; display:block; background:#1a1a1c; }
    .flipInner { position:absolute; inset:0; }
    .face { position:absolute; inset:0; }
    /* the review rises over the clip, covering it completely, and drops back */
    .faceBack { transform:translateY(101%); visibility:hidden;
      transition:transform 0.62s cubic-bezier(0.2, 0.75, 0.25, 1), visibility 0s linear 0.62s;
      box-shadow:0 -26px 54px rgba(0,0,0,0.45); }
    .flipWrap.isOpen .faceBack { transform:none; visibility:visible;
      transition:transform 0.62s cubic-bezier(0.2, 0.75, 0.25, 1), visibility 0s linear 0s; }
    .faceBack { background:#1a1a1c; color:#f4f2ee; overflow:auto; overscroll-behavior:contain; padding:30px 26px 26px; text-align:left; }
    .flipClose { position:absolute; top:12px; right:12px; width:44px; height:44px; border:1px solid rgba(244,242,238,0.4); border-radius:50%; background:transparent; color:#f4f2ee; display:flex; align-items:center; justify-content:center; cursor:pointer; padding:0; }
    .flipClose:hover { border-color:#f4f2ee; }
    .flipName { white-space:pre-line; font-family:'Anton','Jost',sans-serif; text-transform:uppercase; font-size:30px; font-weight:400; letter-spacing:0; line-height:1.02; margin:0; }
    .flipRole { min-height:1.15em; font-size:11px; letter-spacing:2px; font-weight:500; text-transform:uppercase; color:#96928c; margin:12px 0 0; }
    .flipLogo { display:block; margin-top:14px; opacity:0.78; height:calc(var(--logo-h,30) * 1px); width:auto; max-width:calc(var(--logo-w,170) * 1px); object-fit:contain; object-position:left center; }
    .flipQuote { margin:18px 0 0; border-top:1px solid #3a3a3e; padding-top:16px; }
    .flipQuote p { font-size:14px; font-weight:400; line-height:1.7; margin:0 0 14px; color:#c7c3bd; text-wrap:pretty; }
    .flipQuote p:last-child { margin-bottom:0; }
    .flipBtn { font:inherit; font-size:11px; letter-spacing:2px; text-transform:uppercase; color:var(--ink); background:transparent; border:0; padding:10px 0 6px; min-height:44px; cursor:pointer; white-space:nowrap; text-align:right; text-decoration:underline; text-decoration-color:var(--accent); text-decoration-thickness:1px; text-underline-offset:6px; }
    .flipBtn:hover { text-decoration-thickness:2px; }
    .flipBtn:focus-visible { outline:2px solid var(--ink); outline-offset:3px; }
    .faceBack :focus-visible { outline-color:#f4f2ee; }

    /* ---------- image slots ---------- */
    .slot { position:relative; background:var(--tileBg); overflow:hidden; display:flex; align-items:center; justify-content:center; }
    .slot .slotLabel { font-size:10px; letter-spacing:3px; text-transform:uppercase; color:var(--muted); text-align:center; padding:0 16px; }

    /* ---------- bands ---------- */
    .band { border-top:1px solid var(--hair); }
    .bandInner { padding:var(--sectionPad) 40px; }
    .eyebrow3 { font-size:11px; letter-spacing:3px; color:var(--accent); }

    /* ---------- split sections ---------- */
    .splitInner { padding:96px 40px; display:grid; gap:72px; align-items:start; }
    .split--brands { grid-template-columns:0.9fr 1.1fr; }
    .splitCopy { padding-top:12px; }
    .h2Anton { font-family:'Anton','Jost',sans-serif; text-transform:uppercase; font-size:clamp(28px,3.2vw,46px); font-weight:400; letter-spacing:1px; line-height:1.15; margin:16px 0 0; max-width:520px; }
    .para { font-size:16px; font-weight:300; line-height:1.75; color:var(--sub); margin-top:28px; max-width:520px; text-wrap:pretty; }


    /* ---------- photos in slots ---------- */
    .slotVideo { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; display:block; }

    /* ---------- intro ---------- */
    .introInner { padding:var(--sectionPad) 40px; display:grid; grid-template-columns:1.1fr 0.9fr; gap:26px 72px; align-items:start; }
    .introInner .eyebrow3 { grid-column:1 / -1; margin:0; }
    .introHead { font-family:'Anton','Jost',sans-serif; text-transform:uppercase; font-size:clamp(28px,3.4vw,50px); font-weight:400; letter-spacing:0; line-height:1.02; margin:0; text-wrap:pretty; }
    .introBody { padding-top:6px; }
    .introBody .para { max-width:none; font-size:17px; }

    /* ---------- trained ---------- */
    .split--trained { grid-template-columns:1.18fr 0.82fr; gap:clamp(48px,5vw,76px); padding-top:var(--sectionPad); padding-bottom:var(--sectionPad); }
    .split--trained .h2Anton, .split--trained .subhead, .split--trained .para, .split--trained .points { max-width:585px; }
    .split--trained .splitFig { max-width:460px; margin-left:auto; }
    .subhead { font-family:'Cormorant Garamond', serif; font-style:italic; font-size:clamp(22px,2vw,30px); line-height:1.35; color:var(--sub); margin:20px 0 0; max-width:520px; text-wrap:pretty; }
    .points { list-style:none; margin:24px 0 0; padding:0; max-width:520px; border-bottom:1px solid var(--hair); }
    .points li { border-top:1px solid var(--hair); padding:14px 0 14px 28px; position:relative; font-size:15px; font-weight:400; line-height:1.6; color:var(--ink); }
    .points li::before { content:''; position:absolute; left:4px; top:22px; width:8px; height:8px; border-radius:50%; background:var(--accent); }
    .workshopNote { margin-top:32px; }

    /* ---------- productions ---------- */
    .prodHead { display:flex; justify-content:space-between; align-items:flex-end; gap:40px; border-bottom:1px solid var(--hair); padding-bottom:20px; margin-top:16px; }
    .prodTitle { margin:0; max-width:none; }
