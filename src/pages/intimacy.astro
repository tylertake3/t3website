          function scaleFor(slot) { return 1 - Math.min(Math.abs(slot), 3) * 0.055; }
          function fadeFor(slot) { return slot === 0 ? 1 : (Math.abs(slot) === 1 ? 0.3 : 0.16); }
          function blurFor(slot) { return slot === 0 ? 'blur(0px)' : 'blur(' + Math.min(Math.abs(slot), 3) * 1.6 + 'px)'; }
          function shown() { return Array.prototype.filter.call(list.children, function (el) { return !el.hidden; }); }

          /* positions come from each row's real height, so the clear space
             between one quote and the next never changes */
          function offsets() {
            var h = {}, g = gap(), p = { 0: 0 }, s;
            shown().forEach(function (el) {
              h[Number(el.getAttribute('data-slot'))] = el.getBoundingClientRect().height;
            });
            for (s = 1; s <= span; s++) p[s] = p[s - 1] + h[s - 1] / 2 + g + h[s] / 2;
            for (s = -1; s >= -span; s--) p[s] = p[s + 1] - h[s + 1] / 2 - g - h[s] / 2;
            return p;
          }

          function paint() {
            span = spanFor();
            /* any in-flight animation is dropped in the same breath the final
               styles are written, so nothing is ever drawn in between */
            anims.forEach(function (a) { try { a.cancel(); } catch (e) {} });
            anims = [];
            var used = [];
            rows.forEach(function (row) { row.hidden = true; row.removeAttribute('data-slot'); });
            spares.forEach(function (row) { if (row.parentNode) row.parentNode.removeChild(row); });
            spares = [];
            for (var slot = -span; slot <= span; slot++) {
              var i = wrap(index + slot);
              var li = rows[i];
              if (used.indexOf(i) !== -1) {           /* same quote needed twice: show a copy */
                li = rows[i].cloneNode(true);
                spares.push(li);
                list.appendChild(li);
              }
              used.push(i);
              li.hidden = false;
              li.setAttribute('data-slot', String(slot));
              li.style.translate = '0 -50%';
              li.style.scale = String(scaleFor(slot));
              li.style.opacity = String(fadeFor(slot));
              li.style.filter = blurFor(slot);
            }
            var place = function () {
              var spots = offsets();
              shown().forEach(function (el) {
                el.style.translate = '0 calc(-50% + ' + spots[Number(el.getAttribute('data-slot'))] + 'px)';
              });
            };
            place();
            /* measure again once the browser has laid the rows out, so the gap
               is exact even when a quote wraps to a different number of lines */
            if (window.requestAnimationFrame) requestAnimationFrame(function () { if (!busy) place(); });
            if (counter) counter.textContent = pad(index + 1) + ' / ' + pad(data.length);
            if (live) live.textContent = data[index].quote + ' \u2014 ' + data[index].name.replace(/\n/g, ' ') + ', ' + data[index].role;
          }

          function move(direction) {
            if (busy) return;
            busy = true;
            var spots = offsets();
            var shift = spots[direction];
            var waits = [];
            shown().forEach(function (el) {
              var slot = Number(el.getAttribute('data-slot'));
              var next = slot - direction;
              var to = {
                translate: '0 calc(-50% + ' + (spots[slot] - shift) + 'px)',
                scale: String(scaleFor(next)),
                opacity: String(fadeFor(next)),
                filter: blurFor(next)
              };
              if (reduce.matches || !el.animate) {
                el.style.translate = to.translate; el.style.scale = to.scale;
                el.style.opacity = to.opacity; el.style.filter = to.filter;
                return;
              }
              var anim = el.animate([{
                translate: '0 calc(-50% + ' + spots[slot] + 'px)',
                scale: String(scaleFor(slot)),
                opacity: String(fadeFor(slot)),
                filter: blurFor(slot)
              }, to], { duration: 950, easing: 'cubic-bezier(0.195, 0.824, 0.583, 1.208)', fill: 'both' });
              anims.push(anim);
              waits.push(anim.finished ? anim.finished : new Promise(function (res) { anim.onfinish = res; }));
            });
            var settle = function () { index = wrap(index + direction); paint(); busy = false; };
            if (!waits.length) { settle(); return; }
            Promise.all(waits).then(settle, settle);
          }

          if (prevBtn) prevBtn.addEventListener('click', function () { move(-1); });
          if (nextBtn) nextBtn.addEventListener('click', function () { move(1); });

          stage.addEventListener('keydown', function (e) {
            if (e.key === 'ArrowDown' || e.key === 'ArrowUp') { e.preventDefault(); move(e.key === 'ArrowDown' ? 1 : -1); }
          });

          stage.addEventListener('wheel', function (e) {
            if (e.ctrlKey || Math.abs(e.deltaX) > Math.abs(e.deltaY)) return;
            e.preventDefault();
            var now = Date.now();
            if (now - lastWheel > 180) wheelSum = 0;
            lastWheel = now;
            if (busy) { wheelSum = 0; return; }
            wheelSum += e.deltaY * (e.deltaMode === 1 ? 16 : e.deltaMode === 2 ? stage.clientHeight : 1);
            if (Math.abs(wheelSum) > 45) { move(wheelSum > 0 ? 1 : -1); wheelSum = 0; }
          }, { passive: false });

          stage.addEventListener('pointerdown', function (e) {
            if (e.pointerType === 'mouse') return;
            touchY = e.clientY;
            stage.setPointerCapture(e.pointerId);
          });
          stage.addEventListener('pointerup', function (e) {
            if (touchY === null) return;
            var delta = touchY - e.clientY;
            touchY = null;
            if (Math.abs(delta) > 35) move(delta > 0 ? 1 : -1);
          });
          stage.addEventListener('pointercancel', function () { touchY = null; });

          window.addEventListener('resize', function () { if (!busy) paint(); });
          if (document.fonts && document.fonts.ready) document.fonts.ready.then(function () { if (!busy) paint(); });

          paint();
        }
      }
    })();
  </script>
