  <!-- motion.dev drives the arrivals: bundled, so it ships as one small module -->
  <script>
    import { animate, inView, stagger } from 'motion';

    if (document.documentElement.classList.contains('motion')) {
      /* the site's own arrival curve, and the settle curve from the text-effect catalogue */
      const RISE = [0.22, 1, 0.36, 1];
      const SETTLE = [0.16, 1, 0.3, 1];

      /* --- the banner, on load: the word resolves out of a soft blur, the
             figure fades up behind it, the line arrives last --- */
      const word = document.querySelectorAll('.heroWord');
      const cut = document.querySelector('.heroCut');
      const strap = document.querySelector('.heroStrap');
      if (word.length) {
        /* opacity and blur only — .heroWord carries the measured
           translate/scaleX that aligns the letters to her arm, and a transform
           animation would overwrite it */
        animate(word, { opacity: [0, 1], filter: ['blur(16px)', 'blur(0px)'] },
          { duration: 0.95, ease: RISE });
      }
      if (cut) animate(cut, { opacity: [0, 1], filter: ['blur(10px)', 'blur(0px)'] }, { duration: 1.05, delay: 0.12, ease: RISE });
      if (strap) animate(strap, { opacity: [0, 1] }, { duration: 0.7, delay: 0.5, ease: SETTLE });

      /* --- everything else arrives as it is scrolled to, once --- */
      const seen = (el) => el.dataset.seen === '1';
      const mark = (el) => { el.dataset.seen = '1'; };

      inView('[data-head]', (el) => {
        if (seen(el)) return; mark(el);
        animate(el, { opacity: [0, 1], clipPath: ['inset(0 0 108% 0)', 'inset(0 0 -8% 0)'], y: [22, 0] },
          { duration: 0.78, ease: RISE });
      }, { margin: '0px 0px -12% 0px' });

      inView('[data-rise]', (el) => {
        if (seen(el)) return; mark(el);
        animate(el, { opacity: [0, 1], y: [12, 0] }, { duration: 0.66, delay: 0.06, ease: SETTLE });
      }, { margin: '0px 0px -10% 0px' });

      inView('[data-stagger]', (el) => {
        if (seen(el)) return; mark(el);
        const kids = Array.from(el.children);   /* a live HTMLCollection is not animatable */
        const posters = el.dataset.stagger === 'posters';
        animate(kids, posters ? { opacity: [0, 1], y: [26, 0], scale: [0.985, 1] } : { opacity: [0, 1], y: [16, 0] },
          { duration: posters ? 0.72 : 0.6, delay: stagger(posters ? 0.055 : 0.07), ease: RISE });
      }, { margin: '0px 0px -8% 0px' });

      inView('[data-figure]', (el) => {
        if (seen(el)) return; mark(el);
        const plate = el.querySelector('.slot, img, .adImg');
        const media = el.querySelector('video, .slot img, .adImg') || plate;
        animate(el, { opacity: [0, 1] }, { duration: 0.5, ease: SETTLE });
        /* the plate is only ever clipped — never transformed — because the
           review panel slides inside it and a transform on the plate would
           shift that panel mid-flight */
        if (plate) animate(plate, { clipPath: ['inset(0 0 100% 0)', 'inset(0 0 0% 0)'] },
          { duration: 1.0, ease: RISE });
        if (media && media !== plate) animate(media, { scale: [1.05, 1] }, { duration: 1.0, ease: RISE });
      }, { margin: '0px 0px -10% 0px' });
    }
