---
import Base from '../layouts/Base.astro';
---

<Base
  title="Stand-ins & Picture Doubles — Take 3 Agency"
  description="Accurate stand-ins, picture doubles, body, intimacy, hand and stunt doubles matched to your leads on height, build, colouring, skin tone and hair — experienced on set, so lighting holds and cameras keep turning."
  ogTitle="Stand-ins & Picture Doubles — Take 3 Agency"
  ogDescription="Accurate matches to your leads, experienced on set — so lighting holds, cameras keep turning and your actors' hours go where they matter."
  ogImage="/assets/take3-logo.svg"
  footerTitle="Book doubles for your production"
  footerLinks={[{"label": "DANCERS →", "href": "/dancers"}, {"label": "SPACTS →", "href": "/spacts"}]}
>
  <header class="hero">
    <div class="heroMedia" aria-hidden="true"></div>
    <div class="heroScrim" aria-hidden="true"></div>

    <div class="heroCopy">
      <p class="heroEyebrow">TAKE 3 AGENCY · CONTINUITY PERFORMERS</p>
      <h1 class="heroTitle">Stand-ins &amp; picture doubles</h1>
      <p class="heroLede">Accurate matches to your leads, experienced on set — so lighting holds, cameras keep turning and your actors' hours go where they matter.</p>
    </div>
  </header>

  <!-- the difference -->
  <section id="difference" class="wrap sectionPad" aria-labelledby="difference-h">
    <p class="eyebrow">THE DIFFERENCE</p>
    <h2 class="display" id="difference-h" style="max-width:720px;">Six jobs, often confused. Here's what each one does.</h2>
    <div class="cards3">
      <article class="card">
        <p class="cardNum">01</p>
        <h3 class="cardTitle">Stand-in</h3>
        <p class="cardBody">Takes the actor's place while shots are lit and blocked. Matched on height, build and colouring so every setup translates exactly when the actor steps in. Rarely on camera.</p>
      </article>
      <article class="card">
        <p class="cardNum">02</p>
        <h3 class="cardTitle">Picture double</h3>
        <p class="cardBody">Appears on camera in place of the actor — over-the-shoulder angles, hands, driving shots and distance work. The match has to hold in the frame, not just under the lights.</p>
      </article>
      <article class="card">
        <p class="cardNum">03</p>
        <h3 class="cardTitle">Body double</h3>
        <p class="cardBody">Steps in for specific physical work — physique shots, movement, anything the schedule or the script keeps the actor from doing. Cast to match in close quarters.</p>
      </article>
      <article class="card">
        <p class="cardNum">04</p>
        <h3 class="cardTitle">Intimacy double</h3>
        <p class="cardBody">Performs intimate scenes in the actor's place, working to the intimacy coordinator's choreography — cast with consent, closed-set experience and a match that holds in frame.</p>
      </article>
      <article class="card">
        <p class="cardNum">05</p>
        <h3 class="cardTitle">Hand double</h3>
        <p class="cardBody">Close-up insert work — writing, driving, product handling, instruments. Matched on skin tone, size and detail, steady under a macro lens.</p>
      </article>
      <article class="card">
        <p class="cardNum">06</p>
        <h3 class="cardTitle">Stunt double</h3>
        <p class="cardBody">Takes the action the actor can't — falls, fights, vehicle work — under the stunt coordinator, matched closely enough to cut seamlessly with the performance.</p>
      </article>
    </div>
  </section>

  <!-- why it matters: dark band -->
  <section class="band" aria-labelledby="whymatters-h">
    <div class="bandGrid">
      <div class="bandMedia">
        <div class="slot"><span>On-set still — lighting setup</span></div>
      </div>
      <div class="bandCopy">
        <p class="eyebrowMuted">WHY IT MATTERS</p>
        <h2 class="display" id="whymatters-h">A good match keeps the whole unit moving.</h2>
        <div class="rows rowsDark">
          <div class="row"><span class="rowLabel">LIGHTING &amp; CAMERA</span><span>Setups are lit and blocked on a true match — nothing shifts when the actor steps onto their mark.</span></div>
          <div class="row"><span class="rowLabel">A MOVING SET</span><span>Your leads rest, rehearse or shoot on another unit while setups continue without them.</span></div>
          <div class="row"><span class="rowLabel">SCHEDULE &amp; COST</span><span>Fewer resets and less actor downtime — the saving compounds across every shoot day.</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- matching -->
  <section id="matching" class="matchGrid" aria-labelledby="matching-h">
    <div class="matchCol">
      <p class="eyebrow">MATCHING</p>
      <h2 class="display" id="matching-h">Matched to your leads, not close enough.</h2>
      <div class="matchList">
        <div class="matchItem"><span class="matchNum">01</span><span class="matchName">Height</span></div>
        <div class="matchItem"><span class="matchNum">02</span><span class="matchName">Build</span></div>
        <div class="matchItem"><span class="matchNum">03</span><span class="matchName">Colouring</span></div>
        <div class="matchItem"><span class="matchNum">04</span><span class="matchName">Skin tone</span></div>
        <div class="matchItem"><span class="matchNum">05</span><span class="matchName">Hair</span></div>
      </div>
      <p class="matchNote">Send your leads' details or casting references — we shortlist from measured, photographed artists on our books, not self-reported stats.</p>
    </div>
    <div class="matchMedia">
      <div class="slot"><span>Side-by-side — lead and double</span></div>
    </div>
  </section>

  <!-- commercial & brand -->
  <section class="rule" aria-labelledby="commercial-h">
    <div class="commGrid">
      <div>
        <p class="eyebrow">FOR COMMERCIAL &amp; BRAND</p>
        <h2 class="display" id="commercial-h">Not just for features.</h2>
      </div>
      <div class="rows rowsLight" style="margin-top:0;">
        <div class="row"><span class="rowLabel">CAMPAIGN SHOOTS</span><span>Lighting doubles for principal talent on limited hours — setups ready the moment they arrive.</span></div>
        <div class="row"><span class="rowLabel">STILLS &amp; CONTENT</span><span>Hands, product interaction and distance work shot on a double while your talent covers the hero frames.</span></div>
        <div class="row"><span class="rowLabel">TIGHT SCHEDULES</span><span>One shoot day instead of two — a match on set is often the cheapest hour a smaller production can buy.</span></div>
      </div>
    </div>
  </section>

  <!-- why book through take 3 -->
  <section id="why" class="rule" aria-labelledby="why-h">
    <div class="whyPad">
      <h2 class="eyebrow" id="why-h">WHY BOOK THROUGH TAKE 3</h2>
      <div class="why3">
        <article class="card">
          <h3 class="whyTitle">Set-ready people</h3>
          <p class="whyBody">Experienced stand-ins who know set etiquette — where to be, when to be silent, how to hold a mark and take direction from the camera department.</p>
        </article>
        <article class="card">
          <h3 class="whyTitle">Admin handled</h3>
          <p class="whyBody">Contracts, fees, overtime and on-the-day coordination dealt with by us — one invoice, no chasing.</p>
        </article>
        <article class="card">
          <h3 class="whyTitle">One relationship</h3>
          <p class="whyBody">Doubles, dancers, fighters and specialists through a single point of contact — one roster, every format.</p>
        </article>
      </div>
    </div>
  </section>

  <style is:global>
    :root { --bandBg:#1a1a1c; }

    html { scroll-behavior:smooth; }

    .wrap { max-width:1280px; margin:0 auto; }

    /* ---------- hero ---------- */
    .hero { position:relative; min-height:78vh; background:var(--heroBg); overflow:hidden; display:flex; flex-direction:column; }
    /* The hero photo is not yet supplied: the media layer degrades to the flat
       dark --heroBg colour and the gradient scrim stays applied on top. */
    .heroMedia { position:absolute; inset:0; background:var(--heroBg); }
    .heroScrim { position:absolute; inset:0; pointer-events:none; background:linear-gradient(180deg, rgba(20,20,22,0.6) 0%, rgba(20,20,22,0.15) 30%, rgba(20,20,22,0.15) 55%, rgba(20,20,22,0.8) 100%); }

    /* padding-top clears the fixed site header at short viewport heights */
    .heroCopy { position:relative; z-index:2; margin-top:auto; padding:150px 40px 64px; color:#f4f2ee; pointer-events:none; }
    .heroEyebrow { font-size:12px; letter-spacing:6px; color:rgba(244,242,238,0.7); }
    .heroTitle { font-family:'Anton',sans-serif; font-size:clamp(38px, 4.8vw, 84px); letter-spacing:3px; line-height:1.05; margin:18px 0 0; text-transform:uppercase; font-weight:400; max-width:none; white-space:normal; }
    .heroLede { font-size:clamp(17px,1.6vw,22px); font-weight:300; letter-spacing:1px; margin-top:18px; max-width:680px; color:rgba(244,242,238,0.9); text-wrap:pretty; }

    /* ---------- shared type ---------- */
    .eyebrow { font-size:11px; letter-spacing:3px; color:var(--accent); }
    .eyebrowMuted { font-size:11px; letter-spacing:3px; color:#96928c; }
    .display { font-family:'Anton','Jost',sans-serif; text-transform:uppercase; font-size:clamp(28px,3vw,44px); font-weight:400; letter-spacing:1px; line-height:1.15; margin:16px 0 0; }
    .sectionPad { padding:96px 40px; }

    /* ---------- the difference ---------- */
    .cards3 { display:grid; grid-template-columns:repeat(3,1fr); gap:48px; margin-top:56px; }
    .card { border-top:1px solid var(--hair); padding-top:24px; }
    .cardNum { font-size:12px; letter-spacing:2px; color:#96928c; }
    .cardTitle { font-size:clamp(22px,2vw,30px); font-weight:300; letter-spacing:2px; margin:12px 0 0; }
    .cardBody { font-size:15px; font-weight:300; line-height:1.7; color:var(--sub); margin-top:14px; text-wrap:pretty; }

    /* ---------- why it matters band ---------- */
    .band { border-top:1px solid var(--hair); border-bottom:1px solid var(--hair); background:var(--bandBg); color:#f4f2ee; }
    .bandGrid { max-width:1280px; margin:0 auto; padding:0 40px; display:grid; grid-template-columns:1fr 1.3fr; gap:72px; align-items:stretch; }
    .bandMedia { position:relative; background:var(--heroBg); min-height:560px; overflow:hidden; }
    .bandCopy { padding:88px 0; }
    .bandCopy .display { max-width:520px; }
    .rows { display:grid; row-gap:0; font-size:16px; font-weight:300; line-height:1.7; margin-top:36px; }
    .rowsDark { color:#c7c3bd; }
    .rowsLight { color:var(--sub); }
    .row { padding:20px 0; display:grid; grid-template-columns:170px 1fr; gap:24px; }
    .rowsDark .row { border-top:1px solid #35353a; }
    .rowsDark .row:last-child { border-bottom:1px solid #35353a; }
    .rowsLight .row { border-top:1px solid var(--hair); }
    .rowsLight .row:last-child { border-bottom:1px solid var(--hair); }
    .rowLabel { font-size:12px; letter-spacing:2px; color:#96928c; padding-top:4px; }

    /* ---------- matching ---------- */
    .matchGrid { max-width:1280px; margin:0 auto; padding:96px 40px; display:grid; grid-template-columns:1.25fr 1fr; gap:72px; align-items:stretch; }
    .matchCol { display:flex; flex-direction:column; }
    .matchCol .display { max-width:520px; }
    .matchList { flex:1; display:flex; flex-direction:column; justify-content:center; margin-top:24px; border-bottom:1px solid var(--hair); }
    .matchItem { border-top:1px solid var(--hair); padding:18px 0; display:flex; align-items:baseline; gap:28px; }
    .matchNum { font-size:12px; letter-spacing:2px; color:#96928c; width:28px; flex:0 0 28px; }
    .matchName { text-transform:uppercase; font-size:clamp(17px,1.8vw,24px); font-weight:300; letter-spacing:3px; }
    .matchNote { font-size:14px; font-weight:300; color:#96928c; line-height:1.6; margin-top:28px; max-width:520px; text-wrap:pretty; }
    .matchMedia { position:relative; background:var(--tileBg); min-height:560px; overflow:hidden; }

    /* unfilled photo placeholders */
    .slot { position:absolute; inset:0; background:var(--tileBg); display:flex; align-items:center; justify-content:center; text-align:center; padding:24px; }
    .slot span { font-size:11px; letter-spacing:3px; text-transform:uppercase; color:#96928c; font-weight:300; }

    /* ---------- commercial & brand ---------- */
    .rule { border-top:1px solid var(--hair); }
    .commGrid { max-width:1280px; margin:0 auto; padding:88px 40px 96px; display:grid; grid-template-columns:1fr 1.4fr; gap:72px; align-items:start; }
    .whyPad { max-width:1280px; margin:0 auto; padding:88px 40px 96px; }
    .why3 { display:grid; grid-template-columns:repeat(3,1fr); gap:48px; margin-top:40px; }
    .whyTitle { font-size:19px; letter-spacing:1px; margin:0; font-weight:400; }
    .whyBody { font-size:15px; font-weight:300; line-height:1.7; color:var(--sub); margin-top:10px; text-wrap:pretty; }

    /* ---------- responsive (desktop rendering unchanged) ---------- */
    @media (max-width:1024px) {
      .cards3 { grid-template-columns:repeat(2,1fr); gap:40px; }
      .why3 { grid-template-columns:repeat(2,1fr); gap:40px; }
      .bandGrid, .matchGrid, .commGrid { grid-template-columns:1fr; gap:48px; }
      .bandGrid { padding:0 0 0; }
      .bandMedia { min-height:420px; }
      .bandCopy { padding:64px 40px 88px; }
      .matchMedia { min-height:420px; order:2; }
      .matchGrid { padding:72px 40px; }
      .commGrid { padding:72px 40px 80px; }
      .whyPad { padding:72px 40px 80px; }
      .sectionPad { padding:72px 40px; }
    }
    @media (max-width:640px) {
      .hero { padding:0; }
      .heroCopy { padding:120px 20px 48px; }
      .heroEyebrow { letter-spacing:4px; font-size:11px; }
      .heroTitle { font-size:clamp(30px, 9.5vw, 46px); letter-spacing:2px; }
      .heroLede { font-size:clamp(16px, 4.4vw, 19px); letter-spacing:0.5px; }
      .display { font-size:clamp(24px, 7.5vw, 34px); }
      .sectionPad { padding:64px 20px; }
      .cards3 { grid-template-columns:1fr; gap:32px; margin-top:40px; }
      .why3 { grid-template-columns:1fr; gap:32px; }
      .bandCopy { padding:56px 20px 72px; }
      .bandMedia { min-height:320px; }
      .matchGrid { padding:64px 20px; gap:40px; }
      .matchMedia { min-height:320px; }
      .commGrid { padding:56px 20px 64px; gap:40px; }
      .whyPad { padding:56px 20px 64px; }
      .row { grid-template-columns:1fr; gap:6px; }
    }

    @media (prefers-reduced-motion: reduce) {
      * { animation-duration:0.001ms !important; transition-duration:0.001ms !important; }
    }
  </style>
</Base>
