---
import Base from '../layouts/Base.astro';
import copy from '../content/pages/spacts.json';
---

<Base
  title={copy.meta.title}
  description={copy.meta.description}
  ogTitle={copy.meta.ogTitle}
  ogDescription={copy.meta.ogDescription}
  ogImage="/uploads/w1280.jpg"
  footerTitle={copy.meta.footerTitle}
  footerLinks={copy.meta.footerLinks}
>
  <!-- full-bleed hero: production stills fade -->
  <header class="hero" style="position:relative; min-height:78vh; background:#101012; overflow:hidden;">
    <div class="heroLayer" data-layer="0" style="position:absolute; inset:0; opacity:1; transition:opacity 1.8s ease; background-image:url(&quot;/uploads/w1280.jpg&quot;); background-size:cover; background-position:center;"></div>
    <div class="heroLayer" data-layer="1" style="position:absolute; inset:0; opacity:0; transition:opacity 1.8s ease; background-image:url(&quot;/uploads/_dfa3c099-9b6c-45ce-8c99-e24d9e51a891.jpg&quot;); background-size:cover; background-position:center;"></div>
    <div class="heroLayer" data-layer="2" style="position:absolute; inset:0; opacity:0; transition:opacity 1.8s ease; background-image:url(&quot;/uploads/lotr-s2-ut-230403-00131-r2-jpg-66f4b25127687.avif&quot;); background-size:cover; background-position:center;"></div>
    <div style="position:absolute; inset:0; background:linear-gradient(180deg, rgba(20,20,22,0.6) 0%, rgba(20,20,22,0.15) 30%, rgba(20,20,22,0.15) 55%, rgba(20,20,22,0.8) 100%);"></div>

    <div class="heroPad" style="position:absolute; left:40px; right:40px; bottom:64px; z-index:2; color:#f4f2ee;">
      <div style="font-size:12px; letter-spacing:6px; color:rgba(244,242,238,0.7);">{copy.hero.eyebrow}</div>
      <h1 class="heroTitle" style="font-family:'Anton','Jost',sans-serif; font-size:clamp(48px, 6vw, 104px); font-weight:400; letter-spacing:4px; line-height:1.02; margin:18px 0 0; text-transform:uppercase;">{copy.hero.title}</h1>
      <p style="font-size:clamp(17px,1.6vw,22px); font-weight:300; letter-spacing:1px; margin:18px 0 0; max-width:640px; color:rgba(244,242,238,0.9); text-wrap:pretty;">{copy.hero.strapline}</p>
      <div class="heroCredit" style="position:absolute; right:0; bottom:-24px; z-index:2; text-align:right; color:rgba(244,242,238,0.75); font-size:11px; letter-spacing:3px;">
        {copy.hero.creditLabel}<br /><span id="heroTitleTxt" style="font-size:20px; letter-spacing:5px; font-weight:300; color:#f4f2ee;">{copy.hero.creditTitle}</span>
      </div>
    </div>
  </header>

  <!-- what is a spact -->
  <section id="what" class="pad split" style="max-width:1280px; margin:0 auto; padding:96px 40px; display:grid; grid-template-columns:1fr 1.4fr; gap:72px; align-items:start;">
    <div>
      <h2 style="font-size:11px; letter-spacing:3px; color:var(--accent); font-weight:400; margin:0;">{copy.what.eyebrow}</h2>
      <p class="dispXL" style="font-family:'Anton','Jost',sans-serif; text-transform:uppercase; font-size:clamp(28px,3vw,44px); font-weight:400; letter-spacing:1px; line-height:1.15; margin:16px 0 0;">{copy.what.heading}</p>
    </div>
    <div style="font-size:17px; font-weight:300; line-height:1.75; color:var(--sub); text-wrap:pretty;">
      <p style="margin:0;">{copy.what.paragraph}</p>
      <a href={copy.what.linkHref} style="display:inline-block; margin-top:24px; font-size:12px; letter-spacing:2px; color:var(--accent);">{copy.what.linkLabel}</a>
    </div>
  </section>

  <!-- disciplines grid -->
  <section id="disciplines" class="pad" style="max-width:1280px; margin:0 auto; padding:0 40px 96px;">
    <div class="secHead" style="display:flex; justify-content:space-between; align-items:baseline; border-bottom:1px solid var(--hair); padding-bottom:18px; margin-bottom:8px;">
      <h2 class="dispL" style="font-family:'Anton','Jost',sans-serif; text-transform:uppercase; font-size:clamp(26px,3vw,40px); font-weight:400; letter-spacing:1px; margin:0;">{copy.disciplines.heading}</h2>
      <div style="font-size:11px; letter-spacing:3px; color:var(--accent);">{copy.disciplines.kicker}</div>
    </div>
    <ul class="disc" style="list-style:none; margin:0; padding:0; display:grid; grid-template-columns:repeat(3,1fr); column-gap:48px;">
      {copy.disciplines.items.map((item) => (
        <li style="border-bottom:1px solid var(--hair); padding:22px 0; display:flex; gap:18px; align-items:baseline;"><span style="font-size:12px; letter-spacing:2px; color:#96928c;">{item.number}</span><span style="font-size:17px; letter-spacing:2px;">{item.title}</span></li>
      ))}
    </ul>
    <p style="font-size:14px; font-weight:300; color:#96928c; line-height:1.6; margin:24px 0 0; max-width:720px; text-wrap:pretty;">{copy.disciplines.note}</p>
  </section>

  <!-- for film and television -->
  <section style="border-top:1px solid var(--hair); border-bottom:1px solid var(--hair); background:#1a1a1c; color:#f4f2ee;">
    <div class="pad" style="max-width:1280px; margin:0 auto; padding:88px 40px;">
      <div class="split" style="display:grid; grid-template-columns:1fr 1.4fr; gap:72px; align-items:start;">
        <div>
          <h2 style="font-size:11px; letter-spacing:3px; color:#96928c; font-weight:400; margin:0;">{copy.film.eyebrow}</h2>
          <p class="dispXL" style="font-family:'Anton','Jost',sans-serif; text-transform:uppercase; font-size:clamp(28px,3vw,44px); font-weight:400; letter-spacing:1px; line-height:1.15; margin:16px 0 0;">{copy.film.heading}</p>
        </div>
        <p style="font-size:16px; font-weight:300; line-height:1.75; color:#c7c3bd; text-wrap:pretty; margin:0;">{copy.film.paragraph}</p>
      </div>
      <div class="tiles" style="display:grid; grid-template-columns:repeat(3,1fr); gap:16px; margin-top:48px;">
        {copy.film.tiles.map((tile) => (
          <figure style="margin:0;">
            <div style="aspect-ratio:16/9; overflow:hidden; background:#101012;"><img src={tile.image} alt={tile.alt} loading="lazy" decoding="async" style="width:100%; height:100%; object-fit:cover; display:block;" /></div>
            <figcaption style="font-size:14px; letter-spacing:4px; margin-top:12px;">{tile.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- for commercial and brand -->
  <section class="pad" style="max-width:1280px; margin:0 auto; padding:88px 40px;">
    <div class="split" style="display:grid; grid-template-columns:1fr 1.4fr; gap:72px; align-items:start;">
      <div>
        <h2 style="font-size:11px; letter-spacing:3px; color:var(--accent); font-weight:400; margin:0;">{copy.commercial.eyebrow}</h2>
        <p class="dispXL" style="font-family:'Anton','Jost',sans-serif; text-transform:uppercase; font-size:clamp(28px,3vw,44px); font-weight:400; letter-spacing:1px; line-height:1.15; margin:16px 0 0;">{copy.commercial.heading}</p>
      </div>
      <ul style="list-style:none; margin:0; padding:0; display:grid; row-gap:0; font-size:16px; font-weight:300; line-height:1.7; color:var(--sub);">
        {copy.commercial.items.map((item, i) => (
          <li style={i === copy.commercial.items.length - 1 ? 'padding:18px 0;' : 'border-bottom:1px solid var(--hair); padding:18px 0;'}>{item}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- why book through take 3 -->
  <section id="why" class="pad" style="max-width:1280px; margin:0 auto; padding:0 40px 96px;">
    <div style="display:flex; justify-content:space-between; align-items:baseline; border-bottom:1px solid var(--hair); padding-bottom:18px; margin-bottom:40px;">
      <h2 class="dispL" style="font-family:'Anton','Jost',sans-serif; text-transform:uppercase; font-size:clamp(26px,3vw,40px); font-weight:400; letter-spacing:1px; margin:0;">{copy.why.heading}</h2>
    </div>
    <div class="why" style="display:grid; grid-template-columns:repeat(3,1fr); gap:48px;">
      {copy.why.cards.map((card) => (
        <div>
          <div style="font-size:12px; letter-spacing:2px; color:#96928c;">{card.number}</div>
          <h3 style="font-size:19px; letter-spacing:1px; margin:12px 0 0; font-weight:400;">{card.title}</h3>
          <p style="font-size:15px; font-weight:300; line-height:1.7; color:var(--sub); margin:10px 0 0; text-wrap:pretty;">{card.body}</p>
        </div>
      ))}
    </div>
  </section>

  <style is:global>
    img { max-width:100%; }

    /* this page's hero predates global.css's .hero/.heroLayer/.heroTitle rules —
       neutralise the parts of those that the original page did not have */
    .heroLayer { filter:none; }
    .heroTitle { max-width:none; white-space:normal; }

    /* responsive: desktop rendering untouched above 1024px */
    @media (max-width:1024px) {
      .split { grid-template-columns:1fr !important; gap:40px !important; }
      .disc { grid-template-columns:repeat(2,1fr) !important; column-gap:32px !important; }
      .why { grid-template-columns:repeat(2,1fr) !important; gap:36px !important; }
      .tiles { grid-template-columns:repeat(2,1fr) !important; }
      .pad { padding-left:24px !important; padding-right:24px !important; }
      .heroPad { left:24px !important; right:24px !important; }
      .heroCredit { right:24px !important; }
    }
    @media (max-width:640px) {
      .disc, .why, .tiles { grid-template-columns:1fr !important; }
      .heroTitle { font-size:clamp(38px,13vw,64px) !important; }
      .dispL { font-size:clamp(24px,7vw,34px) !important; }
      .dispXL { font-size:clamp(26px,8vw,40px) !important; }
      .secHead { flex-direction:column; align-items:flex-start !important; gap:10px; }
      .hero { min-height:82vh !important; padding:0; }
      .heroPad { bottom:44px !important; }
      .heroCredit { position:static !important; text-align:left !important; margin-top:24px; }
    }
  </style>

  <script slot="scripts" is:inline>
    (function () {
      'use strict';
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* ---------- hero cross-fade rotator ---------- */
      var titles = ['ANDOR', 'ODYSSEY', 'RINGS OF POWER'];
      var layers = Array.prototype.slice.call(document.querySelectorAll('.heroLayer'));
      var titleEl = document.getElementById('heroTitleTxt');
      var idx = 0;
      if (!reduce && layers.length > 1) {
        setInterval(function () {
          idx = (idx + 1) % layers.length;
          for (var k = 0; k < layers.length; k++) layers[k].style.opacity = (k === idx) ? '1' : '0';
          if (titleEl) titleEl.textContent = titles[idx] || '';
        }, 5000);
      }
    })();
  </script>
</Base>
