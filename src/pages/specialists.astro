---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import Base from '../layouts/Base.astro';
import { pageExists } from '../lib/pages';
import copy from '../content/pages/specialists.json';
import { getEntry } from 'astro:content';
import { featuredCredit } from '../lib/productionLogos';

/* the quote beside the on-set still is a normal review from the shared
   collection, so it carries a production logo exactly like the homepage cards */
const featureReview = await getEntry('reviews', copy.feature.review);
const featureCredit = featureReview ? featuredCredit(featureReview.data.credits, featureReview.data.feature) : null;
const featureQuote = featureReview?.body?.trim() ?? '';

/* Only link to a division once its page is actually in the build —
   the same guard artists.astro uses for its link through to this page.
 *
 * The `|| builtFromRoot` half is a local workaround, not a second opinion.
 * pageExists() resolves `../pages` from import.meta.url, which under
 * `astro build` is a bundled chunk in dist/.prerender/chunks/, so it answers
 * false for every route in a production build (the same resolution is used
 * inside Header.astro, which is why the overlay menu ships empty). Resolving
 * from the project root instead is correct in dev and in the build. Drop this
 * once src/lib/pages.ts is fixed. */
const builtFromRoot = (href: string) => {
  const slug = href.replace(/^\//, '').replace(/[#?].*$/, '');
  if (!slug) return false;
  const pages = join(process.cwd(), 'src', 'pages');
  return existsSync(join(pages, `${slug}.astro`)) || existsSync(join(pages, slug, 'index.astro'));
};

/* The divisions clients search for by name, each with a page of its own.
   A division only appears here once its page exists, so the hub can be
   extended a division at a time without ever showing a client a link to nothing. */
const divisions = copy.divisions.items.filter((item) => pageExists(item.href) || builtFromRoot(item.href));
---

<Base
  title={copy.meta.title}
  description={copy.meta.description}
  ogTitle={copy.meta.ogTitle}
  ogDescription={copy.meta.ogDescription}
  ogImage={copy.meta.ogImage}
  ogImageAlt={copy.meta.ogImageAlt}
  footerTitle={copy.meta.footerTitle}
>
  <!-- hero: the title carries the page on its own. The cover stills cross-fade
       every five seconds with the credit following, the event cover's recipe;
       only the first still is fetched with the page -->
  <section class="pageHero specHero" aria-labelledby="specialistsTitle">
    {
      copy.hero.stills.map((still, i) => (
        <div
          class="specHeroPhoto"
          data-label={still.creditLabel}
          data-credit={still.credit}
          data-bg={i === 0 ? undefined : still.image}
          role="img"
          aria-label={still.alt}
          aria-hidden={i === 0 ? undefined : 'true'}
          style={`${i === 0 ? `background-image:url("${encodeURI(still.image)}"); opacity:1;` : 'opacity:0;'} background-position:${still.focus};`}
        />
      ))
    }
    <div class="specHeroScrim"></div>
    <div class="pageHeroInner">
      <p class="kicker" data-hero-line>{copy.hero.eyebrow}</p>
      <h1 class="pageHeroTitle" id="specialistsTitle" data-hero-line>{copy.hero.heading}</h1>
      {/* production credit for the current still, bottom-right like the SPACTs cover */}
      <p class="specHeroCredit" data-hero-line>
        <span class="specHeroCreditText" id="specHeroCredit">
          {copy.hero.stills[0].creditLabel}<br /><span class="specHeroCreditName">{copy.hero.stills[0].credit}</span>
        </span>
      </p>
    </div>
  </section>

  <!-- the divisions: pictures first, one line each. Same category grid the
       Artists page uses, so the hub reads as a set of doors rather than a page of copy -->
  {
    divisions.length > 0 && (
      <section class="band" aria-labelledby="divisionsTitle">
        <div class="bandInner">
          <div class="sectionHead specHead" data-reveal-head>
            <h2 class="sectionTitle" id="divisionsTitle">
              {copy.divisions.heading}
            </h2>
            <p class="kicker">{copy.divisions.kicker}</p>
          </div>
          <ul class="catGrid" data-reveal-group="0.07">
            {divisions.map((item) => (
              <li class="catCard">
                <a class="catLink" href={item.href}>
                  <span class="catSlot catSlotPhoto" style="aspect-ratio:4/5;" data-reveal-figure>
                    <img
                      src={item.image}
                      alt={item.imageAlt}
                      loading="lazy"
                      decoding="async"
                      style={item.imageFocus ? `object-position:${item.imageFocus};` : undefined}
                    />
                  </span>
                  <span class="catName" data-reveal-item>{item.name}</span>
                </a>
                <p class="catDesc" data-reveal-item>{item.description}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- everything else: a two-column read. The intro on the left says these
       people are already on the books; on the right each one opens to a line
       of detail, so the list stays short until someone wants more -->
  <section class="band" aria-labelledby="examplesTitle">
    <div class="bandInner">
      <div class="sectionHead specHead" data-reveal-head>
        <h2 class="sectionTitle" id="examplesTitle">{copy.examples.heading}</h2>
        <p class="kicker">{copy.examples.kicker}</p>
      </div>
      <div class="specAsk" data-reveal-group="0.08">
        <div class="specAskIntro">
          <p class="bandBody" data-reveal-item>{copy.examples.intro}</p>
        </div>
        <ul class="specAskList">
          {copy.examples.items.map((item) => (
            <li class="specAskItem" data-reveal-item>
              <details class="specAskRow">
                <summary class="specAskName">
                  <span>{item.name}</span>
                  <span class="specAskMark" aria-hidden="true"></span>
                </summary>
                <p class="specAskBody">{item.body}</p>
              </details>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- on set: a production still beside a client's words -->
  <section class="band bandDark specDark specFeatureBand" aria-labelledby="featureTitle">
    <div class="bandInner specFeature" data-reveal-group="0.1">
      <figure class="specStill">
        <div class="specStillFrame" data-reveal-figure>
          <img src={copy.feature.still.image} alt={copy.feature.still.alt} loading="lazy" decoding="async" />
        </div>
      </figure>
      {featureReview && (
        <article class="specFeatureQuote revCard" data-reveal-item>
          <h3 class="revName" id="featureTitle">{featureReview.data.name}</h3>
          <p class="revRole">{featureReview.data.role}</p>
          <div class="revCredits">
            {featureCredit && (
              <span class={featureCredit.onDark ? 'revCredit revCreditLogo' : 'revCredit'}>
                {featureCredit.onDark ? <img src={featureCredit.onDark} alt={featureCredit.title} loading="lazy" /> : featureCredit.title}
              </span>
            )}
          </div>
          <blockquote class="revQuote">{featureQuote}</blockquote>
        </article>
      )}
    </div>
  </section>

  <style is:global>
    /* Page-scoped patterns for /specialists. Prefixed `spec` so they cannot
       collide with anything shared; ready to be lifted into global.css if a
       second page ever needs them. */

    /* The hero and the dark band are dark in BOTH themes, so they pin the two
       tokens tuned for a cream page: light-theme --accent (#5d1f16) and
       --muted (#605d57) measure roughly 1.4:1 and 2.3:1 on #1a1a1c. Same
       "pin the value to the surface, not the theme" rule global.css applies
       to the always-dark reviews band. */
    .specHero, .specDark { --accent:#d4704f; --muted:#96928c; }
    .specDark { --sub:#c7c3bd; --ink:#f4f2ee; --hair:#3a3a3e; }

    .specHead { padding-bottom:18px; }

    /* on set: still on the left, a client's words on the right */
    /* the still and the quote are set to the same height, so the photo's top
       and bottom line up with the client's name and the last line of the quote
       rather than floating in the middle of it */
    /* minmax(0,…) so a wide photo can never push a column past its share */
    .specFeature { display:grid; grid-template-columns:minmax(0, 1fr) minmax(0, 1fr); gap:64px; align-items:stretch; }
    .specStill { margin:0; display:flex; min-width:0; }
    .specStillFrame { flex:1; min-width:0; min-height:clamp(300px, 26vw, 420px); overflow:hidden; background:#101012; }
    .specStillFrame img { width:100%; height:100%; object-fit:cover; object-position:center 45%; display:block; filter:saturate(0.92) contrast(1.05) brightness(0.96); }
    /* the band is dark like the homepage reviews and keeps its own top padding
       even when it follows another band */
    .specFeatureBand.band { padding-top:88px; }
    .specFeature .revCard { flex:none; }
    .specFeature .revCredit { animation:none; }

    /* photo hero: same recipe as the homepage banner (cover photo, dark
       scrim, copy pinned to the bottom-left) on top of the shared pageHero */
    .specHero { position:relative; overflow:hidden; min-height:var(--coverPhotoH); }
    .specHeroPhoto { position:absolute; inset:0; opacity:0; transition:opacity 1.8s ease; background-size:cover; background-repeat:no-repeat; filter:saturate(0.92) contrast(1.05) brightness(0.96); }
    .specHeroCreditText { display:inline-block; transition:opacity .6s ease; }
    .specHeroCreditText.fading { opacity:0; }
    @media (prefers-reduced-motion: reduce) { .specHeroPhoto, .specHeroCreditText { transition:none; } }
    .is-armed .specHeroPhoto { will-change:transform, opacity; }
    .specHeroScrim { position:absolute; inset:0; background:var(--heroScrim); }
    .specHero .pageHeroInner { position:relative; z-index:2; }
    /* the cover title breaks where the copy says, not where the window does */
    .specHero .pageHeroTitle { white-space:pre-line; }
    .specHeroCredit { position:absolute; right:40px; bottom:0; margin:0; text-align:right; color:var(--heroInkSoft); font-size:11px; letter-spacing:3px; line-height:1.5; }
    .specHeroCreditName { display:block; margin-top:4px; font-size:18px; letter-spacing:5px; font-weight:300; color:var(--heroInk); }

    /* everything else: intro left, disclosure rows right. One hairline per
       row and none around the columns, so the band stays quiet */
    .specAsk { display:grid; grid-template-columns:1fr 1.4fr; gap:72px; align-items:start; margin-top:34px; }
    .specAskIntro { max-width:44ch; }
    .specAskList { list-style:none; margin:0; padding:0; border-top:1px solid var(--hair); }
    .specAskItem { border-bottom:1px solid var(--hair); }
    .specAskName { display:flex; align-items:center; justify-content:space-between; gap:24px; padding:18px 0; cursor:pointer; list-style:none; font-size:17px; letter-spacing:2.5px; text-transform:uppercase; color:var(--ink); }
    .specAskName::-webkit-details-marker { display:none; }
    .specAskName:hover, .specAskRow[open] .specAskName { color:var(--accent); }
    .specAskName:focus-visible { outline:2px solid var(--accent); outline-offset:3px; }
    /* the mark is a plus drawn from two hairlines; it turns to a minus when open */
    .specAskMark { position:relative; flex:none; width:14px; height:14px; }
    .specAskMark::before, .specAskMark::after { content:""; position:absolute; left:0; top:50%; width:100%; height:1px; background:currentColor; transform:translateY(-50%); transition:transform 0.3s cubic-bezier(0.3, 0, 0.2, 1); }
    .specAskMark::after { transform:translateY(-50%) rotate(90deg); }
    .specAskRow[open] .specAskMark::after { transform:translateY(-50%) rotate(0deg); }
    .specAskBody { margin:0; padding:0 48px 22px 0; font-size:16px; font-weight:400; line-height:1.65; color:var(--sub); text-wrap:pretty; max-width:52ch; }
    @media (prefers-reduced-motion: reduce) { .specAskMark::before, .specAskMark::after { transition:none; } }

    @media (max-width:1024px) {
      /* stacked: nothing to line up with, so the still goes back to a
         cinematic crop rather than stretching to a column height */
      .specFeature { grid-template-columns:minmax(0, 1fr); gap:40px; }
      /* stacked: back to a plain block plate at a cinematic ratio — as a flex
         item it would shrink-wrap to the photo's own pixel width */
      .specStill { display:block; }
      .specStillFrame { min-height:0; aspect-ratio:16/9; }
      .specHeroCredit { right:32px; }
      .specAsk { grid-template-columns:1fr; gap:36px; }
    }

    @media (max-width:640px) {
      .specHeroCredit { position:static; text-align:left; margin-top:28px; }
      .specHeroCreditName { font-size:15px; letter-spacing:3px; }
      .specStillFrame { aspect-ratio:16/10; }
      /* on a phone the title wraps on its own; the forced break would orphan a word */
      .specHero .pageHeroTitle { white-space:normal; }
    }
  </style>

  <script is:inline>
    /* Cover stills rotate every five seconds, with the credit following. */
    (function () {
      var layers = Array.prototype.slice.call(document.querySelectorAll('.specHeroPhoto'));
      if (!layers.length) return;
      var credit = document.getElementById('specHeroCredit');
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
      var idx = 0;
      function show(i) {
        idx = i;
        for (var k = 0; k < layers.length; k++) {
          var on = k === i;
          layers[k].style.opacity = on ? '1' : '0';
          layers[k].setAttribute('aria-hidden', on ? 'false' : 'true');
        }
        if (!credit) return;
        var label = layers[i].getAttribute('data-label') || '';
        var name = layers[i].getAttribute('data-credit') || '';
        credit.classList.add('fading');
        window.setTimeout(function () {
          credit.textContent = '';
          credit.appendChild(document.createTextNode(label));
          credit.appendChild(document.createElement('br'));
          var strong = document.createElement('span');
          strong.className = 'specHeroCreditName';
          strong.textContent = name;
          credit.appendChild(strong);
          credit.classList.remove('fading');
        }, 600);
      }
      function loadRest() {
        for (var k = 0; k < layers.length; k++) {
          var src = layers[k].getAttribute('data-bg');
          if (src) { layers[k].style.backgroundImage = 'url("' + encodeURI(src) + '")'; layers[k].removeAttribute('data-bg'); }
        }
      }
      if (document.readyState === 'complete') loadRest();
      else window.addEventListener('load', loadRest);
      if (reduce.matches || layers.length < 2) return;
      window.setInterval(function () { show((idx + 1) % layers.length); }, 5000);
    })();
  </script>
</Base>

<script>
  import { armReveal } from '../lib/reveal';

  /* The shared pass (see reveal.ts), plus this page's own beats: the first
     cover still settles from a touch closer and every still drifts as the
     cover scrolls out, so the title reads as sitting in front of the picture. */
  const m = armReveal();
  if (m) {
    const layers = Array.from(document.querySelectorAll<HTMLElement>('.specHeroPhoto'));
    const hero = document.querySelector<HTMLElement>('.specHero');
    if (layers.length && hero) {
      m.animate(layers[0], { scale: [1.06, 1] }, { duration: 2.4, ease: [0.2, 0, 0.1, 1] });
      m.scroll(
        (progress: number) => {
          const y = `0 ${Math.round(progress * 100)}px`;
          layers.forEach((layer) => { layer.style.translate = y; });
        },
        { target: hero, offset: ['start start', 'end start'] },
      );
    }
  }
</script>
