---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import Base from '../layouts/Base.astro';
import { pageExists } from '../lib/pages';
import copy from '../content/pages/specialists.json';
import { getEntry } from 'astro:content';
import { featuredCredit } from '../lib/productionLogos';

/* the quote beside the on-set still is a normal review from the shared
   collection, so it carries a production logo exactly like the homepage cards */
const featureReview = await getEntry('reviews', copy.feature.review);
const featureCredit = featureReview ? featuredCredit(featureReview.data.credits, featureReview.data.feature) : null;
const featureQuote = featureReview?.body?.trim() ?? '';

/* Only link to a division once its page is actually in the build —
   the same guard artists.astro uses for its link through to this page.
 *
 * The `|| builtFromRoot` half is a local workaround, not a second opinion.
 * pageExists() resolves `../pages` from import.meta.url, which under
 * `astro build` is a bundled chunk in dist/.prerender/chunks/, so it answers
 * false for every route in a production build (the same resolution is used
 * inside Header.astro, which is why the overlay menu ships empty). Resolving
 * from the project root instead is correct in dev and in the build. Drop this
 * once src/lib/pages.ts is fixed. */
const builtFromRoot = (href: string) => {
  const slug = href.replace(/^\//, '').replace(/[#?].*$/, '');
  if (!slug) return false;
  const pages = join(process.cwd(), 'src', 'pages');
  return existsSync(join(pages, `${slug}.astro`)) || existsSync(join(pages, slug, 'index.astro'));
};

/* The divisions clients search for by name, each with a page of its own.
   A division only appears here once its page exists, so the hub can be
   extended a division at a time without ever showing a client a link to nothing. */
const divisions = copy.divisions.items.filter((item) => pageExists(item.href) || builtFromRoot(item.href));
---

<Base
  title={copy.meta.title}
  description={copy.meta.description}
  ogTitle={copy.meta.ogTitle}
  ogDescription={copy.meta.ogDescription}
  ogImage={copy.meta.ogImage}
  ogImageAlt={copy.meta.ogImageAlt}
  footerTitle={copy.meta.footerTitle}
  navOverDark={false}
>
  <!-- the page opens straight on the statement: one line that keeps changing,
       the divisions as a ruled list beside the copy, and the wider roster
       running past along the foot. No photo cover; the type is the cover -->
  <section class="band specialistsBand specOpener" aria-labelledby="specialistsTitle">
    <div class="bandInner">
      <p class="kicker" data-hero-line>{copy.statement.kicker}</p>
      <h1 class="stmt" id="specialistsTitle" aria-label={`${copy.statement.lead} ${copy.statement.words.join(', ')}, ${copy.statement.tail}`}>
        <span class="stmtLine" data-hero-line>{copy.statement.lead}</span>
        <span class="stmtLine" data-hero-line>
          <span class="stmtSlot" data-stmt-slot data-words={JSON.stringify(copy.statement.words)}>
            <span>{copy.statement.words[0]}</span>
          </span>
        </span>
        <span class="stmtLine" data-hero-line>{copy.statement.tail}</span>
      </h1>
      <div class="stmtFoot" data-reveal-group="0.08">
        <div>
          <p class="bandBody" data-reveal-item>{copy.statement.body}</p>
          <a class="btnSolid specialistsCta" href={copy.statement.cta.href} data-reveal-item>{copy.statement.cta.label.toUpperCase()}</a>
        </div>
        {
          divisions.length > 0 && (
            <ul class="divList" aria-label={copy.divisions.heading}>
              {divisions.map((item) => (
                <li data-reveal-item>
                  <a href={item.href}>{item.name}</a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </div>
    {
      copy.examples.items.length > 0 && (
        <div class="tape" data-reveal>
          <p class="tapeLabel bandInner">{copy.statement.tapeLabel}</p>
          {/* the readable list, once; the moving copies below are decoration */}
          <ul class="visuallyHidden">
            {copy.examples.items.map((item) => <li>{item.name}</li>)}
          </ul>
          <div class="tapeTrack" data-tape aria-hidden="true">
            {[0, 1, 2].map(() => copy.examples.items.map((item) => <span class="tapeItem">{item.name}</span>))}
          </div>
        </div>
      )
    }
  </section>

  <!-- on set: a production still beside a client's words -->
  <section class="band bandDark specDark specFeatureBand" aria-labelledby="featureTitle">
    <div class="bandInner specFeature" data-reveal-group="0.1">
      <figure class="specStill">
        <div class="specStillFrame" data-reveal-figure>
          <img src={copy.feature.still.image} alt={copy.feature.still.alt} loading="lazy" decoding="async" />
        </div>
      </figure>
      {featureReview && (
        <article class="specFeatureQuote revCard" data-reveal-item>
          <h3 class="revName" id="featureTitle">{featureReview.data.name}</h3>
          <p class="revRole">{featureReview.data.role}</p>
          <div class="revCredits">
            {featureCredit && (
              <span class={featureCredit.onDark ? 'revCredit revCreditLogo' : 'revCredit'}>
                {featureCredit.onDark ? <img src={featureCredit.onDark} alt={featureCredit.title} loading="lazy" /> : featureCredit.title}
              </span>
            )}
          </div>
          <blockquote class="revQuote">{featureQuote}</blockquote>
        </article>
      )}
    </div>
  </section>

  <style is:global>
    /* Page-scoped patterns for /specialists. Prefixed `spec` so they cannot
       collide with anything shared; ready to be lifted into global.css if a
       second page ever needs them. */

    /* The hero and the dark band are dark in BOTH themes, so they pin the two
       tokens tuned for a cream page: light-theme --accent (#5d1f16) and
       --muted (#605d57) measure roughly 1.4:1 and 2.3:1 on #1a1a1c. Same
       "pin the value to the surface, not the theme" rule global.css applies
       to the always-dark reviews band. */
    .specDark { --accent:#d4704f; --muted:#96928c; }
    .specDark { --sub:#c7c3bd; --ink:#f4f2ee; --hair:#3a3a3e; }

    .specHead { padding-bottom:18px; }

    /* on set: still on the left, a client's words on the right */
    /* the still and the quote are set to the same height, so the photo's top
       and bottom line up with the client's name and the last line of the quote
       rather than floating in the middle of it */
    /* minmax(0,…) so a wide photo can never push a column past its share */
    .specFeature { display:grid; grid-template-columns:minmax(0, 1fr) minmax(0, 1fr); gap:64px; align-items:stretch; }
    .specStill { margin:0; display:flex; min-width:0; }
    .specStillFrame { flex:1; min-width:0; min-height:clamp(300px, 26vw, 420px); overflow:hidden; background:#101012; }
    .specStillFrame img { width:100%; height:100%; object-fit:cover; object-position:center 45%; display:block; filter:saturate(0.92) contrast(1.05) brightness(0.96); }
    /* the band is dark like the homepage reviews and keeps its own top padding
       even when it follows another band */
    .specFeatureBand.band { padding-top:88px; }
    .specFeature .revCard { flex:none; }
    .specFeature .revCredit { animation:none; }


    /* everything else: intro left, disclosure rows right. One hairline per
       row and none around the columns, so the band stays quiet */

    @media (max-width:1024px) {
      /* stacked: nothing to line up with, so the still goes back to a
         cinematic crop rather than stretching to a column height */
      .specFeature { grid-template-columns:minmax(0, 1fr); gap:40px; }
      /* stacked: back to a plain block plate at a cinematic ratio — as a flex
         item it would shrink-wrap to the photo's own pixel width */
      .specStill { display:block; }
      .specStillFrame { min-height:0; aspect-ratio:16/9; }
    }

    @media (max-width:640px) {
      .specStillFrame { aspect-ratio:16/10; }
    }
  </style>

</Base>

<script>
  import { armReveal } from '../lib/reveal';

  /* The shared pass (see reveal.ts), plus this page's own beats: the
     changing word in the opening statement and the roster tape. */
  const m = armReveal();
  const EASE: [number, number, number, number] = [0.3, 0, 0.2, 1];

  /* The changing word. Each discipline rolls up into place, holds, then
     rolls out as the next arrives. Under reduced motion the words still
     take their turn, but simply swap. */
  const slot = document.querySelector<HTMLElement>('[data-stmt-slot]');
  if (slot) {
    const words: string[] = JSON.parse(slot.dataset.words || '[]');
    let i = 0;
    let cur = slot.firstElementChild as HTMLElement;
    const HOLD = 1.9;
    const next = () => {
      i = (i + 1) % words.length;
      const nx = document.createElement('span');
      nx.textContent = words[i];
      slot.appendChild(nx);
      if (!m) { cur.remove(); cur = nx; return; }
      const out = cur;
      m.animate(out, { transform: ['translateY(0)', 'translateY(-70%)'], opacity: [1, 0], filter: ['blur(0px)', 'blur(4px)'] }, { duration: 0.45, ease: EASE })
        .finished.then(() => out.remove());
      m.animate(nx, { transform: ['translateY(70%)', 'translateY(0)'], opacity: [0, 1], filter: ['blur(4px)', 'blur(0px)'] }, { duration: 0.55, delay: 0.08, ease: EASE });
      cur = nx;
    };
    if (words.length > 1) {
      let timer = window.setInterval(next, (HOLD + 0.6) * 1000);
      /* rests in a background tab so it never runs ahead unseen */
      document.addEventListener('visibilitychange', () => {
        window.clearInterval(timer);
        if (!document.hidden) timer = window.setInterval(next, (HOLD + 0.6) * 1000);
      });
    }
  }

  /* The tape: an endless line of the roster, slowly, nudged along by
     scrolling. Still under reduced motion, where it is a plain long line. */
  const tape = document.querySelector<HTMLElement>('[data-tape]');
  if (tape && m) {
    let x = 0;
    const speed = 0.6;
    let boost = 0;
    let last = window.scrollY;
    let running = false;
    const tick = () => {
      if (!running) return;
      const w = tape.scrollWidth / 3;
      x -= speed + boost;
      boost *= 0.92;
      if (-x >= w) x += w;
      tape.style.transform = `translateX(${x}px)`;
      requestAnimationFrame(tick);
    };
    m.scroll(() => { const d = Math.abs(window.scrollY - last); last = window.scrollY; boost = Math.min(boost + d * 0.08, 14); });
    /* only moves while it is on screen and the tab is visible */
    m.inView(tape, () => { running = true; tick(); return () => { running = false; }; });
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) running = false;
      else if (!running && tape.getBoundingClientRect().top < window.innerHeight) { running = true; tick(); }
    });
  }
</script>
