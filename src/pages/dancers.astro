---
import Base from '../layouts/Base.astro';
import copy from '../content/pages/dancers.json';

/* Hero photos. A slide's `wide` is the letterbox version of the shot, its
   backdrop extended sideways so the banner has nothing to trim; `image` is the
   upright original, used only for slides that have no wide version yet.

   One file per slide at every screen size, deliberately: serving a different
   frame of the same shoot to narrow windows made the photo appear to change
   as the window was resized. `wideFocus` is the hold point that keeps the
   performer in shot on whichever axis the banner has to crop — a narrow window
   crops the sides, a very wide one the top and bottom. The vertical hold is
   kept near the top (12%) on every slide, because the heads sit at the top
   of these stills and a wide, short window would otherwise crop them off. */
type HeroSlide = {
  image: string;
  /* production the still is from, shown bottom-right while the slide is up */
  production?: string;
  focus?: string;
  wide?: string;
  wideFocus?: string;
  /* hold point for windows narrower than NARROW_UNTIL, where the banner is
     close to square and the letterbox photo is cropped hard at the sides */
  narrowFocus?: string;
};
const heroSlides = copy.hero.slides as HeroSlide[];
/* the credits grid shows this many productions at once and turns through the rest */
const CREDITS_VISIBLE = 4;
const NARROW_UNTIL = 900;

const layerRule = (i: number, src: string | null, position?: string) =>
  `.heroLayer[data-hero="${i}"]{` +
  (src ? `background-image:url("${encodeURI(src)}");` : '') +
  (position ? `background-position:${position};` : '') +
  '}';

const narrowRules = heroSlides
  .map((slide, i) => (slide.narrowFocus ? layerRule(i, null, slide.narrowFocus) : ''))
  .filter(Boolean);

const heroCss = [
  ...heroSlides.map((slide, i) =>
    layerRule(
      i,
      slide.wide ?? slide.image,
      slide.wide ? slide.wideFocus ?? 'center center' : slide.focus,
    ),
  ),
  ...(narrowRules.length ? [`@media (max-width:${NARROW_UNTIL - 1}px){${narrowRules.join('')}}`] : []),
].join('\n');
---

<Base
  title={copy.meta.title}
  description={copy.meta.description}
  ogTitle={copy.meta.ogTitle}
  ogDescription={copy.meta.ogDescription}
  ogImage="/uploads/dancers-hero-02-wide.webp"
  footerTitle={copy.meta.footerTitle}
  footerLinks={copy.meta.footerLinks}
>

  <!-- full-bleed hero: one still per slide, cross-fading if there is more than
       one. Currently a single photo, so the rotator below stays idle. -->
  <style is:inline set:html={heroCss} />
  <header class="hero">
    {heroSlides.map((_slide, i) => <div class={i === 0 ? 'heroLayer on' : 'heroLayer'} data-hero={i} />)}
    <div class="heroScrim"></div>

    <div class="heroCopy">
      <div class="heroEyebrow">{copy.hero.eyebrow}</div>
      <h1 class="heroTitle">{copy.hero.title}</h1>
      <p class="heroLede">{copy.hero.lede}</p>
    </div>
    <!-- production credit for the slide on screen, in the home hero's
         "AS SEEN ON / production" recipe; the name swaps with the rotator -->
    <p class="heroCredit">
      {copy.hero.creditLabel}
      <span class="heroCreditNames" aria-live="polite">
        {heroSlides.map((slide, i) => (
          <span class={i === 0 ? 'heroCreditItem on' : 'heroCreditItem'} data-hero-credit={i}>{slide.production}</span>
        ))}
      </span>
    </p>
  </header>

  <!-- what we supply: index list + tall still that fades through the roster -->
  <section id="supply" class="supply" aria-labelledby="supplyHead">
    <div class="supplyCol">
      <h2 id="supplyHead" class="dispHead supplyHead" data-reveal>{copy.supply.heading}</h2>
      <!-- the genres arrive one after another as the list scrolls into view (reveal.ts) -->
      <div class="supplyList" id="genreList" data-reveal-group="0.07">
        {
          copy.supply.genres.map((genre, i) => (
            <div class="genre" data-reveal-item>
              {/* the name is split into letters so it can lift under the cursor like
                  the menu; the button carries the readable name itself */}
              <button class="genreBtn" type="button" aria-expanded="false" aria-controls={`genrePanel${i + 1}`} aria-label={genre.name} data-genre-btn>
                <span class="genreDash" aria-hidden="true"></span>
                <span class="genreName" aria-hidden="true">
                  {Array.from(genre.name).map((ch, ci) => (
                    <span class="genreCh" style={`--i:${ci}`}>{ch === ' ' ? ' ' : ch}</span>
                  ))}
                </span>
                <span class="genreMark" aria-hidden="true">+</span>
              </button>
              <div class="genrePanel" id={`genrePanel${i + 1}`}><div><div class="genreBlurb">{genre.blurb}</div></div></div>
            </div>
          ))
        }
      </div>
    </div>
    <div class="supplyStill">
      <!-- roster portraits, slowly cross-fading through the set; the first
           sits in the flow and sets the frame's size -->
      <div class="fadeStill" data-fade-still>
        {
          copy.supply.stills.map((still, i) => (
            <img
              src={still.image}
              alt={still.imageAlt}
              width={still.width}
              height={still.height}
              loading="lazy"
              decoding="async"
              class={i === 0 ? 'on' : undefined}
            />
          ))
        }
      </div>
      <div class="stillCaption">{copy.supply.imageCaption}</div>
    </div>
  </section>

  <!-- choreographer quotes -->
  <section id="quotes" class="quotes" aria-labelledby="quotesTitle" aria-roledescription="carousel">
    <div class="quotesInner">
      <div class="quotesHead">
        <h2 class="quotesTitle" id="quotesTitle">{copy.reviews.heading}</h2>
        <div class="quotesKicker">{copy.reviews.kicker}</div>
      </div>
      <div class="revViewport">
        <div class="revTrack" id="revTrack">
          {
            copy.reviews.items.map((item) => (
              <figure class="revItem" style="margin:0;">
                <div class="revName">{item.name}</div>
                <div class="revRole">{item.role}</div>
                <div class="revCredits">{item.credits}</div>
                <blockquote class="revQuote" style="margin:22px 0 0;">{item.quote}</blockquote>
              </figure>
            ))
          }
        </div>
      </div>
      <div class="revFoot">
        <div class="revCounter" id="revCounter" aria-live="polite">01 / 03</div>
        <div class="revDots" id="revDots"></div>
        <div class="revNav">
          <button class="revArrow" type="button" id="revPrev" aria-label={copy.reviews.previousLabel} aria-controls="revTrack">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M15 4l-8 8 8 8"></path></svg>
          </button>
          <button class="revArrow" type="button" id="revNext" aria-label={copy.reviews.nextLabel} aria-controls="revTrack">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M9 4l8 8-8 8"></path></svg>
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- supplied dancers for -->
  <section id="credits" class="credits" aria-labelledby="creditsHead">
    <div class="creditsInner">
      <div class="eyebrowAccent">{copy.credits.eyebrow}</div>
      <div class="creditsHead">
        <h2 id="creditsHead" class="dispHead" style="margin:0; max-width:none; font-size:clamp(26px,3vw,40px);">{copy.credits.heading}</h2>
        <div class="creditsNote">{copy.credits.note}</div>
      </div>
      <!-- four productions on screen; the grid turns through the rest, card
           by card along the diagonal, on its own clock or when a card is
           clicked (see the script at the foot of the page) -->
      <div class="creditsGrid" id="creditsGrid" aria-live="polite">
        {
          copy.credits.cards.slice(0, CREDITS_VISIBLE).map((card, i) => (
            <button type="button" class="creditCard" data-credit-slot={i} title={copy.credits.nextLabel}><div class="creditFrame"><img src={card.image} alt={card.alt} loading="lazy" decoding="async" /></div><div class="creditLabel">{card.label}</div></button>
          ))
        }
      </div>
      <script type="application/json" id="creditsPool" set:html={JSON.stringify(copy.credits.cards)} />
    </div>
  </section>

  <style is:global>
    *, *::before, *::after { box-sizing:border-box; }
    html, body { margin:0; background:var(--bg); font-family:'Jost',sans-serif; -webkit-font-smoothing:antialiased; }
    img { border-style:none; }

    :focus-visible { outline:2px solid var(--accent); outline-offset:3px; }
    .onDark :focus-visible, .heroBar :focus-visible, .revNav :focus-visible, .revDots :focus-visible { outline-color:#f4f2ee; }

    .wrap { max-width:1280px; margin:0 auto; }

    /* ---------- hero ---------- */
    /* display/padding/filter/width/max-width reset the homepage hero rules in global.css */
    .hero { position:relative; min-height:var(--coverPhotoH); background:#101012; overflow:hidden; display:block; padding:0; }
    /* background-position is the default hold point for a photo with no `focus`
       of its own; an inline focus from dancers.json overrides it */
    .heroLayer { position:absolute; inset:0; opacity:0; transition:opacity 1.8s ease; background-size:cover; background-position:center 12%; filter:none; }
    .heroLayer.on { opacity:1; }
    /* the top wash finishes high, at 16% rather than 30% of the banner, and is
       lighter to begin with: the banner photos put a face in the upper third,
       and a deep fade there dims it. The header carries its own gradient for
       the controls' contrast, so this one does not need to reach as far. */
    .heroScrim { position:absolute; inset:0; background:linear-gradient(180deg, rgba(20,20,22,0.42) 0%, rgba(20,20,22,0.15) 16%, rgba(20,20,22,0.15) 55%, rgba(20,20,22,0.8) 100%); }

    .heroCopy { position:absolute; left:40px; right:40px; bottom:64px; z-index:2; color:#f4f2ee; width:auto; max-width:none; }
    .heroEyebrow { font-size:12px; letter-spacing:6px; color:var(--accent); }
    .heroTitle { font-family:'Anton',sans-serif; font-size:clamp(48px, 6vw, 104px); letter-spacing:0; line-height:1.02; margin:18px 0 0; font-weight:400; }
    .heroLede { font-size:clamp(17px,1.6vw,22px); font-weight:400; letter-spacing:1px; margin-top:18px; max-width:640px; color:rgba(244,242,238,0.9); text-wrap:pretty; }
    /* production credit, bottom-right on the same inset as the copy, in the
       same type as the Specialists cover's .specHeroCredit: small label,
       production name a step larger beneath it. Each slide's name is stacked
       in one grid cell and cross-faded with its photo */
    .heroCredit { position:absolute; right:40px; bottom:64px; z-index:2; margin:0; text-align:right; color:rgba(244,242,238,0.75); font-size:11px; letter-spacing:3px; line-height:1.5; max-width:min(42vw, 520px); }
    .heroCreditNames { display:grid; margin-top:4px; }
    .heroCreditItem { grid-area:1/1; font-size:18px; letter-spacing:5px; font-weight:300; color:#f4f2ee; line-height:1.3; opacity:0; transition:opacity 1.8s ease; text-wrap:balance; }
    .heroCreditItem.on { opacity:1; }

    /* ---------- what we supply ---------- */
    .supply { max-width:1280px; margin:0 auto; padding:96px 40px; display:grid; grid-template-columns:1.25fr 1fr; gap:72px; align-items:stretch; }
    .supplyCol { display:flex; flex-direction:column; }
    .eyebrowAccent { font-size:11px; letter-spacing:3px; color:var(--accent); }
    .supplyHead { margin:0; max-width:none; }
    .supplyList { flex:1; display:flex; flex-direction:column; justify-content:center; margin-top:24px; }
    .genre { border-top:1px solid var(--hair); }
    .genre:last-child { border-bottom:1px solid var(--hair); }
    .genreBtn {
      width:100%; background:transparent; border:none; color:inherit; font:inherit; text-align:left;
      padding:14px 0; cursor:pointer; display:flex; align-items:baseline; gap:28px;
    }
    /* Hover borrows the menu's recipe (see .menuDash / .menuCh in global.css):
       a short accent dash draws in ahead of the word, the letters lift one
       after another into the accent, and the plus turns with them. The open
       genre holds the accent. */
    .genreDash { display:block; flex:none; align-self:center; width:0; height:2px; margin-right:0; background:var(--accent); opacity:0; transition:width 0.42s cubic-bezier(0.3, 0, 0.2, 1), margin-right 0.42s cubic-bezier(0.3, 0, 0.2, 1), opacity 0.42s cubic-bezier(0.3, 0, 0.2, 1); }
    .genreBtn:hover .genreDash, .genreBtn:focus-visible .genreDash, .genre.open .genreDash { width:14px; margin-right:12px; opacity:1; }
    .genreName { display:inline-flex; text-transform:uppercase; font-size:clamp(15px,1.25vw,18px); font-weight:300; letter-spacing:3px; flex:1; }
    .genreCh { display:inline-block; white-space:pre; will-change:transform; }
    .genre.open .genreCh, .genre.open .genreMark { color:var(--accent); }
    .genreMark { font-size:16px; font-weight:300; color:var(--muted); transition:color 0.34s cubic-bezier(0.3, 0, 0.2, 1), transform 0.42s cubic-bezier(0.3, 0, 0.2, 1); }
    .genre:not(.open) .genreBtn:hover .genreMark, .genre:not(.open) .genreBtn:focus-visible .genreMark { color:var(--accent); transform:rotate(90deg); }
    @media (prefers-reduced-motion: reduce) { .genreDash, .genreMark { transition:none; } }
    /* visibility (not just zero height) keeps a collapsed blurb out of the
       accessibility tree, matching the button's aria-expanded="false".
       It transitions alongside grid-template-rows: opening flips to visible
       immediately, closing holds visible until the row collapse finishes. */
    .genrePanel { display:grid; grid-template-rows:0fr; visibility:hidden; transition:grid-template-rows 0.35s ease, visibility 0.35s ease; }
    .genrePanel > div { overflow:hidden; }
    .genre.open .genrePanel { grid-template-rows:1fr; visibility:visible; }
    .genreBlurb { font-size:15px; font-weight:400; line-height:1.7; color:var(--sub); padding:14px 0 20px; max-width:520px; text-wrap:pretty; }
    .supplyStill { align-self:center; position:relative; }
    /* aspect-ratio matches the file's intrinsic 1366x2048, so the space is
       reserved before the image arrives and the page does not jump */
    .supplyStill img { width:100%; height:auto; display:block; aspect-ratio:1366 / 2048; object-fit:cover; }
    .stillCaption { position:absolute; left:20px; bottom:16px; font-size:11px; letter-spacing:3px; color:rgba(244,242,238,0.8); }
    /* a frame holding a set of stills that cross-fade on the hero's 1.8s ease:
       the first sits in the flow and sets the size, the rest are laid over
       it and cropped to the same box */
    .fadeStill { position:relative; overflow:hidden; }
    .fadeStill img { transition:opacity 1.8s ease; }
    .fadeStill img + img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; opacity:0; }
    .fadeStill img.on { opacity:1; }
    .fadeStill img:first-child:not(.on) { opacity:0; }


    .dispHead {
      font-family:'Anton','Jost',sans-serif; text-transform:uppercase; font-size:clamp(28px,3vw,44px);
      font-weight:400; letter-spacing:1px; line-height:1.15; margin:16px 0 0; max-width:520px;
    }


    /* ---------- reviews carousel ---------- */
    .quotes { background:#1a1a1c; color:#f4f2ee; border-top:1px solid var(--hair); border-bottom:1px solid var(--hair); }
    .quotesInner { max-width:1280px; width:100%; margin:0 auto; padding:56px 40px; }
    .quotesHead { display:flex; justify-content:space-between; align-items:baseline; border-bottom:1px solid #3a3a3e; padding-bottom:18px; }
    .quotesTitle { font-family:'Anton','Jost',sans-serif; text-transform:uppercase; font-size:clamp(26px,3vw,40px); font-weight:400; letter-spacing:0; margin:0; }
    /* the .quotes band is #1a1a1c in both themes — light-on-dark grey stays */
    .quotesKicker { font-size:12px; letter-spacing:3px; color:#96928c; }
    .revTrack {
      --per:3; --revgap:56px;
      display:flex; gap:var(--revgap);
      transform:translateX(0);
      transition:transform 0.65s cubic-bezier(0.3, 0, 0.2, 1);
    }
    .revItem { flex:0 0 calc((100% - (var(--per) - 1) * var(--revgap)) / var(--per)); min-width:0; }
    .revName { white-space:pre-line; font-family:'Anton','Jost',sans-serif; text-transform:uppercase; font-size:clamp(32px,3vw,48px); letter-spacing:0; line-height:1.02; margin:0; font-weight:400; }
    .revQuote { font-size:17px; font-weight:400; line-height:1.8; color:#c7c3bd; margin:22px 0 0; text-wrap:pretty; }
    /* also on the always-dark #1a1a1c band */
    .revCounter { font-size:13px; letter-spacing:3px; color:#96928c; }
    /* WCAG 2.2 target size: the button is a 24x24 hit area, the 7.5px padding
       plus background-clip:content-box keeps the painted dot at 9px.
       .revDots in global.css already has gap:0 so the row stays as tight. */
    .revDot { width:24px; height:24px; padding:7.5px; background-clip:content-box; border-radius:50%; cursor:pointer; background-color:rgba(244,242,238,0.3); border:none; }
    .revDot:hover { background-color:rgba(244,242,238,0.65); }
    .revArrow {
      width:44px; height:44px; border:1px solid rgba(244,242,238,0.4); border-radius:50%;
      display:flex; align-items:center; justify-content:center; cursor:pointer; color:#f4f2ee;
      background:transparent; padding:0;
    }
    .revArrow:hover, .revArrow:active { border-color:#f4f2ee; }

    /* ---------- credits ---------- */
    /* padding:0 resets the homepage .credits padding in global.css */
    .credits { border-top:1px solid var(--hair); padding:0; }
    .creditsInner { max-width:1280px; margin:0 auto; padding:88px 40px 96px; }
    .creditsHead { display:flex; justify-content:space-between; align-items:baseline; flex-wrap:wrap; gap:16px; margin-top:16px; }
    .creditsNote { font-size:14px; font-weight:400; color:var(--sub); letter-spacing:1px; }
    .creditsGrid { display:grid; grid-template-columns:repeat(2,1fr); gap:36px 24px; margin-top:44px; }
    /* each card is a button: clicking any of the four turns the grid to the next set */
    .creditCard { display:grid; gap:10px; width:100%; padding:0; border:none; background:transparent; color:inherit; font:inherit; text-align:left; cursor:pointer; }
    .creditCard:focus-visible { outline:2px solid var(--accent); outline-offset:4px; }
    .creditFrame { aspect-ratio:16/9; background:var(--tileBg); position:relative; overflow:hidden; }
    .creditFrame img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
    /* the same turn as the homepage logo wall: a card mid-turn lifts away
       upward, blurring as it fades, each waiting out its own --d both ways */
    .creditCard { transition:opacity 0.5s ease, transform 0.5s cubic-bezier(0.3, 0, 0.2, 1), filter 0.5s ease; transition-delay:var(--d, 0ms); }
    .creditCard.is-turning { opacity:0; transform:translateY(-14px); filter:blur(6px); }
    .creditLabel { font-size:12px; letter-spacing:2px; color:var(--sub); }

    /* ---------- responsive ---------- */
    @media (max-width:1024px) {
      /* below 1024px the lede and the credit would share a line and collide,
         so the credit gives up the corner and sits under the lede */
      .heroCopy { left:28px; right:28px; bottom:48px; padding-bottom:56px; }
      .heroCredit { left:28px; right:28px; bottom:48px; max-width:none; text-align:left; }
      .supply { padding:72px 28px; grid-template-columns:1fr; gap:48px; }
      /* one column here: hold the still to a sensible portrait width rather
         than letting it fill the page edge to edge */
      .supplyStill { max-width:520px; }
      .quotesInner { padding:48px 28px; }
      .revTrack { --per:2; --revgap:40px; }
      .creditsInner { padding:72px 28px; }
    }

    @media (max-width:640px) {
      .heroCopy { left:20px; right:20px; bottom:36px; padding-bottom:64px; }
      .heroCredit { left:20px; right:20px; bottom:36px; }
      .heroCreditItem { font-size:15px; letter-spacing:3px; }
      .heroEyebrow { letter-spacing:4px; }
      .heroTitle { font-size:clamp(40px, 13vw, 104px); letter-spacing:0; }
      .heroLede { font-size:clamp(16px, 4.4vw, 22px); }
      .supply { padding:56px 20px; gap:36px; }
      .genreBtn { gap:16px; }
      .genreName { font-size:clamp(14px, 4vw, 18px); letter-spacing:2px; }
      .dispHead { font-size:clamp(24px, 7.5vw, 44px); }
      .quotesInner { padding:40px 20px; }
      .quotesHead { flex-direction:column; align-items:flex-start; gap:8px; }
      .quotesTitle { font-size:clamp(24px, 8vw, 40px); }
      .revTrack { --per:1; --revgap:24px; }
      .revName { font-size:clamp(30px, 9vw, 48px); }
      .revFoot { flex-wrap:wrap; justify-content:center; row-gap:18px; column-gap:16px; }
      .revCounter { order:3; width:100%; text-align:center; }
      .creditsInner { padding:56px 20px 72px; }
      .creditsGrid { grid-template-columns:1fr; gap:28px; margin-top:32px; }
    }

    @media (prefers-reduced-motion: reduce) {
      * { transition-duration:0.01ms !important; animation-duration:0.01ms !important; animation-iteration-count:1 !important; }
      .revTrack { transition:none; }
      .heroLayer, .heroCreditItem, .creditCard, .fadeStill img { transition:none; }
    }
  </style>

  <script>
    import { inView, animate, stagger } from 'motion';
    import { armReveal } from '../lib/reveal';

    /* the shared scroll-reveal pass (reveal.ts): the What we supply heading
       rises in, then the genres arrive one after another */
    const m = armReveal();

    /* ---------- genre rows: the menu's hover, letter by letter ----------
       Under the cursor (or keyboard focus) each letter lifts in turn and takes
       the accent, 26ms apart like the menu; on leave they settle back in the
       same order. The open row keeps its accent. Nothing moves under reduced
       motion (armReveal returns null there), the colours simply swap. */
    const EASE: [number, number, number, number] = [0.3, 0, 0.2, 1];
    const accent = () => getComputedStyle(document.documentElement).getPropertyValue('--accent').trim();
    const ink = () => getComputedStyle(document.documentElement).getPropertyValue('--ink').trim();
    document.querySelectorAll<HTMLButtonElement>('[data-genre-btn]').forEach((btn) => {
      const chars = Array.from(btn.querySelectorAll<HTMLElement>('.genreCh'));
      const row = btn.closest('.genre');
      const lift = () => {
        if (!m) { chars.forEach((c) => { c.style.color = accent(); }); return; }
        animate(chars, { transform: 'translateY(-4px)', color: accent() }, { duration: 0.34, ease: EASE, delay: stagger(0.026) });
      };
      const settle = () => {
        const open = row?.classList.contains('open');
        if (!m) { chars.forEach((c) => { c.style.color = open ? accent() : ''; }); return; }
        animate(chars, { transform: 'translateY(0px)', color: open ? accent() : ink() }, { duration: 0.34, ease: EASE, delay: stagger(0.026) })
          .finished.then(() => { if (!open) chars.forEach((c) => { c.style.color = ''; }); });
      };
      btn.addEventListener('mouseenter', lift);
      btn.addEventListener('focus', lift);
      btn.addEventListener('mouseleave', settle);
      btn.addEventListener('blur', settle);
    });

    /* ---------- credits grid: diagonal turn ----------
       The same turn as the homepage logo wall (.logoCell / .is-turning in
       global.css): four productions are on screen; every few seconds each card
       lifts away upward, blurring as it fades, one after another down the
       diagonal; the artwork changes over while nothing is on show; then the
       cards settle back in on the same diagonal with the next four. --d is
       each card's wait in the diagonal, measured from where it sits so a
       one-column phone grid simply runs top to bottom. The turn only runs
       while the grid is in view and the tab is visible, and not at all under
       reduced motion. */
    type Card = { label: string; alt: string; image: string };
    const grid = document.getElementById('creditsGrid');
    const poolEl = document.getElementById('creditsPool');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (grid && poolEl) {
      const pool: Card[] = JSON.parse(poolEl.textContent || '[]');
      const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-credit-slot]'));
      const n = cards.length;
      if (pool.length > n) {
        const SPREAD = 480; /* ms for the diagonal to cross the grid */
        const LIFT = 560;   /* a card's own fade is 500ms; wait it out before swapping */
        const EVERY = 6200; /* how long a set holds before the next turn */
        let next = n;
        let timer: number | null = null;
        let turning = false;
        let pending: number[] = [];

        const preload = (src: string) => { const img = new Image(); img.src = src; };
        const upcoming = () => Array.from({ length: n }, (_, i) => pool[(next + i) % pool.length]);

        const stagger = () => {
          const width = grid.offsetWidth || 1;
          const height = grid.offsetHeight || 1;
          const reach = cards.map((c) => c.offsetLeft / width + c.offsetTop / height);
          const far = Math.max(...reach, 0);
          const scale = far > 0 ? SPREAD / far : 0;
          cards.forEach((c, i) => c.style.setProperty('--d', Math.round(reach[i] * scale) + 'ms'));
        };

        const dress = (card: HTMLElement, item: Card) => {
          const img = card.querySelector<HTMLImageElement>('img');
          const label = card.querySelector<HTMLElement>('.creditLabel');
          if (img) { img.src = item.image; img.alt = item.alt; }
          if (label) label.textContent = item.label;
        };

        const hide = (on: boolean) => cards.forEach((c) => c.classList.toggle('is-turning', on));

        const clearPending = () => { pending.forEach((t) => window.clearTimeout(t)); pending = []; };

        /* abandons a turn wherever it got to and puts every card back on show */
        const settle = () => { clearPending(); turning = false; hide(false); };

        const swap = () => {
          cards.forEach((c) => { dress(c, pool[next % pool.length]); next++; });
          upcoming().forEach((c) => preload(c.image));
        };

        const turn = () => {
          if (turning) return;
          if (reduce.matches) { swap(); return; }
          turning = true;
          stagger();
          hide(true);
          pending.push(window.setTimeout(() => {
            swap();
            hide(false);
            pending.push(window.setTimeout(() => { turning = false; }, SPREAD + LIFT));
          }, SPREAD + LIFT));
        };

        /* the clock only runs with motion: under reduced motion the grid
           holds still and turns only when a card is clicked */
        const start = () => { if (!reduce.matches && timer === null) timer = window.setInterval(turn, EVERY); };
        const stop = () => { if (timer !== null) { window.clearInterval(timer); timer = null; } settle(); };

        /* clicking any card turns the grid to the next four straight away,
           and the clock starts again from that moment */
        cards.forEach((c) => c.addEventListener('click', () => { stop(); turn(); start(); }));

        upcoming().forEach((c) => preload(c.image));
        inView(grid, () => { start(); return stop; }, { amount: 0.25 });
        document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
        window.addEventListener('pageshow', settle);
      }
    }
  </script>

  <script slot="scripts" is:inline>
    (function () {
      'use strict';
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

      /* ---------- hero cross-fade rotator ---------- */
      var layers = Array.prototype.slice.call(document.querySelectorAll('.heroLayer'));
      var creditLines = Array.prototype.slice.call(document.querySelectorAll('.heroCreditItem'));
      if (layers.length > 1 && !reduce.matches) {
        var hi = 0;
        var timer = null;
        function advance() {
          layers[hi].classList.remove('on');
          if (creditLines[hi]) creditLines[hi].classList.remove('on');
          hi = (hi + 1) % layers.length;
          layers[hi].classList.add('on');
          if (creditLines[hi]) creditLines[hi].classList.add('on');
        }
        function start() {
          if (timer) window.clearInterval(timer);
          timer = window.setInterval(advance, 5000);
        }
        start();

        /* The theme toggle runs a view transition, which freezes painting while
           it animates. A cross-fade caught mid-flight keeps advancing behind
           that freeze and snaps to its end state when painting resumes, which
           reads as a flicker on the photo. So on a theme change: settle the
           fade instantly, then restart the clock so the next one is a clean
           five seconds away and cannot overlap the transition. */
        document.addEventListener('t3:themechange', function () {
          layers.concat(creditLines).forEach(function (layer) {
            var wasOn = layer.classList.contains('on');
            layer.style.transition = 'none';
            layer.style.opacity = wasOn ? '1' : '0';
          });
          start();
          window.setTimeout(function () {
            layers.concat(creditLines).forEach(function (layer) {
              layer.style.removeProperty('transition');
              layer.style.removeProperty('opacity');
            });
          }, 1000);
        });
      }

      /* ---------- cross-fading stills ----------
         each [data-fade-still] frame turns slowly through its pictures,
         and only while it is on screen */
      if (!reduce.matches && 'IntersectionObserver' in window) {
        Array.prototype.slice.call(document.querySelectorAll('[data-fade-still]')).forEach(function (frame) {
          var pics = Array.prototype.slice.call(frame.querySelectorAll('img'));
          if (pics.length < 2) return;
          var at = 0, tick = null;
          function flip() {
            pics[at].classList.remove('on');
            at = (at + 1) % pics.length;
            pics[at].classList.add('on');
          }
          new IntersectionObserver(function (entries) {
            if (entries[0].isIntersecting) { if (tick === null) tick = window.setInterval(flip, 6000); }
            else if (tick !== null) { window.clearInterval(tick); tick = null; }
          }, { threshold: 0.2 }).observe(frame);
        });
      }

      /* ---------- genre accordion (single open) ---------- */
      var genres = Array.prototype.slice.call(document.querySelectorAll('#genreList .genre'));
      genres.forEach(function (g) {
        var btn = g.querySelector('.genreBtn');
        var mark = g.querySelector('.genreMark');
        btn.addEventListener('click', function () {
          var wasOpen = g.classList.contains('open');
          genres.forEach(function (other) {
            other.classList.remove('open');
            other.querySelector('.genreBtn').setAttribute('aria-expanded', 'false');
            other.querySelector('.genreMark').textContent = '+';
          });
          if (!wasOpen) {
            g.classList.add('open');
            btn.setAttribute('aria-expanded', 'true');
            mark.textContent = '−';
          }
        });
      });

      /* ---------- reviews carousel ---------- */
      var track = document.getElementById('revTrack');
      var items = track ? Array.prototype.slice.call(track.querySelectorAll('.revItem')) : [];
      var dotsWrap = document.getElementById('revDots');
      var counter = document.getElementById('revCounter');
      var prevBtn = document.getElementById('revPrev');
      var nextBtn = document.getElementById('revNext');
      var page = 0;

      function perPage() {
        var v = parseInt(getComputedStyle(track).getPropertyValue('--per'), 10);
        return (v && v > 0) ? v : 1;
      }
      function pageCount() {
        return Math.max(1, Math.ceil(items.length / perPage()));
      }
      function pad(n) { return String(n).length < 2 ? '0' + n : String(n); }

      function buildDots() {
        if (!dotsWrap) return;
        var n = pageCount();
        dotsWrap.innerHTML = '';
        for (var i = 0; i < n; i++) {
          var b = document.createElement('button');
          b.type = 'button';
          b.className = 'revDot';
          b.setAttribute('data-i', String(i));
          b.setAttribute('aria-label', 'Go to reviews slide ' + (i + 1) + ' of ' + n);
          dotsWrap.appendChild(b);
        }
      }

      function render() {
        var n = pageCount();
        if (page >= n) page = n - 1;
        if (page < 0) page = 0;
        var gap = getComputedStyle(track).columnGap;
        if (!gap || gap === 'normal') gap = '0px';
        track.style.transform = 'translateX(calc(-' + page + ' * (100% + ' + gap + ')))';
        if (counter) counter.textContent = pad(page + 1) + ' / ' + pad(n);
        if (dotsWrap) {
          Array.prototype.forEach.call(dotsWrap.children, function (d, i) {
            d.setAttribute('aria-current', i === page ? 'true' : 'false');
          });
        }
        var per = perPage();
        items.forEach(function (el, i) {
          var visible = i >= page * per && i < (page + 1) * per;
          el.setAttribute('aria-hidden', visible ? 'false' : 'true');
        });
      }

      if (track && items.length) {
        buildDots();
        render();
        if (dotsWrap) {
          dotsWrap.addEventListener('click', function (e) {
            var d = e.target.closest('.revDot');
            if (!d) return;
            page = Number(d.getAttribute('data-i'));
            render();
          });
        }
        if (prevBtn) prevBtn.addEventListener('click', function () { var n = pageCount(); page = (page - 1 + n) % n; render(); });
        if (nextBtn) nextBtn.addEventListener('click', function () { var n = pageCount(); page = (page + 1) % n; render(); });

        var lastPer = perPage();
        window.addEventListener('resize', function () {
          var p = perPage();
          if (p !== lastPer) { lastPer = p; page = 0; buildDots(); }
          render();
        });
      }
    })();
  </script>
</Base>
