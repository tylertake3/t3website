---
import Base from '../layouts/Base.astro';
---

<Base
  title="Dancers — Take 3 Agency"
  description="Trained dancers for film, television, commercial and live — every style, screen-ready. Take 3 Agency supplies contemporary, commercial, period, ballroom, street and ensemble dancers, from solo artists to full ensembles."
  ogTitle="Dancers — Take 3 Agency"
  ogDescription="Trained dancers for film, television, commercial and live — every style, screen-ready."
  ogImage="/uploads/Codex%20Image%2021%20Aug%202026,%2014_26_52-52b0f5dc.png"
  footerTitle="Book dancers for your production"
  footerLinks={[{"label": "SPACTS →", "href": "/spacts"}, {"label": "SPECIALISTS →", "href": "/stand-ins"}]}
>

  <!-- full-bleed hero: dancer stills fade -->
  <header class="hero">
    <div class="heroLayer on" style="background-image:url('/uploads/Codex%20Image%2021%20Aug%202026,%2014_26_52-52b0f5dc.png');"></div>
    <div class="heroLayer" style="background-image:url('/uploads/Codex%20Image%2021%20Aug%202026,%2014_20_03-91201516.png');"></div>
    <div class="heroLayer" style="background-image:url('/uploads/Codex%20Image%2021%20Aug%202026,%2014_24_58-1a219029.png');"></div>
    <div class="heroLayer" style="background-image:url('/uploads/Codex%20Image%2021%20Aug%202026,%2014_20_10-8028981e.png');"></div>
    <div class="heroLayer" style="background-image:url('/uploads/Codex%20Image%2021%20Aug%202026,%2014_33_18-06641d88.png');"></div>
    <div class="heroScrim"></div>

    <div class="heroCopy">
      <div class="heroEyebrow">TAKE 3 AGENCY · DANCE</div>
      <h1 class="heroTitle">DANCERS</h1>
      <p class="heroLede">Trained dancers for film, television, commercial and live — every style, screen-ready.</p>
    </div>
  </header>

  <!-- what we supply: index list + tall still -->
  <section id="supply" class="supply" aria-labelledby="supplyHead">
    <div class="supplyCol">
      <h2 id="supplyHead" class="eyebrowAccent" style="margin:0; font-weight:400;">WHAT WE SUPPLY</h2>
      <div class="supplyList" id="genreList">
        <div class="genre">
          <button class="genreBtn" type="button" aria-expanded="false" aria-controls="genrePanel1">
            <span class="genreNum">01</span>
            <span class="genreName">Contemporary</span>
            <span class="genreMark" aria-hidden="true">+</span>
          </button>
          <div class="genrePanel" id="genrePanel1"><div><div class="genreBlurb">Technically trained contemporary artists for narrative and abstract movement — floor work, partnering and release-based styles, comfortable improvising to direction on set.</div></div></div>
        </div>
        <div class="genre">
          <button class="genreBtn" type="button" aria-expanded="false" aria-controls="genrePanel2">
            <span class="genreNum">02</span>
            <span class="genreName">Commercial</span>
            <span class="genreMark" aria-hidden="true">+</span>
          </button>
          <div class="genrePanel" id="genrePanel2"><div><div class="genreBlurb">Sharp, camera-ready commercial dancers for promos, campaigns and live performance — fast with choreography and consistent take to take.</div></div></div>
        </div>
        <div class="genre">
          <button class="genreBtn" type="button" aria-expanded="false" aria-controls="genrePanel3">
            <span class="genreNum">03</span>
            <span class="genreName">Period &amp; historical</span>
            <span class="genreMark" aria-hidden="true">+</span>
          </button>
          <div class="genrePanel" id="genrePanel3"><div><div class="genreBlurb">Dancers drilled in court, regency, ragtime, swing and other era-specific social dance, styled and rehearsed to the production’s period.</div></div></div>
        </div>
        <div class="genre">
          <button class="genreBtn" type="button" aria-expanded="false" aria-controls="genrePanel4">
            <span class="genreNum">04</span>
            <span class="genreName">Ballroom</span>
            <span class="genreMark" aria-hidden="true">+</span>
          </button>
          <div class="genrePanel" id="genrePanel4"><div><div class="genreBlurb">Competition-level ballroom and Latin couples — waltz, foxtrot, tango, quickstep and more — able to perform full routines or background social dancing.</div></div></div>
        </div>
        <div class="genre">
          <button class="genreBtn" type="button" aria-expanded="false" aria-controls="genrePanel5">
            <span class="genreNum">05</span>
            <span class="genreName">Street</span>
            <span class="genreMark" aria-hidden="true">+</span>
          </button>
          <div class="genrePanel" id="genrePanel5"><div><div class="genreBlurb">Breakers, hip hop, popping, locking and krump artists from the UK battle scene, with the power moves and freestyle depth to hold a featured frame.</div></div></div>
        </div>
        <div class="genre">
          <button class="genreBtn" type="button" aria-expanded="false" aria-controls="genrePanel6">
            <span class="genreNum">06</span>
            <span class="genreName">Choreographed ensemble work</span>
            <span class="genreMark" aria-hidden="true">+</span>
          </button>
          <div class="genrePanel" id="genrePanel6"><div><div class="genreBlurb">Full ensembles cast to move as one — musical numbers, ceremonies and crowd choreography, matched for height, look and partnering experience.</div></div></div>
        </div>
      </div>
      <p class="supplyNote">Solo artists to full ensembles, matched to the brief — style, look, height and partnering experience.</p>
    </div>
    <div class="supplyStill">
      <img src="/uploads/3W8A3054.jpg" alt="Breaker in a one-arm freeze" loading="lazy" decoding="async" />
      <div class="stillCaption">TAKE 3 ROSTER · BREAKING</div>
    </div>
  </section>

  <!-- for film and television: still + rows -->
  <section class="bandDark" aria-labelledby="filmTvHead">
    <div class="split split--filmTv">
      <div class="splitStill">
        <img src="/uploads/DSC01767.jpg" alt="Dancer spinning in leather coat" loading="lazy" decoding="async" />
      </div>
      <div class="splitBody">
        <div class="eyebrowMuted">FOR FILM &amp; TELEVISION</div>
        <h2 id="filmTvHead" class="dispHead">Movement that holds the frame.</h2>
        <div class="rows rows--dark">
          <div class="row"><span class="rowLabel">PERIOD SEQUENCES</span><span>Court dances, balls and social dance, drilled to the era.</span></div>
          <div class="row"><span class="rowLabel">MUSICAL NUMBERS</span><span>Featured and ensemble dancers who take choreography fast.</span></div>
          <div class="row"><span class="rowLabel">BACKGROUND</span><span>Dancers in crowd who move with intent, not filler.</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- for commercial and brand: rows + still, mirrored -->
  <section class="split split--commercial" aria-labelledby="commercialHead">
    <div class="splitBody">
      <div class="eyebrowAccent">FOR COMMERCIAL &amp; BRAND</div>
      <h2 id="commercialHead" class="dispHead">From treatment to wrap.</h2>
      <div class="rows rows--light">
        <div class="row"><span class="rowLabel">CAMPAIGN FILMS</span><span>Real movement quality on camera, cast to the brief.</span></div>
        <div class="row"><span class="rowLabel">MUSIC PROMOS</span><span>Commercial, street and contemporary artists.</span></div>
        <div class="row"><span class="rowLabel">LIVE &amp; EVENTS</span><span>Activations from a single featured dancer to a cast.</span></div>
      </div>
    </div>
    <div class="splitStill">
      <img src="/uploads/DSC09954(1)-dc08728a.jpg" alt="Dancer in heels, hair in motion" loading="lazy" decoding="async" />
    </div>
  </section>

  <!-- working with choreographers -->
  <section id="choreographers" class="choreo" aria-labelledby="choreoHead">
    <div class="choreoGrid">
      <div>
        <div class="eyebrowAccent">WORKING WITH CHOREOGRAPHERS</div>
        <h2 id="choreoHead" class="dispHead">We supply the talent. You keep the room.</h2>
      </div>
      <div class="choreoBody">
        <p style="margin:0;">Send us the brief — style, numbers, dates and look — and we shortlist from the roster, hold availability and handle contracts, fees and on-the-day coordination. You audition and direct as you always would; we take the admin off your desk.</p>
        <p style="margin:18px 0 0;">Our commission comes from the artist’s fee, not from the client or the choreographer. Booking through Take 3 costs your production nothing extra.</p>
      </div>
    </div>
  </section>

  <!-- choreographer quotes -->
  <section id="quotes" class="quotes" aria-labelledby="quotesTitle" aria-roledescription="carousel">
    <div class="quotesInner">
      <div class="quotesHead">
        <h2 class="quotesTitle" id="quotesTitle">Reviews</h2>
        <div class="quotesKicker">WHAT CHOREOGRAPHERS SAY</div>
      </div>
      <div class="revViewport">
        <div class="revTrack" id="revTrack">
          <figure class="revItem" style="margin:0;">
            <div class="revName">Jason
Gilkinson</div>
            <div class="revRole">Creative Director &amp; Choreographer</div>
            <div class="revCredits">Strictly Come Dancing &amp; Burn The Floor</div>
            <blockquote class="revQuote" style="margin:22px 0 0;">Take 3 Agency have turned out to be the creative connection I have long been looking for. Tyler and Chanel understand instantly not only the type of talent I’m looking for but always connect me to artists who really enhance the creative process. This type of instinct doesn’t come along very often in our industry.</blockquote>
          </figure>
          <figure class="revItem" style="margin:0;">
            <div class="revName">James
Cousins</div>
            <div class="revRole">Choreographer</div>
            <div class="revCredits">James Cousins Company</div>
            <blockquote class="revQuote" style="margin:22px 0 0;">Working with Take3 makes the process of casting and hiring artists extremely smooth and efficient. Tyler and the team really understand what’s needed for my work and I was thrilled.</blockquote>
          </figure>
          <figure class="revItem" style="margin:0;">
            <div class="revName">Shelley
Maxwell</div>
            <div class="revRole">Movement Director &amp; Choreographer</div>
            <div class="revCredits"></div>
            <blockquote class="revQuote" style="margin:22px 0 0;">Every brief I’ve sent has come back with dancers who were right on the first look. The shortlists are considered, the admin is invisible and the artists arrive prepared.</blockquote>
          </figure>
          <figure class="revItem" style="margin:0;">
            <div class="revName">Adam
Murray</div>
            <div class="revRole">Choreographer</div>
            <div class="revCredits"></div>
            <blockquote class="revQuote" style="margin:22px 0 0;">On tight commercial turnarounds I need availability confirmed fast and no surprises on set. Take 3 deliver both, every time.</blockquote>
          </figure>
          <figure class="revItem" style="margin:0;">
            <div class="revName">Corey
Baker</div>
            <div class="revRole">Choreographer</div>
            <div class="revCredits">Corey Baker Dance</div>
            <blockquote class="revQuote" style="margin:22px 0 0;">They understand dancers as artists, not numbers. The people they’ve put in my rooms have lifted the work — that’s the only measure that matters.</blockquote>
          </figure>
          <figure class="revItem" style="margin:0;">
            <div class="revName">Sammy
Murray</div>
            <div class="revRole">Choreographer</div>
            <div class="revCredits"></div>
            <blockquote class="revQuote" style="margin:22px 0 0;">From first call to wrap, the communication is clear and the talent is exceptional. Take 3 have become my first call on every production.</blockquote>
          </figure>
          <figure class="revItem" style="margin:0;">
            <div class="revName">Nathan
Kim</div>
            <div class="revRole">Choreographer</div>
            <div class="revCredits"></div>
            <blockquote class="revQuote" style="margin:22px 0 0;">The roster runs deep — whatever style the job calls for, they have artists who can do it properly, and the process is effortless.</blockquote>
          </figure>
        </div>
      </div>
      <div class="revFoot">
        <div class="revCounter" id="revCounter" aria-live="polite">01 / 03</div>
        <div class="revDots" id="revDots"></div>
        <div class="revNav">
          <button class="revArrow" type="button" id="revPrev" aria-label="Previous reviews" aria-controls="revTrack">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M15 4l-8 8 8 8"></path></svg>
          </button>
          <button class="revArrow" type="button" id="revNext" aria-label="Next reviews" aria-controls="revTrack">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M9 4l8 8-8 8"></path></svg>
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- roster stills -->
  <section class="roster" aria-label="Take 3 roster still">
    <div class="rosterFrame"><img src="/uploads/3W8A9961.jpg" alt="Two dancers crouching in profile" loading="lazy" decoding="async" /></div>
  </section>

  <!-- supplied dancers for -->
  <section id="credits" class="credits" aria-labelledby="creditsHead">
    <div class="creditsInner">
      <div class="eyebrowAccent">CREDITS</div>
      <div class="creditsHead">
        <h2 id="creditsHead" class="dispHead" style="margin:0; max-width:none; font-size:clamp(26px,3vw,40px);">We have supplied dancers for</h2>
        <div class="creditsNote">Film · Television · Commercial · Music</div>
      </div>
      <div class="creditsGrid">
        <div class="creditCard"><div class="creditFrame"><img src="/uploads/upload_fba01478540cf4034ae0e81967110fe9_8190d99b-f0e0-4c79-b9ee-f47f42b6aeda.avif" alt="Spider-Man" loading="lazy" decoding="async" /></div><div class="creditLabel">SPIDER-MAN</div></div>
        <div class="creditCard"><div class="creditFrame"><img src="/uploads/witcher_season_3_conclave_ball.avif" alt="The Witcher" loading="lazy" decoding="async" /></div><div class="creditLabel">THE WITCHER</div></div>
        <div class="creditCard"><div class="creditFrame"><img src="/uploads/587814346_18330318445213259_7568090946314122385_n.jpg" alt="10 Dance" loading="lazy" decoding="async" /></div><div class="creditLabel">10 DANCE</div></div>
        <div class="creditCard"><div class="creditFrame"><img src="/uploads/10-dance-takeuchi-ryoma-new-ig-caption-in-the-blackpool-an-v0-s6hgudm85x8g1.jpg" alt="10 Dance — Blackpool" loading="lazy" decoding="async" /></div><div class="creditLabel">10 DANCE</div></div>
        <div class="creditCard"><div class="creditFrame"><img src="/uploads/planetdance1.png" alt="The Marvels" loading="lazy" decoding="async" /></div><div class="creditLabel">THE MARVELS</div></div>
        <div class="creditCard"><div class="creditFrame"><img src="/uploads/one-character-hangs-from-a-ladder-while-the-others-dance-in-the-tornado-wheel-in-wicked-s-dancing-through-life-musical-number.avif" alt="Wicked" loading="lazy" decoding="async" /></div><div class="creditLabel">WICKED</div></div>
        <div class="creditCard"><div class="creditFrame"><img src="/uploads/barbie-film-040623-1-bfbbf50d182642318a6285aef36e1552.jpg" alt="Barbie" loading="lazy" decoding="async" /></div><div class="creditLabel">BARBIE</div></div>
        <div class="creditCard"><div class="creditFrame"><img src="/uploads/The-Six-Triple-Eight-Soundtrack-Netflix-Every-Song-One.jpg" alt="The Six Triple Eight" loading="lazy" decoding="async" /></div><div class="creditLabel">THE SIX TRIPLE EIGHT</div></div>
      </div>
      <div class="creditsFoot">A SELECTION OF PRODUCTIONS SUPPLIED SINCE 2019</div>
    </div>
  </section>

  <style is:global>
    *, *::before, *::after { box-sizing:border-box; }
    html, body { margin:0; background:var(--bg); font-family:'Jost',sans-serif; -webkit-font-smoothing:antialiased; }
    img { border-style:none; }

    :focus-visible { outline:2px solid var(--accent); outline-offset:3px; }
    .onDark :focus-visible, .heroBar :focus-visible, .revNav :focus-visible, .revDots :focus-visible { outline-color:#f4f2ee; }

    .wrap { max-width:1280px; margin:0 auto; }

    /* ---------- hero ---------- */
    /* display/padding/filter/width/max-width reset the homepage hero rules in global.css */
    .hero { position:relative; min-height:78vh; background:#101012; overflow:hidden; display:block; padding:0; }
    .heroLayer { position:absolute; inset:0; opacity:0; transition:opacity 1.8s ease; background-size:cover; background-position:center; filter:none; }
    .heroLayer.on { opacity:1; }
    .heroScrim { position:absolute; inset:0; background:linear-gradient(180deg, rgba(20,20,22,0.6) 0%, rgba(20,20,22,0.15) 30%, rgba(20,20,22,0.15) 55%, rgba(20,20,22,0.8) 100%); }

    .heroCopy { position:absolute; left:40px; right:40px; bottom:64px; z-index:2; color:#f4f2ee; width:auto; max-width:none; }
    .heroEyebrow { font-size:12px; letter-spacing:6px; color:rgba(244,242,238,0.7); }
    .heroTitle { font-family:'Anton',sans-serif; font-size:clamp(48px, 6vw, 104px); letter-spacing:4px; line-height:1.02; margin:18px 0 0; font-weight:400; }
    .heroLede { font-size:clamp(17px,1.6vw,22px); font-weight:300; letter-spacing:1px; margin-top:18px; max-width:640px; color:rgba(244,242,238,0.9); text-wrap:pretty; }

    /* ---------- what we supply ---------- */
    .supply { max-width:1280px; margin:0 auto; padding:96px 40px; display:grid; grid-template-columns:1.25fr 1fr; gap:72px; align-items:stretch; }
    .supplyCol { display:flex; flex-direction:column; }
    .eyebrowAccent { font-size:11px; letter-spacing:3px; color:var(--accent); }
    .eyebrowMuted { font-size:11px; letter-spacing:3px; color:#96928c; }
    .supplyList { flex:1; display:flex; flex-direction:column; justify-content:center; margin-top:24px; border-bottom:1px solid var(--hair); }
    .genre { border-top:1px solid var(--hair); }
    .genreBtn {
      width:100%; background:transparent; border:none; color:inherit; font:inherit; text-align:left;
      padding:20px 0; cursor:pointer; display:flex; align-items:baseline; gap:28px;
    }
    .genreBtn:hover .genreName { color:#b8b4ae; }
    .genreNum { font-size:12px; letter-spacing:2px; color:#96928c; width:28px; flex:0 0 28px; }
    .genreName { text-transform:uppercase; font-size:clamp(18px,1.9vw,26px); font-weight:300; letter-spacing:3px; flex:1; }
    .genreMark { font-size:18px; font-weight:300; color:#96928c; }
    .genrePanel { display:grid; grid-template-rows:0fr; transition:grid-template-rows 0.35s ease; }
    .genrePanel > div { overflow:hidden; }
    .genre.open .genrePanel { grid-template-rows:1fr; }
    .genreBlurb { font-size:15px; font-weight:300; line-height:1.7; color:var(--sub); padding:14px 0 20px 56px; max-width:520px; text-wrap:pretty; }
    .supplyNote { font-size:14px; font-weight:300; color:#96928c; line-height:1.6; margin-top:28px; max-width:520px; text-wrap:pretty; }
    .supplyStill { align-self:center; position:relative; }
    .supplyStill img { width:100%; height:auto; display:block; }
    .stillCaption { position:absolute; left:20px; bottom:16px; font-size:11px; letter-spacing:3px; color:rgba(244,242,238,0.8); }

    /* ---------- split feature bands ---------- */
    .bandDark { border-top:1px solid var(--hair); border-bottom:1px solid var(--hair); background:#1a1a1c; color:#f4f2ee; }
    .split { max-width:1280px; margin:0 auto; padding:0 40px; display:grid; gap:72px; align-items:stretch; }
    .split--filmTv { grid-template-columns:1fr 1.3fr; }
    .split--commercial { grid-template-columns:1.3fr 1fr; }
    .splitStill { align-self:center; padding:56px 0; }
    .splitStill img { width:100%; height:auto; display:block; }
    .splitBody { padding:88px 0; }
    .dispHead {
      font-family:'Anton','Jost',sans-serif; text-transform:uppercase; font-size:clamp(28px,3vw,44px);
      font-weight:400; letter-spacing:1px; line-height:1.15; margin:16px 0 0; max-width:520px;
    }
    .rows { display:grid; row-gap:0; font-size:16px; font-weight:300; line-height:1.7; margin-top:36px; }
    .rows--dark { color:#c7c3bd; }
    .rows--light { color:var(--sub); }
    .row { padding:20px 0; display:grid; grid-template-columns:170px 1fr; gap:24px; }
    .rows--dark .row { border-top:1px solid #35353a; }
    .rows--dark .row:last-child { border-bottom:1px solid #35353a; }
    .rows--light .row { border-top:1px solid var(--hair); }
    .rows--light .row:last-child { border-bottom:1px solid var(--hair); }
    .rowLabel { font-size:12px; letter-spacing:2px; color:#96928c; padding-top:4px; }

    /* ---------- choreographers ---------- */
    .choreo { border-top:1px solid var(--hair); }
    .choreoGrid { max-width:1280px; margin:0 auto; padding:88px 40px; display:grid; grid-template-columns:1fr 1.4fr; gap:72px; align-items:start; }
    .choreoGrid .dispHead { max-width:none; }
    .choreoBody { font-size:17px; font-weight:300; line-height:1.75; color:var(--sub); text-wrap:pretty; }

    /* ---------- reviews carousel ---------- */
    .quotes { background:#1a1a1c; color:#f4f2ee; border-top:1px solid var(--hair); border-bottom:1px solid var(--hair); }
    .quotesInner { max-width:1280px; width:100%; margin:0 auto; padding:56px 40px; }
    .quotesHead { display:flex; justify-content:space-between; align-items:baseline; border-bottom:1px solid #3a3a3e; padding-bottom:18px; }
    .quotesTitle { font-family:'Anton','Jost',sans-serif; text-transform:uppercase; font-size:clamp(26px,3vw,40px); font-weight:400; letter-spacing:1px; margin:0; }
    .quotesKicker { font-size:12px; letter-spacing:3px; color:#96928c; }
    .revTrack {
      --per:3; --revgap:56px;
      display:flex; gap:var(--revgap);
      transform:translateX(0);
      transition:transform 0.65s cubic-bezier(0.3, 0, 0.2, 1);
    }
    .revItem { flex:0 0 calc((100% - (var(--per) - 1) * var(--revgap)) / var(--per)); min-width:0; }
    .revName { white-space:pre-line; font-family:'Bebas Neue','Jost',sans-serif; font-size:clamp(32px,3vw,48px); letter-spacing:2px; line-height:1.02; margin:0; font-weight:400; }
    .revQuote { font-size:17px; font-weight:300; line-height:1.8; color:#c7c3bd; margin:22px 0 0; text-wrap:pretty; }
    .revCounter { font-size:13px; letter-spacing:3px; color:#96928c; }
    .revDot { width:9px; height:9px; border-radius:50%; cursor:pointer; background:rgba(244,242,238,0.3); border:none; padding:0; }
    .revDot:hover { background:rgba(244,242,238,0.65); }
    .revArrow {
      width:44px; height:44px; border:1px solid rgba(244,242,238,0.4); border-radius:50%;
      display:flex; align-items:center; justify-content:center; cursor:pointer; color:#f4f2ee;
      background:transparent; padding:0;
    }
    .revArrow:hover, .revArrow:active { border-color:#f4f2ee; }

    /* ---------- roster still ---------- */
    .roster { max-width:1280px; margin:0 auto; padding:0 40px 96px; }
    .rosterFrame { position:relative; aspect-ratio:3/2; background:var(--tileBg); overflow:hidden; }
    .rosterFrame img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }

    /* ---------- credits ---------- */
    /* padding:0 resets the homepage .credits padding in global.css */
    .credits { border-top:1px solid var(--hair); padding:0; }
    .creditsInner { max-width:1280px; margin:0 auto; padding:88px 40px 96px; }
    .creditsHead { display:flex; justify-content:space-between; align-items:baseline; flex-wrap:wrap; gap:16px; margin-top:16px; }
    .creditsNote { font-size:14px; font-weight:300; color:var(--sub); letter-spacing:1px; }
    .creditsGrid { display:grid; grid-template-columns:repeat(2,1fr); gap:36px 24px; margin-top:44px; }
    .creditCard { display:grid; gap:10px; }
    .creditFrame { aspect-ratio:16/9; background:var(--tileBg); position:relative; overflow:hidden; }
    .creditFrame img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
    .creditLabel { font-size:12px; letter-spacing:2px; color:var(--sub); }
    .creditsFoot { font-size:12px; letter-spacing:2px; color:#96928c; margin-top:20px; }

    /* ---------- responsive ---------- */
    @media (max-width:1024px) {
      .heroCopy { left:28px; right:28px; bottom:48px; }
      .supply { padding:72px 28px; grid-template-columns:1fr; gap:48px; }
      .split { padding:0 28px; grid-template-columns:1fr !important; gap:0; }
      .splitStill { padding:48px 0 0; }
      .splitBody { padding:48px 0 64px; }
      .choreoGrid { padding:72px 28px; grid-template-columns:1fr; gap:32px; }
      .quotesInner { padding:48px 28px; }
      .revTrack { --per:2; --revgap:40px; }
      .roster { padding:0 28px 72px; }
      .creditsInner { padding:72px 28px; }
    }

    @media (max-width:640px) {
      .heroCopy { left:20px; right:20px; bottom:36px; }
      .heroEyebrow { letter-spacing:4px; }
      .heroTitle { font-size:clamp(40px, 13vw, 104px); letter-spacing:2px; }
      .heroLede { font-size:clamp(16px, 4.4vw, 22px); }
      .supply { padding:56px 20px; gap:36px; }
      .genreBtn { gap:16px; }
      .genreName { font-size:clamp(17px, 5vw, 26px); letter-spacing:2px; }
      .genreBlurb { padding-left:44px; }
      .split { padding:0 20px; }
      .row { grid-template-columns:1fr; gap:6px; }
      .dispHead { font-size:clamp(24px, 7.5vw, 44px); }
      .choreoGrid { padding:56px 20px; }
      .quotesInner { padding:40px 20px; }
      .quotesHead { flex-direction:column; align-items:flex-start; gap:8px; }
      .quotesTitle { font-size:clamp(24px, 8vw, 40px); }
      .revTrack { --per:1; --revgap:24px; }
      .revName { font-size:clamp(30px, 9vw, 48px); }
      .revFoot { flex-wrap:wrap; justify-content:center; row-gap:18px; column-gap:16px; }
      .revCounter { order:3; width:100%; text-align:center; }
      .roster { padding:0 20px 56px; }
      .creditsInner { padding:56px 20px 72px; }
      .creditsGrid { grid-template-columns:1fr; gap:28px; margin-top:32px; }
    }

    @media (prefers-reduced-motion: reduce) {
      * { transition-duration:0.01ms !important; animation-duration:0.01ms !important; animation-iteration-count:1 !important; }
      .revTrack { transition:none; }
      .heroLayer { transition:none; }
    }
  </style>

  <script slot="scripts" is:inline>
    (function () {
      'use strict';
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

      /* ---------- hero cross-fade rotator ---------- */
      var layers = Array.prototype.slice.call(document.querySelectorAll('.heroLayer'));
      if (layers.length > 1 && !reduce.matches) {
        var hi = 0;
        setInterval(function () {
          layers[hi].classList.remove('on');
          hi = (hi + 1) % layers.length;
          layers[hi].classList.add('on');
        }, 5000);
      }

      /* ---------- genre accordion (single open) ---------- */
      var genres = Array.prototype.slice.call(document.querySelectorAll('#genreList .genre'));
      genres.forEach(function (g) {
        var btn = g.querySelector('.genreBtn');
        var mark = g.querySelector('.genreMark');
        btn.addEventListener('click', function () {
          var wasOpen = g.classList.contains('open');
          genres.forEach(function (other) {
            other.classList.remove('open');
            other.querySelector('.genreBtn').setAttribute('aria-expanded', 'false');
            other.querySelector('.genreMark').textContent = '+';
          });
          if (!wasOpen) {
            g.classList.add('open');
            btn.setAttribute('aria-expanded', 'true');
            mark.textContent = '−';
          }
        });
      });

      /* ---------- reviews carousel ---------- */
      var track = document.getElementById('revTrack');
      var items = track ? Array.prototype.slice.call(track.querySelectorAll('.revItem')) : [];
      var dotsWrap = document.getElementById('revDots');
      var counter = document.getElementById('revCounter');
      var prevBtn = document.getElementById('revPrev');
      var nextBtn = document.getElementById('revNext');
      var page = 0;

      function perPage() {
        var v = parseInt(getComputedStyle(track).getPropertyValue('--per'), 10);
        return (v && v > 0) ? v : 1;
      }
      function pageCount() {
        return Math.max(1, Math.ceil(items.length / perPage()));
      }
      function pad(n) { return String(n).length < 2 ? '0' + n : String(n); }

      function buildDots() {
        if (!dotsWrap) return;
        var n = pageCount();
        dotsWrap.innerHTML = '';
        for (var i = 0; i < n; i++) {
          var b = document.createElement('button');
          b.type = 'button';
          b.className = 'revDot';
          b.setAttribute('data-i', String(i));
          b.setAttribute('aria-label', 'Go to reviews slide ' + (i + 1) + ' of ' + n);
          dotsWrap.appendChild(b);
        }
      }

      function render() {
        var n = pageCount();
        if (page >= n) page = n - 1;
        if (page < 0) page = 0;
        var gap = getComputedStyle(track).columnGap;
        if (!gap || gap === 'normal') gap = '0px';
        track.style.transform = 'translateX(calc(-' + page + ' * (100% + ' + gap + ')))';
        if (counter) counter.textContent = pad(page + 1) + ' / ' + pad(n);
        if (dotsWrap) {
          Array.prototype.forEach.call(dotsWrap.children, function (d, i) {
            d.setAttribute('aria-current', i === page ? 'true' : 'false');
          });
        }
        var per = perPage();
        items.forEach(function (el, i) {
          var visible = i >= page * per && i < (page + 1) * per;
          el.setAttribute('aria-hidden', visible ? 'false' : 'true');
        });
      }

      if (track && items.length) {
        buildDots();
        render();
        if (dotsWrap) {
          dotsWrap.addEventListener('click', function (e) {
            var d = e.target.closest('.revDot');
            if (!d) return;
            page = Number(d.getAttribute('data-i'));
            render();
          });
        }
        if (prevBtn) prevBtn.addEventListener('click', function () { var n = pageCount(); page = (page - 1 + n) % n; render(); });
        if (nextBtn) nextBtn.addEventListener('click', function () { var n = pageCount(); page = (page + 1) % n; render(); });

        var lastPer = perPage();
        window.addEventListener('resize', function () {
          var p = perPage();
          if (p !== lastPer) { lastPer = p; page = 0; buildDots(); }
          render();
        });
      }
    })();
  </script>
</Base>
