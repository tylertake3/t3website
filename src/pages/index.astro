---
import { existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { contactHref, site } from '../data/site';
import heroData from '../data/hero.json';
import categoryData from '../data/categories.json';
import clientData from '../data/clients.json';
import copy from '../content/pages/index.json';

/* `focus` is optional per slide: the point in the photo the wide banner holds
   on to when it trims the top and bottom away. Unset falls back to global.css. */
const heroSlides = heroData.slides as Array<{ title: string; alt: string; image: string; focus?: string }>;
const categories = categoryData.categories;
const clients = clientData.clients;

const reviews = (await getCollection('reviews')).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

/* the marquee needs the roster twice so it can loop seamlessly */
const marquee = [...categories, ...categories];

/* client logos cross-fade between two half-grids */
const half = Math.ceil(clients.length / 2);
const logoPages = [clients.slice(0, half), clients.slice(half)];

/* Client logo artwork hasn't all been supplied yet. A cell whose file is missing
   renders as an empty plate rather than firing a 404 for a picture that isn't there. */
const hasLogo = (cell: { dark?: string; light?: string }) =>
  Boolean(cell.dark) && existsSync(fileURLToPath(new URL('../../public' + cell.dark, import.meta.url)));

const posterCount = 15;

/* Organization schema — absolute URLs, sourced from src/data/site.ts */
const abs = (path: string) => new URL(path, Astro.site ?? Astro.url).toString();
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: abs('/'),
  logo: abs('/assets/take3-logo.svg'),
  image: abs('/uploads/the-odyssey-beach-horse.webp'),
  email: site.email,
  telephone: site.phoneHref,
  sameAs: [site.instagram],
  description: copy.meta.description,
};
---

<Base
  title={copy.meta.title}
  description={copy.meta.description}
  ogTitle={copy.meta.ogTitle}
  ogDescription={copy.meta.ogDescription}
  ogImage="/uploads/the-odyssey-beach-horse.webp"
>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(organizationSchema)} />

  <!-- full-bleed hero -->
  <section class="hero" id="hero" aria-label="Introduction">
    {
      /* only the first frame is fetched with the page — the rest are attached
         from `data-bg` once the page has loaded, so the hero costs one photo. */
      heroSlides.map((slide, i) => (
        <div
          class="heroLayer"
          data-title={slide.title}
          data-bg={i === 0 ? undefined : slide.image}
          role="img"
          aria-label={slide.alt}
          aria-hidden={i === 0 ? undefined : 'true'}
          style={`${i === 0 ? `background-image:url("${slide.image}"); opacity:1;` : 'opacity:0;'}${slide.focus ? ` background-position:${slide.focus};` : ''}`}
        />
      ))
    }
    <div class="heroScrim"></div>
    <div class="heroCopy">
      <p class="heroKicker">{copy.hero.kicker}</p>
      <h1 class="heroTitle">{copy.hero.title}</h1>
    </div>
    <p class="heroProd">{copy.hero.seenOnLabel}<span class="heroProdName" id="heroProd">{heroSlides[0]?.title}</span></p>
    <div class="heroStrip">
      <div>
        {
          copy.hero.strip.map((word, i) => (
            <>
              <span class={word.includes(' ') ? 'nw' : undefined}>{word}</span>
              {i < copy.hero.strip.length - 1 && <span class="sep">/</span>}
            </>
          ))
        }
      </div>
    </div>
  </section>

  <!-- who we are + what we supply -->
  <div class="aboutWrap">
    <section class="about" id="about" aria-labelledby="aboutTitle">
      {/* the kicker sits on its own grid row so the heading and the body copy
          below it start on exactly the same line */}
      <p class="kicker aboutKicker">{copy.about.kicker}</p>
      <h2 class="aboutTitle" id="aboutTitle">{copy.about.heading}</h2>
      <div class="aboutCol">
        <div class="aboutBody">
          <p>
            {copy.about.paragraph1.before}<a href="/what-is-a-spact">{copy.about.paragraph1.linkText}</a>{copy.about.paragraph1.after}
          </p>
          <p>
            {copy.about.paragraph2}
          </p>
        </div>
        <div class="stats">
          {
            copy.about.stats.map((stat) => (
              <div class="stat">
                {/* a figure made of words, like "UK & Europe", takes a smaller
                    size so it holds one line beside the numbers */}
                <div class={/\d/.test(stat.number) ? 'statNum' : 'statNum statNumText'} data-countup>
                  {stat.number}
                </div>
                <div class="statLabel">{stat.label}</div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- what we supply -->
    <section class="supply" id="supply" aria-labelledby="supplyTitle">
      <div class="sectionHead">
        <h2 class="sectionTitle" id="supplyTitle">{copy.supply.heading}</h2>
        <div class="supplyHeadMeta">
          <p class="kicker">{copy.supply.kicker}</p>
          <button
            class="marqueeToggle"
            id="supplyToggle"
            type="button"
            aria-pressed="false"
            aria-controls="supplyScroll"
            data-pause-label={copy.supply.pauseLabel}
            data-play-label={copy.supply.playLabel}
          >
            {copy.supply.pauseLabel}
          </button>
        </div>
      </div>
      <div class="supplyScroll" id="supplyScroll">
        {
          marquee.map((cat, i) => (
            <div class="supplyTile" aria-hidden={i >= categories.length ? 'true' : undefined}>
              {cat.image ? (
                <img class="supplyImg" src={cat.image} alt={cat.label} loading="lazy" decoding="async" />
              ) : (
                <div class="slot" style="aspect-ratio:3/4;">
                  <span class="slotLabel">{cat.label}</span>
                </div>
              )}
              <div class="supplyMeta">
                <h3 class="supplyName">{cat.name}</h3>
                <a
                  class="supplyView"
                  href={cat.href}
                  aria-label={`${copy.supply.viewLabel} ${cat.label}`}
                  tabindex={i >= categories.length ? -1 : undefined}
                >
                  {copy.supply.viewLabel} <span aria-hidden="true">&rarr;</span>
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </section>
  </div>

  <!-- reviews slider -->
  <section class="reviews" id="reviews" aria-labelledby="reviewsTitle">
    <div class="reviewsInner">
      <div class="reviewsHead">
        <h2 class="sectionTitle" id="reviewsTitle">{copy.reviews.heading}</h2>
        <p class="sub">{copy.reviews.kicker}</p>
      </div>
      <div class="revViewport" id="revViewport">
        <div class="revTrack" id="revTrack">
          {
            reviews.map((r) => (
              <article class="revCard">
                <h3 class="revName">{r.data.name}</h3>
                <p class="revRole">{r.data.role}</p>
                <p class="revCredits">{r.data.credits}</p>
                <blockquote class="revQuote">{r.body?.trim()}</blockquote>
              </article>
            ))
          }
        </div>
      </div>
      <div class="revFoot">
        <p class="revCount" id="revCount" aria-live="polite">1 / 6</p>
        <div class="revDots" id="revDots" role="group" aria-label="Review pages"></div>
        <div class="revNav">
          <button class="revBtn" id="revPrev" type="button" aria-label="Previous reviews">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
          </button>
          <button class="revBtn" id="revNext" type="button" aria-label="Next reviews">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- who we've supplied: client logos -->
  <section class="clients" id="clients" aria-labelledby="clientsTitle">
    <div class="sectionHead">
      <h2 class="sectionTitle" id="clientsTitle">{copy.clients.heading}</h2>
      <p class="kicker">{copy.clients.kicker}</p>
    </div>
    <p class="clientsBody">
      {copy.clients.body}
    </p>
    <div class="logoStack" id="logoStack">
      {
        logoPages.map((page, pi) => (
          <div
            class={pi === 0 ? 'logoPage is-on' : 'logoPage'}
            style={pi === 0 ? 'position:relative;' : 'position:absolute;'}
            aria-hidden="true"
          >
            {page.map((cell) => (
              <div
                class="logoCell"
                style={hasLogo(cell) ? `height:${cell.height}px; background-image:url("${cell.dark}");` : `height:${cell.height}px;`}
                data-light={hasLogo(cell) ? cell.light : undefined}
                data-dark={hasLogo(cell) ? cell.dark : undefined}
              />
            ))}
          </div>
        ))
      }
    </div>
  </section>

  <!-- our credits: poster grid -->
  <section class="credits" aria-labelledby="creditsTitle">
    <div class="sectionHead">
      <h2 class="sectionTitle" id="creditsTitle">{copy.credits.heading}</h2>
      <div class="creditsCount">
        <div class="creditsCountNum">{copy.credits.countNumber}</div>
        <div class="creditsCountLabel">{copy.credits.countLabel}</div>
      </div>
    </div>
    <div class="posterGrid">
      {
        Array.from({ length: posterCount }).map(() => (
          <div class="slot posterSlot" style="aspect-ratio:2/3;">
            <span class="slotLabel">{copy.credits.posterPlaceholder}</span>
          </div>
        ))
      }
    </div>
  </section>

  <style is:global>
    .supplyImg { width:100%; aspect-ratio:3/4; object-fit:cover; display:block; }
    .supplyHeadMeta { display:flex; align-items:baseline; gap:18px; }
    .marqueeToggle {
      font-family:inherit; font-size:12px; letter-spacing:2px; text-transform:uppercase;
      color:var(--muted); background:none; border:0; border-bottom:1px solid var(--hair);
      padding:0 0 3px; cursor:pointer;
      /* Out of the resting composition, but still there: moving content that
         starts on its own needs a way to stop it (WCAG 2.2.2). It appears on
         hover and whenever it takes keyboard focus. */
      opacity:0; transition:opacity .2s ease;
    }
    .supply:hover .marqueeToggle,
    .supply:focus-within .marqueeToggle,
    .marqueeToggle:focus-visible { opacity:1; }
    .marqueeToggle:hover { color:var(--ink); border-bottom-color:var(--ink); }
    @media (prefers-reduced-motion: reduce) { .marqueeToggle { transition:none; } }
    .marqueeToggle[hidden] { display:none; }
  </style>

  <script slot="scripts" is:inline>
    (function () {
      'use strict';
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
      var lessMotion = function () { return reduce.matches; };

      /* ---------------- hero cross-fade rotator ---------------- */
      var layers = Array.prototype.slice.call(document.querySelectorAll('.heroLayer'));
      var heroProd = document.getElementById('heroProd');
      var heroIdx = 0, heroTimer = null;
      function heroShow(i) {
        heroIdx = i;
        for (var k = 0; k < layers.length; k++) {
          var on = k === i;
          layers[k].style.opacity = on ? '1' : '0';
          /* opacity alone leaves the layer in the accessibility tree, so a
             screen reader would announce all seven slides at once */
          layers[k].setAttribute('aria-hidden', on ? 'false' : 'true');
        }
        if (heroProd) heroProd.textContent = layers[i].getAttribute('data-title');
      }
      /* the frames after the first are only fetched once the page has loaded */
      function heroLoadRest() {
        for (var k = 0; k < layers.length; k++) {
          var src = layers[k].getAttribute('data-bg');
          if (src) {
            layers[k].style.backgroundImage = 'url("' + src + '")';
            layers[k].removeAttribute('data-bg');
          }
        }
      }
      function heroQueueRest() {
        if (window.requestIdleCallback) window.requestIdleCallback(heroLoadRest, { timeout: 2000 });
        else window.setTimeout(heroLoadRest, 200);
      }
      if (document.readyState === 'complete') heroQueueRest();
      else window.addEventListener('load', heroQueueRest);
      function heroStart() {
        clearInterval(heroTimer);
        if (lessMotion() || layers.length < 2) return;
        heroTimer = setInterval(function () { heroShow((heroIdx + 1) % layers.length); }, 5000);
      }
      heroShow(0);
      heroStart();
      /* the theme swap repaints the hero, so restart the rotation with it */
      document.addEventListener('t3:themechange', function () { heroShow(0); heroStart(); });

      /* ---------------- supply marquee: auto-scroll + drag ---------------- */
      (function () {
        var el = document.getElementById('supplyScroll');
        if (!el) return;
        var dragging = false, hover = false, focused = false, paused = false, moved = false;
        var startX = 0, startScroll = 0, raf = null;
        el.addEventListener('mouseenter', function () { hover = true; });
        el.addEventListener('mouseleave', function () { hover = false; });
        /* keyboard users tabbing through the tiles get the same reprieve as the cursor */
        el.addEventListener('focusin', function () { focused = true; });
        el.addEventListener('focusout', function () { focused = false; });
        el.addEventListener('pointerdown', function (e) {
          dragging = true; moved = false; startX = e.clientX; startScroll = el.scrollLeft;
        });
        window.addEventListener('pointermove', function (e) {
          if (!dragging) return;
          var dx = e.clientX - startX;
          if (Math.abs(dx) > 6) {
            moved = true;
            var half = el.scrollWidth / 2;
            var target = startScroll - dx;
            if (half > el.clientWidth) {
              if (target < 0) { target += half; startX = e.clientX; startScroll = target; }
              else if (target > half) { target -= half; startX = e.clientX; startScroll = target; }
            }
            el.scrollLeft = target;
          }
        }, { passive: true });
        window.addEventListener('pointerup', function () { dragging = false; });
        window.addEventListener('pointercancel', function () { dragging = false; });
        /* suppress the click that ends a drag */
        el.addEventListener('click', function (e) {
          if (moved) { e.stopPropagation(); e.preventDefault(); moved = false; }
        }, true);
        var drift = 0;
        function step() {
          if (!paused && !hover && !focused && !dragging && el.scrollWidth > el.clientWidth) {
            /* browsers round sub-pixel scrollLeft back to 0, so bank the fraction */
            drift += 0.4;
            if (drift >= 1) { el.scrollLeft += Math.floor(drift); drift -= Math.floor(drift); }
          }
          var half = el.scrollWidth / 2;
          if (half > el.clientWidth && el.scrollLeft >= half) el.scrollLeft -= half;
          raf = window.requestAnimationFrame(step);
        }
        function startAuto() { if (!lessMotion() && raf === null) raf = window.requestAnimationFrame(step); }
        function stopAuto() { if (raf !== null) { window.cancelAnimationFrame(raf); raf = null; } }
        startAuto();

        /* WCAG 2.2.2 — the scroll must be stoppable. Reduced motion already
           stops it, so the control hides itself in that state. */
        var toggle = document.getElementById('supplyToggle');
        function paintToggle() {
          if (!toggle) return;
          toggle.hidden = lessMotion();
          toggle.setAttribute('aria-pressed', paused ? 'true' : 'false');
          toggle.textContent = toggle.getAttribute(paused ? 'data-play-label' : 'data-pause-label') || '';
        }
        if (toggle) {
          toggle.addEventListener('click', function () { paused = !paused; paintToggle(); });
          paintToggle();
        }

        if (reduce.addEventListener) reduce.addEventListener('change', function () { stopAuto(); startAuto(); paintToggle(); });
        window.addEventListener('pagehide', stopAuto);
      })();

      /* ---------------- reviews carousel ---------------- */
      (function () {
        var viewport = document.getElementById('revViewport');
        var track = document.getElementById('revTrack');
        var dotsWrap = document.getElementById('revDots');
        var countEl = document.getElementById('revCount');
        if (!viewport || !track || !dotsWrap || !countEl) return;
        var cards = Array.prototype.slice.call(track.children);
        var page = 0, perPage = 3, pages = 1;

        function measure() {
          var w = window.innerWidth;
          perPage = w <= 640 ? 1 : (w <= 1024 ? 2 : 3);
          pages = Math.ceil(cards.length / perPage);
          if (page > pages - 1) page = pages - 1;
        }
        function buildDots() {
          dotsWrap.innerHTML = '';
          for (var i = 0; i < pages; i++) {
            var b = document.createElement('button');
            b.type = 'button';
            b.className = 'revDot';
            b.setAttribute('data-i', String(i));
            b.setAttribute('aria-label', 'Go to review page ' + (i + 1));
            dotsWrap.appendChild(b);
          }
        }
        function paint() {
          var gap = parseFloat(window.getComputedStyle(track).columnGap) || 0;
          var offset = page * (viewport.clientWidth + gap);
          track.style.transform = 'translateX(-' + offset + 'px)';
          countEl.textContent = (page + 1) + ' / ' + pages;
          var dots = dotsWrap.children;
          for (var i = 0; i < dots.length; i++) {
            dots[i].setAttribute('aria-current', i === page ? 'true' : 'false');
          }
          for (var j = 0; j < cards.length; j++) {
            var visible = j >= page * perPage && j < (page + 1) * perPage;
            cards[j].setAttribute('aria-hidden', visible ? 'false' : 'true');
          }
        }
        function go(i) { page = ((i % pages) + pages) % pages; paint(); }

        dotsWrap.addEventListener('click', function (e) {
          var b = e.target.closest('.revDot');
          if (b) go(parseInt(b.getAttribute('data-i'), 10) || 0);
        });
        document.getElementById('revPrev').addEventListener('click', function () { go(page - 1); });
        document.getElementById('revNext').addEventListener('click', function () { go(page + 1); });

        var rz = null;
        window.addEventListener('resize', function () {
          window.clearTimeout(rz);
          rz = window.setTimeout(function () {
            var before = perPage;
            measure();
            if (before !== perPage) buildDots();
            paint();
          }, 120);
        });

        measure(); buildDots(); paint();
      })();

      /* ---------------- client logo half cross-fade (8s) ---------------- */
      (function () {
        var pagesEls = Array.prototype.slice.call(document.querySelectorAll('.logoPage'));
        if (pagesEls.length < 2) return;
        var i = 0, t = null;
        function start() {
          window.clearInterval(t);
          if (lessMotion()) return;
          t = window.setInterval(function () {
            i = (i + 1) % pagesEls.length;
            for (var k = 0; k < pagesEls.length; k++) pagesEls[k].classList.toggle('is-on', k === i);
          }, 8000);
        }
        start();
        if (reduce.addEventListener) reduce.addEventListener('change', start);
        window.addEventListener('pagehide', function () { window.clearInterval(t); });
      })();

      window.addEventListener('pagehide', function () { clearInterval(heroTimer); });
    })();
  </script>
</Base>
