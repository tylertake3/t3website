---
import map from '../data/world-map.json';

interface Props {
  kicker: string;
  heading: string;
  body?: string;
  countLabel: string;
}
const { kicker, heading, body, countLabel } = Astro.props;

const places = map.points;

/* The markers arrive west to east, so the world fills in as a sweep rather
   than 26 dots appearing at once. Order is for the animation only; the list
   beside the map keeps its own reading order. */
const arrival = new Map(
  [...places]
    .map((place, index) => ({ place, index }))
    .sort((a, b) => a.place.x - b.place.x)
    .map(({ index }, order) => [index, order])
);
---

<section class="band whereBand" aria-labelledby="whereTitle">
  <div class="bandInner">
    <div class="sectionHead">
      <h2 class="sectionTitle" id="whereTitle">{heading}</h2>
      <p class="kicker">{kicker}</p>
    </div>

    <div class="whereGrid">
      <div class="whereMapWrap">
        <svg
          class="whereMap"
          id="whereMap"
          {/* cropped to the region worked in; land outside is clipped by the frame */}
          viewBox={`${map.view.x} ${map.view.y} ${map.view.width} ${map.view.height}`}
          role="img"
          aria-label={`World map with ${map.countryCount} countries highlighted, listed in full beside it.`}
        >
          <defs>
            {/* the crop has to end somewhere, so the land fades out at the
                left and right edges rather than stopping at a hard line */}
            <linearGradient id="whereFadeGrad" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color="#000" />
              <stop offset="0.06" stop-color="#fff" />
              <stop offset="0.94" stop-color="#fff" />
              <stop offset="1" stop-color="#000" />
            </linearGradient>
            <mask id="whereFade" maskUnits="userSpaceOnUse" x={map.view.x} y={map.view.y} width={map.view.width} height={map.view.height}>
              <rect x={map.view.x} y={map.view.y} width={map.view.width} height={map.view.height} fill="url(#whereFadeGrad)" />
            </mask>
          </defs>
          <g mask="url(#whereFade)">
            <path class="whereLand" d={map.land} />
            {
              map.shapes.map((shape) => (
                <path class="whereCountry" d={shape.d} data-country={shape.id} />
              ))
            }
          </g>
          {
            places.map((place, i) => (
              <g
                class="wherePin"
                data-place={place.name}
                data-country={place.country}
                style={`--pin-delay:${(arrival.get(i) ?? 0) * 45}ms`}
              >
                <circle class="wherePinHalo" cx={place.x} cy={place.y} r="9" />
                <circle class="wherePinDot" cx={place.x} cy={place.y} r="3" />
              </g>
            ))
          }
        </svg>
        <p class="whereReadout" id="whereReadout" aria-live="polite"></p>
      </div>

      <div class="whereAside">
        {body && <p class="bandBody whereBody">{body}</p>}
        <p class="whereCount">
          <span class="whereCountNum" data-countup>{map.countryCount}</span>
          <span class="whereCountLabel">{countLabel}</span>
        </p>
        <ul class="whereList" id="whereList">
          {
            places.map((place) => (
              <li>
                <button
                  class="whereItem"
                  type="button"
                  data-place={place.name}
                  data-country={place.country}
                  aria-pressed="false"
                >
                  {place.name}
                </button>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<script>
  /* Hovering or focusing a place lights it on the map, and the reverse.
     The list is the real content: everything works without the map, and the
     map is labelled as a picture so a screen reader is not walked through
     177 outlines. */
  const section = document.getElementById('whereMap')?.closest('.whereBand');
  if (section) {
    /* The markers only hide themselves once we know we can bring them back:
       with no JavaScript, or no observer, they are simply there. */
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    if ('IntersectionObserver' in window && !reduce.matches) {
      section.classList.add('is-armed');
      const watcher = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            section.classList.add('is-inview');
            watcher.disconnect();
          });
        },
        { threshold: 0.25 }
      );
      watcher.observe(section);
    }

    const readout = section.querySelector<HTMLElement>('#whereReadout');
    const items = Array.from(section.querySelectorAll<HTMLElement>('.whereItem'));
    const pins = Array.from(section.querySelectorAll<HTMLElement>('.wherePin'));
    const countries = Array.from(section.querySelectorAll<HTMLElement>('.whereCountry'));

    const setActive = (place: string | null) => {
      const country = place
        ? (items.find((i) => i.dataset.place === place)?.dataset.country ?? null)
        : null;

      items.forEach((el) => {
        const on = el.dataset.place === place;
        el.classList.toggle('is-active', on);
        el.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      pins.forEach((el) => el.classList.toggle('is-active', el.dataset.place === place));
      countries.forEach((el) => el.classList.toggle('is-active', !!country && el.dataset.country === country));
      if (readout) readout.textContent = place ?? '';
    };

    items.forEach((item) => {
      const place = item.dataset.place ?? null;
      item.addEventListener('mouseenter', () => setActive(place));
      item.addEventListener('focus', () => setActive(place));
      item.addEventListener('click', () => setActive(place));
      item.addEventListener('mouseleave', () => setActive(null));
      item.addEventListener('blur', () => setActive(null));
    });

    pins.forEach((pin) => {
      const place = pin.dataset.place ?? null;
      pin.addEventListener('mouseenter', () => setActive(place));
      pin.addEventListener('mouseleave', () => setActive(null));
    });
  }
</script>
