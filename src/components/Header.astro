---
import { navLinks, performerLink, site, contactHref } from '../data/site';
import { pageExists } from '../lib/pages';
import Timecode from './Timecode.astro';

interface Props {
  /** false when there is no dark hero photo behind the header. */
  overDark?: boolean;
}
const { overDark = true } = Astro.props;

const currentPath = Astro.url.pathname.replace(/index\.html$/, '/').replace(/\.html$/, '') || '/';
const isCurrent = (href: string) => href === currentPath;

/* The menu is defined ahead of the build-out, so only show entries whose page
   actually exists. Each new page appears in the menu the moment it lands. */
const exists = pageExists;

/* Menu labels animate letter by letter, so each character needs its own box.
   The split copy is hidden from assistive tech — the link carries an aria-label. */
const chars = (label: string) => Array.from(label);

const menuItems = navLinks
  .filter((item) => exists(item.href) || item.children?.some((c) => exists(c.href)))
  .map((item) => {
    const children = item.children?.filter((c) => exists(c.href)) ?? [];
    /* The group heading toggles its list open rather than navigating, so the
       parent page would otherwise be unreachable from the menu. Put it back
       as the first entry in the list it heads. */
    const withOverview =
      children.length > 0 && exists(item.href)
        ? [{ label: `All ${item.label.toLowerCase()}`, href: item.href }, ...children]
        : children;
    return { ...item, children: withOverview };
  });
const showPerformerLink = exists(performerLink.href);

/* Sub-lists start closed, except the one holding the page you are on — so
   arriving on /models from search, the menu shows you where you are. */
const groupId = (label: string) => `menuGroup-${label.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
const isOpenGroup = (item: (typeof menuItems)[number]) =>
  isCurrent(item.href) || item.children.some((c) => isCurrent(c.href));
---

<header class={overDark ? 'nav' : 'nav navOnLight'} id="siteNav">
  <div class="navLeft">
    <a class="navLogoLink" href="/" aria-label={`${site.name} — home`}>
      <img class="navLogo" id="navLogo" src="/assets/take3-logo.svg" alt={site.name} width="220" height="110" />
    </a>
  </div>

  <div class="navRight">
    <Timecode />

    <button class="themeBtn" id="themeBtn" type="button" title="Switch light / dark" aria-label="Switch light or dark theme">
      <svg class="icoSun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="4.2"></circle><path d="M12 1.8v2.7M12 19.5v2.7M1.8 12h2.7M19.5 12h2.7M4.6 4.6l1.9 1.9M17.5 17.5l1.9 1.9M19.4 4.6l-1.9 1.9M6.5 17.5l-1.9 1.9"></path></svg>
      <svg class="icoMoon" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="display:none;"><path d="M20.4 13.2A8.4 8.4 0 1 1 10.8 3.6a6.6 6.6 0 0 0 9.6 9.6z"></path></svg>
    </button>

    <a class="navCta" href={contactHref}>{site.ctaLabel}</a>

    <button class="menuBtn" id="menuBtn" type="button" aria-expanded="false" aria-controls="menuOverlay" aria-label="Open menu">
      <span class="menuBtnBars" aria-hidden="true"><span></span><span></span></span>
      <span class="menuBtnLabel" id="menuBtnLabel">MENU</span>
    </button>
  </div>
</header>

<div class="menu" id="menuOverlay" tabindex="-1" aria-label="Site menu" hidden>
  <div class="menuInner">
    <nav class="menuPrimary" aria-label="Primary">
      <ul class="menuList">
        {
          menuItems.map((item, ni) =>
            item.children.length > 0 ? (
              /* A group: the heading opens its list instead of navigating, and
                 the parent page sits inside the list as "All …". */
              <li class="menuItem menuItemGroup" style={`--n:${ni}`}>
                <button
                  class="menuLink menuToggle"
                  type="button"
                  aria-label={item.label}
                  aria-expanded={isOpenGroup(item) ? 'true' : 'false'}
                  aria-controls={groupId(item.label)}
                >
                  <span class="menuDash" aria-hidden="true" />
                  <span class="menuWord" aria-hidden="true">
                    {chars(item.label).map((ch, ci) => (
                      <span class="menuCh" style={`--i:${ci}`}>{ch === ' ' ? ' ' : ch}</span>
                    ))}
                  </span>
                  {/* The same arrow the other menu items use, turned to point
                      down — these headings open a list rather than going
                      somewhere, so it must not read as "this navigates". It
                      turns through 180° to point up while the list is open.
                      Deliberately its own class rather than .menuArrow: that
                      one is revealed on hover, and a group's sign has to be
                      visible before you touch it. */}
                  <span class="menuGroupArrow" aria-hidden="true">↗</span>
                </button>
                <ul class="menuSubList" id={groupId(item.label)} hidden={!isOpenGroup(item)}>
                  {item.children.map((child) => (
                    <li>
                      <a class="menuSubLink" href={child.href} aria-current={isCurrent(child.href) ? 'page' : undefined}>
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li class="menuItem" style={`--n:${ni}`}>
                {exists(item.href) ? (
                  <a class="menuLink" href={item.href} aria-label={item.label} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                    <span class="menuDash" aria-hidden="true" />
                    <span class="menuWord" aria-hidden="true">
                      <span class="menuWipe" />
                      {chars(item.label).map((ch, ci) => (
                        <span class="menuCh" style={`--i:${ci}`}>{ch === ' ' ? ' ' : ch}</span>
                      ))}
                    </span>
                    <span class="menuArrow" aria-hidden="true">↗</span>
                  </a>
                ) : (
                  /* parent page not built yet — the label still groups its children */
                  <span class="menuLink menuLinkPlain">{item.label}</span>
                )}
              </li>
            )
          )
        }
      </ul>
    </nav>

    <div class="menuAside">
      {showPerformerLink && (
      <nav class="menuPerformers" aria-label="For performers">
        <p class="menuAsideLabel">FOR PERFORMERS</p>
        <a
          class="menuJoinLink"
          href={performerLink.href}
          aria-label={performerLink.label}
          aria-current={isCurrent(performerLink.href) ? 'page' : undefined}
        >
          <span class="menuJoinWord" aria-hidden="true">
            {chars(performerLink.label).map((ch, ci) => (
              <span class="menuCh" style={`--i:${ci}`}>{ch === ' ' ? ' ' : ch}</span>
            ))}
            <span class="menuJoinRule" />
            <span class="menuJoinRuleAccent" />
          </span>
          <span class="menuArrow menuJoinArrow" aria-hidden="true">↗</span>
        </a>
        <p class="menuJoinNote">{performerLink.note}</p>
      </nav>
      )}

      <div class="menuContact">
        <p class="menuAsideLabel">GET IN TOUCH</p>
        <p class="menuContactLine"><a href={contactHref}>{site.email}</a></p>
        <p class="menuContactLine"><a href={`tel:${site.phoneHref}`}>{site.phone}</a></p>
        <p class="menuContactLine">
          <a href={site.instagram} target="_blank" rel="noopener">Instagram</a>
        </p>
      </div>
    </div>
  </div>
</div>
